  {
   "id": "a0",
   "voice": "rush",
   "gap": 0.0,
   "say": "저기요, 바빠요!",
   "cap": [
    "\"저기요, 바빠요!\""
   ]
  },
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.08,
   "say": "출근 첫날, 에스컬레이터 왼쪽에 섰다가 들은 말.",
   "cap": [
    "출근 첫날 왼쪽에 / 섰다가 [들은 말]"
   ]
  },
  {
   "id": "b",
   "voice": "rush",
   "gap": 0.06,
   "say": "다들 왼쪽은 비워 주잖아요!",
   "cap": [
    "\"다들 왼쪽은 비워 주잖아요!\""
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.06,
   "say": "정부가 두 줄 서기 하라던데요?",
   "cap": [
    ""
   ]
  },
  {
   "id": "d",
   "voice": "rush",
   "gap": 0.06,
   "say": "그거 이천십오 년에 접었거든요?",
   "cap": [
    "\"그거 [2015년]에 / 접었거든요?\""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.08,
   "say": "실제로 이천칠 년에 시작해서 이천십오 년에 공식 중단.",
   "cap": [
    "2007년 시작 / 2015년 [공식 중단]"
   ]
  },
  {
   "id": "f",
   "voice": "me",
   "gap": 0.06,
   "say": "그래도 걷다가 사고 나요.",
   "cap": [
    "\"그래도 걷다가 사고 나요\""
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.08,
   "say": "십 년간 중대 사고 백삼십오 건, 그중 구십 건이 이용자 과실.",
   "cap": [
    "중대 사고 135건 / [90건] 이용자 과실"
   ]
  },
  {
   "id": "h",
   "voice": "rush",
   "gap": 0.06,
   "say": "아홉 시 회의라고요, 아홉 시!",
   "cap": [
    "\"[9시] 회의라고요 / [9시]!\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.08,
   "say": "올해 정부 설문도 사십구 점 구 대 오십 점 일, 딱 반반.",
   "cap": [
    "올해 설문도 / 49.9 대 50.1 [반반]"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.08,
   "say": "결국 아저씨는 계단으로 뛰어감.",
   "cap": [
    "결국 아저씨는 / [계단]으로 뛰어감"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.08,
   "say": "그리고 아홉 시, 첫 회의실.",
   "cap": [
    "그리고 [9시] 첫 회의실"
   ]
  },
  {
   "id": "l",
   "voice": "rush",
   "gap": 0.06,
   "say": "어, 아까 그…",
   "cap": [
    ""
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.08,
   "say": "그 아저씨가 우리 팀장님이었음.",
   "cap": [
    "그 아저씨가 우리 [팀장님]"
   ]
  },
  {
   "id": "n",
   "voice": "rush",
   "gap": 0.06,
   "say": "두 줄 서기, 좋은 문화죠.",
   "cap": [
    "\"두 줄 서기, 좋은 문화죠\""
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.08,
   "say": "님은 서는 편임, 걷는 편임?",
   "cap": [
    "님은 [서는] 편? [걷는] 편?"
   ]
  }
 ]
