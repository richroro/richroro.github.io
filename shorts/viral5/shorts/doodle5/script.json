  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "계란 껍데기에 찍힌 이 숫자, 뭔지 앎?",
   "cap": [
    "계란에 찍힌 숫자 / [뭔지] 앎?"
   ]
  },
  {
   "id": "b",
   "voice": "me",
   "gap": 0.08,
   "say": "그냥 공장 번호 아님?",
   "cap": [
    ""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "땡. 열 자리 전부 뜻이 있음.",
   "cap": [
    "땡! 열 자리 / [전부] 뜻이 있음"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "맨 앞 네 자리는 닭이 알을 낳은 날.",
   "cap": [
    "맨 앞 [4자리] / 닭이 알 낳은 날"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "영팔이삼이면 팔월 이십삼일에 낳은 거임.",
   "cap": [
    "[0823]이면 / 8월 23일에 낳음"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "가운데 다섯 자리는 농장 고유번호.",
   "cap": [
    "가운데 [5자리] / 농장 고유번호"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "이 번호로 어느 농장인지 조회도 됨.",
   "cap": [
    "이 번호로 / 농장 [조회] 가능"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 진짜 핵심은 마지막 한 자리.",
   "cap": [
    "진짜 핵심은 / [마지막 한 자리]"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "일 번은 풀밭을 뛰어다니는 방사.",
   "cap": [
    "[1번] 방사 / 풀밭을 뛰어다님"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "이 번은 닭장 없이 축사 안을 다니는 평사.",
   "cap": [
    "[2번] 평사 / 축사 안을 다님"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "삼 번, 사 번은 케이지.",
   "cap": [
    "[3번·4번]은 / 케이지"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "한 마리당 넓이는 사 번이 더 좁음.",
   "cap": [
    "한 마리당 넓이 / {4번}이 더 좁음"
   ]
  },
  {
   "id": "l2",
   "voice": "nar",
   "gap": 0.12,
   "say": "사 번은 에이포 용지 한 장보다도 좁음.",
   "cap": [
    "{4번}은 / A4 한 장보다 좁음"
   ]
  },
  {
   "id": "m",
   "voice": "me",
   "gap": 0.08,
   "say": "잠깐, 우리 집 계란 몇 번이지?",
