 },
 "tail": 0.4,
 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "앞이 텅 비었는데, 1차로를 막고 천천히 가는 차.", "cap": ["앞이 [텅] 비었는데 / 1차로를 막는 차"]},
  {"id": "b", "voice": "vil", "gap": 0.1, "say": "난 내 속도로 갈 거야~", "cap": [""]},
  {"id": "c", "voice": "nar", "gap": 0.12, "say": "뒤에는 차들이 줄줄이 밀려요.", "cap": ["뒤에는 차들이 / [줄줄이]"]},
  {"id": "d", "voice": "me", "gap": 0.1, "say": "아니, 왜 1차로에서 이렇게 느려?", "cap": [""]},
  {"id": "e", "voice": "nar", "gap": 0.12, "say": "그래도 바짝 붙어서 위협하면, 그건 보복운전이에요.", "cap": ["바짝 붙어 위협하면 / [보복운전]이에요"]},
  {"id": "f", "voice": "nar", "gap": 0.12, "say": "법은 이래요. 고속도로 1차로는 추월할 때 쓰는 차로.", "cap": ["고속도로 1차로는 / [추월할 때만]"]},
  {"id": "g", "voice": "nar", "gap": 0.1, "say": "추월이 끝나면 바로 오른쪽 차로로 돌아가요.", "cap": ["추월 끝나면 / [오른쪽 차로로]"]},
  {"id": "h", "voice": "nar", "gap": 0.12, "say": "길이 막혀 어쩔 수 없을 땐 예외지만, 뻥 뚫린 길에선 지정차로 위반.", "cap": ["막힐 땐 예외지만 / 뚫린 길에선 [위반]"]},
  {"id": "i", "voice": "nar", "gap": 0.12, "say": "그때, 뒤에서 들려온 소리.", "cap": ["그때 [뒤에서] 들려온 소리"]},
  {"id": "j", "voice": "cop", "gap": 0.1, "say": "1차로 앞차, 갓길에 세우세요.", "cap": [""]},
  {"id": "k", "voice": "nar", "gap": 0.12, "say": "고속도로 지정차로 위반, 승용차 범칙금 4만 원.", "cap": ["지정차로 위반 / 범칙금 [4만 원]"]},
  {"id": "l", "voice": "nar", "gap": 0.12, "say": "1차로는 머무는 곳이 아니라 지나가는 곳.| 여러분 앞에도 이런 차 있었죠?", "cap": ["1차로는 [지나가는 곳]", "여러분 앞에도 / 이런 차 [있었죠]?"]}
 ]
}
