  {
   "id": "a1b",
   "voice": "nar",
   "gap": 0.25,
   "say": "정신 차려 보면 볶음밥까지 먹고 있음.",
   "cap": [
    "정신 차려 보면 / 볶음밥까지 먹고 있음"
   ]
  },
  {
   "id": "a2",
   "voice": "nar",
   "gap": 0.25,
   "say": "맵다 맵다 하면서 젓가락은 절대 안 멈춤.",
   "cap": [
    "맵다 맵다 하면서 / 젓가락은 절대 안 멈춤"
   ]
  },
  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "스읍 하 근데 맛있어.",
   "cap": [
    "\"스읍… 하… 근데 맛있어\""
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "어묵은 국물에 푹 불려서 마지막에 먹어야 제맛.",
   "cap": [
    "어묵은 국물에 푹 불려서 / 마지막에 먹어야 제맛"
   ]
  },
  {
   "id": "a4",
   "voice": "nar",
   "gap": 0.25,
   "say": "떡파랑 어묵파는 서로를 절대 이해 못 함.",
   "cap": [
    "떡파랑 어묵파는 / 서로를 절대 이해 못 함"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "당연히 떡이지!",
   "cap": [
    "\"당연히 떡이지!\""
   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "밀떡이냐 쌀떡이냐로 친구랑 십 분 토론함.",
   "cap": [
    "밀떡이냐 쌀떡이냐로 / 친구랑 10분 토론함"
   ]
  },
  {
   "id": "a6",
   "voice": "nar",
   "gap": 0.25,
   "say": "치즈 추가할까 고민하는 척 이미 손은 누르고 있음.",
   "cap": [
    "치즈 추가할까 고민하는 척 / 이미 손은 누르고 있음"
   ]
  },
  {
   "id": "a7",
   "voice": "nar",
   "gap": 0.25,
   "say": "튀김 시키면 무조건 떡볶이 국물에 퐁당.",
   "cap": [
    "튀김 시키면 무조건 / 떡볶이 국물에 퐁당"
