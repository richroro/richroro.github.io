{
 "title": ["\\[괴담] 이해하면 소름 돋는", "지하주차장"],
 "voices": {"nar": {"edge": "ko-KR-InJoonNeural", "rate": "+5%", "pitch": "-10Hz"}},
 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "우리 아파트 지하 삼 층엔,| 몇 달째 안 움직인 차가 있다.", "cap": ["우리 아파트 / [지하 3층]", "몇 달째 / [안 움직인] 차"]},
  {"id": "b", "voice": "nar", "gap": 0.3, "say": "먼지가 뽀얗게 쌓였고,| 주인을 본 사람도 없다.", "cap": ["먼지가 / 뽀얗게 쌓였고", "[주인]을 본 사람도 / 없다"]},
  {"id": "c", "voice": "nar", "gap": 0.3, "say": "나는 지나갈 때마다| 괜히 창문 안을 들여다본다.", "cap": ["지나갈 때마다", "괜히 [창문 안]을 / 들여다본다"]},
  {"id": "d", "voice": "nar", "gap": 0.4, "say": "오늘은 운전석 유리에| 하얗게 김이 서려 있었다.", "cap": ["오늘은 / 운전석 유리에", "하얗게 / [김]이 서려 있었다"]},
  {"id": "e", "voice": "nar", "gap": 0.3, "say": "그 위에 손가락으로 쓴 글씨.| 또 봤네?", "cap": ["손가락으로 / 쓴 글씨", "[또 봤네?]"]},
  {"id": "f", "voice": "nar", "gap": 0.4, "say": "누가 장난쳤나 보다.| 그런데 글씨가,| 좌우로 뒤집혀 있었다.", "cap": ["누가 / [장난]쳤나 보다", "그런데 글씨가", "좌우로 / [뒤집혀] 있었다"]},
  {"id": "g", "voice": "nar", "gap": 0.5, "say": "그 차는 문이 전부 잠겨 있었다.", "cap": ["그 차는 / 문이 [전부 잠겨]", "있었다"]},
  {"id": "end", "voice": "nar", "gap": 0.6, "say": "이해하셨나요?| 정답은 댓글에.", "cap": ["[이해하셨나요?]", "정답은 [댓글]에"]}
 ],
 "tail": 0.6
}
