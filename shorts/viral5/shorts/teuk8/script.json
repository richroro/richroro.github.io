  },
  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "잠깐 내 월급.",
   "cap": [
    "\"잠깐, 내 월급…!\""
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "점심은 괜히 비싼 메뉴로.",
   "cap": [
