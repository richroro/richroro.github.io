   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "장바구니에 있던 거 전부 결제.",
   "cap": [
    "장바구니에 있던 거 / 전부 결제"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "이건 필요한 거야.",
   "cap": [
    "\"이건 필요한 거야\""
   ]
  },
  {
   "id": "a6",
   "voice": "nar",
   "gap": 0.25,
   "say": "이번 달은 진짜 아끼자고 다짐함.",
   "cap": [
    "이번 달은 진짜 / 아끼자고 다짐함"
   ]
  },
  {
   "id": "a8",
   "voice": "nar",
   "gap": 0.25,
   "say": "통장 잔고 확인을 하루에 열 번 함.",
   "cap": [
