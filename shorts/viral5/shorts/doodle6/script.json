  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "회사 단톡에서 넵에도 단계가 있음.",
   "cap": [
    "회사 단톡 / \"넵\"에도 [단계]가 있음"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "일 단계, 넵. 평범한 접수.",
   "cap": [
    "[1단계] 넵 / 평범한 접수"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "이 단계, 넵! 느낌표에 열정 한 스푼.",
   "cap": [
    "[2단계] 넵! / 열정 한 스푼"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "삼 단계, 넵넵. 빨리 대화 끝내고 싶음.",
   "cap": [
    "[3단계] 넵넵 / 빨리 끝내고 싶음"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "사 단계, 넵 알겠습니다. 긴장한 상태.",
   "cap": [
    "[4단계] 넵 알겠습니다 / 긴장 중"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "오 단계, 넹. 팀장님이 편해진 사람.",
   "cap": [
    "[5단계] 넹 / 팀장님이 편해짐"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "육 단계, 넵 점 점 점 점. 속으로 울고 있음.",
   "cap": [
    "[6단계] 넵.... / 속으로 {우는 중}"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 마지막 칠 단계.",
   "cap": [
    "그리고 마지막 / [7단계]"
   ]
  },
  {
   "id": "i",
   "voice": "me",
   "gap": 0.08,
   "say": "팀장님, 그 보고서 오늘은 좀 어려울 것 같습니다.",
   "cap": [
    ""
   ]
  },
