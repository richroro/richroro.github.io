  {
   "id": "a0",
   "voice": "nb",
   "gap": 0.0,
   "say": "사진은 왜 찍어요?",
   "cap": [
    "\"사진은 왜 찍어요?\""
   ]
  },
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.08,
   "say": "소화전 앞 불법주차 신고하다 들은 말.",
   "cap": [
    "소화전 앞 불법주차 / 신고하다 [들은 말]"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.08,
   "say": "빨간 차, 근데 어디서 많이 본 차.",
   "cap": [
    "빨간 차 어디서 [많이 본] 차"
   ]
  },
  {
   "id": "c",
   "voice": "nb",
   "gap": 0.06,
   "say": "잠깐 세운 건데 너무하네.",
   "cap": [
    ""
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.06,
   "say": "소화전 앞은 일 분만 서도 신고돼요.",
   "cap": [
    "\"소화전 앞은 / [1분]만 서도 신고돼요\""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.08,
   "say": "소화전, 횡단보도, 인도 같은 여섯 곳은 일 분이면 주민 신고 대상.",
   "cap": [
    "소화전·횡단보도·인도 / [6곳]은 1분"
   ]
  },
  {
   "id": "f",
   "voice": "nb",
   "gap": 0.06,
   "say": "사진 한 장 찍으면 끝이에요?",
   "cap": [
    "\"사진 한 장 찍으면 끝이에요?\""
   ]
  },
  {
   "id": "g",
   "voice": "me",
   "gap": 0.06,
   "say": "같은 자리, 같은 각도로 일 분 간격 두 장이요.",
   "cap": [
    "\"같은 자리·각도로 / [1분] 간격 두 장이요\""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.08,
   "say": "앱으로 보내면 단속 공무원 없이 과태료.",
   "cap": [
    "앱으로 보내면 / 현장 단속 [없이] 과태료"
   ]
  },
  {
   "id": "i",
   "voice": "nb",
   "gap": 0.06,
   "say": "과태료는 얼마 안 하죠?",
   "cap": [
    "\"과태료는 얼마 안 하죠?\""
   ]
  },
  {
   "id": "j",
   "voice": "me",
   "gap": 0.06,
   "say": "소화전 앞은 과태료가 더 세요.",
   "cap": [
    "\"소화전 앞은 / 과태료가 [더 세요]\""
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.08,
   "say": "도치, 뿌듯하게 신고 완료.",
   "cap": [
    "도치, 뿌듯하게 신고 [완료]"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.08,
   "say": "그리고 며칠 뒤 저녁.",
   "cap": [
    "그리고 [며칠 뒤] 저녁"
   ]
  },
  {
   "id": "m",
   "voice": "dad",
   "gap": 0.06,
   "say": "아들, 아빠 차에 과태료가 나왔다?",
   "cap": [
    ""
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.08,
   "say": "그 빨간 차, 아빠 차였음.",
   "cap": [
    "그 빨간 차 [아빠 차]였음"
   ]
  },
  {
   "id": "o",
   "voice": "me",
   "gap": 0.06,
   "say": "아빠, 그거 사실 내가…",
   "cap": [
