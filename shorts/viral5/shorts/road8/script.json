  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "꽉 막힌 고속도로, 갓길로 혼자 쌩 달리는 차.",
   "cap": [
    "꽉 막힌 고속도로 / [갓길]로 쌩"
   ]
  },
  {
   "id": "b",
   "voice": "vil",
   "gap": 0.1,
   "say": "막히면 갓길이 답이지~",
   "cap": [
    ""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "다들 줄 서서 기다리는데, 혼자서만.",
   "cap": [
    "다들 기다리는데 / [혼자서만]"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.1,
   "say": "갓길은 차 고장 났을 때 쓰는 곳인데!",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "화난다고 갓길을 막아서면, 그건 더 위험해요.",
   "cap": [
    "막아서면 / [더 위험]해요"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "법은 이래요.| 고속도로 갓길은 고장 같은 부득이한 경우 말고는 달리면 안 돼요.",
   "cap": [
    "법은 이래요",
    "고장 같은 [부득이한 경우] / 말고는 갓길 금지"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "긴급차, 그리고 정체 때 신호나 경찰이 허락하면 예외예요.",
   "cap": [
    "긴급차, 신호·경찰이 / [허락]하면 예외"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 빌런, 갓길 끝까지 달려갔더니.",
   "cap": [
    "그 빌런, / 갓길 [끝까지] 갔더니"
   ]
  },
  {
   "id": "i",
   "voice": "cop",
   "gap": 0.1,
   "say": "갓길로 오셨죠? 여기 세우세요.",
   "cap": [
    ""
   ]
  },
  {
   "id": "j",
   "voice": "vil",
   "gap": 0.1,
   "say": "왜 하필 여기 서 있는 건데…",
   "cap": [
    ""
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "고속도로 갓길 통행, 승용차 범칙금 6만 원.",
   "cap": [
    "고속도로 갓길 통행 / 범칙금 [6만 원]"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "줄 서서 간 내가 결국 더 빨랐어요.| 여러분도 갓길 빌런 본 적 있죠?",
   "cap": [
    "줄 선 내가 / 결국 [더 빨랐다]",
    "여러분도 / [갓길 빌런] 본 적 있죠?"
   ]
