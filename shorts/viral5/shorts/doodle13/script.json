 "lines": [
  {
   "id": "a0",
   "voice": "chief",
   "gap": 0.0,
   "say": "답 없는 사람, 이름 부릅니다.",
   "cap": [
    "\"답 없는 사람, 이름 부릅니다\""
   ]
  },
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.08,
   "say": "동창회 단톡에 올라온 공지 마지막 줄.",
   "cap": [
    "동창회 단톡 공지 [마지막 줄]"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.08,
   "say": "알림 서른두 개, 숨 쉴 틈이 없음.",
   "cap": [
    "알림 [32개] 숨 쉴 틈 없음"
   ]
  },
  {
   "id": "b2",
   "voice": "nar",
   "gap": 0.08,
   "say": "참고로 이 방엔 반장 어머님도 계심.",
   "cap": [
    "참고로 이 방엔 / [반장 어머님]도 계심"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.08,
   "say": "날짜 투표는 오늘 밤 열두 시까지.",
   "cap": [
    "날짜 투표 오늘 밤 [12시]까지"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.08,
   "say": "회비 오만 원, 입금하면 체크 누르기.",
   "cap": [
    "회비 [5만 원] 입금하면 체크"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.08,
   "say": "불참자는 사유 한 줄씩.",
   "cap": [
    "불참자는 [사유] 한 줄씩"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.08,
   "say": "일 차 고기, 이 차 노래방, 삼 차 해장국.",
   "cap": [
    "고기·노래방 [해장국]까지"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.08,
   "say": "드레스 코드는 초록색.",
   "cap": [
    "드레스 코드 [초록색]"
   ]
  },
  {
   "id": "h",
   "voice": "me",
   "gap": 0.06,
   "say": "초록색 옷 없는데?",
   "cap": [
    "\"초록색 옷 없는데?\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.08,
   "say": "근데 반장 입장도 있음.",
   "cap": [
    "근데 [반장] 입장도 있음"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.08,
   "say": "지난번엔 다 읽고 아무도 답을 안 했음.",
   "cap": [
    "지난번엔 다 읽고 / [아무도] 답 안 함"
   ]
  },
  {
   "id": "k",
   "voice": "chief",
   "gap": 0.06,
   "say": "읽씹하면 나만 바보 되잖아.",
   "cap": [
    "\"읽씹하면 나만 바보 되잖아\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.08,
   "say": "그래서 공지가 점점 길어지는 중.",
   "cap": [
    "그래서 공지가 / 점점 [길어지는] 중"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.08,
   "say": "결국 참석 체크한 사람, 세 명.",
   "cap": [
    "참석 체크 딱 [3명]"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.08,
   "say": "반장, 나, 그리고 반장 어머님.",
   "cap": [
    "반장, 나, 그리고 [반장 어머님]"
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.08,
   "say": "님 단톡에도 이런 반장 있음?",
   "cap": [
    "님 단톡에도 이런 [반장] 있음?"
   ]
  }
 ]
}