 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "세 시 손님한텐 돈 받지 말래.",
   "cap": [
    "3시 손님한텐 / [돈 받지 말래]"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "편의점 야간 알바 첫날, 사장님이 이상한 규칙을 줬어.",
   "cap": [
    "야간 알바 첫날 / 사장님의 [이상한 규칙]"
   ]
  },
  {
   "id": "c",
   "voice": "boss",
   "gap": 0.1,
   "say": "세 시 할아버지는 그냥 보내. 나 찾으면 방금 나갔다고 해.",
   "cap": [
    "\"할아버지 오시면 그냥 보내 / 나 찾으면 [방금 나갔다]고 해\""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "진짜 세 시 딱 되니까 할아버지가 오셨어.",
   "cap": [
    "진짜 [3시] 되니까 / 할아버지가 오셨어"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "우유랑 빵 올려놓고, 가게를 한 바퀴 둘러보시더라.",
   "cap": [
    "우유 하나, 빵 하나 / 가게를 [한 바퀴] 둘러봐"
   ]
  },
  {
   "id": "f",
   "voice": "gpa",
   "gap": 0.1,
   "say": "학생, 사장은 오늘도 야간 하지?",
   "cap": [
    "\"학생, 사장은 / 오늘도 [야간] 하지?\""
   ]
  },
  {
   "id": "g",
   "voice": "me",
   "gap": 0.1,
   "say": "네, 방금 잠깐 나가셨어요.",
   "cap": [
    "\"네, 방금 / [잠깐] 나가셨어요\""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "한 달 내내 사장님은 매일 방금 나간 사람이 됐어.",
   "cap": [
    "한 달 내내 사장님은 / 매일 [방금 나간] 사람"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 하루는 할아버지가 근무표를 넘겨 보시더니,",
   "cap": [
    "하루는 할아버지가 / [근무표]를 넘겨 보더니"
   ]
  },
  {
   "id": "j",
   "voice": "gpa",
   "gap": 0.1,
   "say": "야간에 사장 이름이 한 번도 없네?",
   "cap": [
    "\"야간에 [사장 이름]이 / 한 번도 없네?\""
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "알고 보니 할아버지가 이 가게 진짜 주인이었어.",
   "cap": [
    "알고 보니 할아버지가 / 가게 [진짜 주인]"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "아들한테 가게 맡기면서, 야간은 꼭 직접 하라고 했는데,",
   "cap": [
    "아들한테 맡기면서 / [야간은 직접] 하랬대"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "사장님은 몰래 나를 쓰고 집에서 자고 있었던 거지.",
   "cap": [
    "사장님은 몰래 / 집에서 [자고] 있었던 거야"
   ]
  },
  {
   "id": "n",
   "voice": "gpa",
   "gap": 0.1,
   "say": "학생은 잘못 없어. 내일도 나와.",
   "cap": [
    "\"학생은 잘못 없어 / 내일도 [나와]\""
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 다음 날부터 야간 알바가 한 명 늘었어.",
   "cap": [
    "다음 날부터 / 야간 알바가 [한 명] 늘었어"
   ]
  },
  {
   "id": "p",
   "voice": "boss",
   "gap": 0.1,
   "say": "아버지, 저 원래 아침형 인간인데요.",
   "cap": [
    "\"아버지, 저 원래 / [아침형 인간]인데요\""
   ]
  }
 ]
}