  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "편의점 야간 알바 첫날, 사장님이 말했다.",
   "cap": [
    "편의점 야간 알바 첫날 / 사장님이 말했다"
   ]
  },
  {
   "id": "b",
   "voice": "boss",
   "gap": 0.15,
   "say": "새벽 세 시에 오는 할아버지한테는, 돈 받지 마.",
   "cap": [
    ""
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.1,
   "say": "네? 왜요?",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "정확히 새벽 세 시. 할아버지 한 분이 우유랑 빵을 올려놓더니,",
   "cap": [
    "정확히 [새벽 3시] / 할아버지 한 분이 / [우유랑 빵]을 올려놓더니"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.1,
   "say": "아무 말 없이 그냥 나가 버렸다.",
   "cap": [
    "아무 말 없이 / 그냥 [나가 버렸다]"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "다음 날도, 그다음 날도. 똑같이.",
   "cap": [
    "다음 날도 / 그다음 날도 / [똑같이]"
   ]
  },
  {
   "id": "i",
   "voice": "me",
   "gap": 0.15,
   "say": "혹시... 사람 아닌 거 아니야?",
   "cap": [
    ""
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "그렇게 한 달, 알바 마지막 날.",
   "cap": [
    "그렇게 한 달 / 알바 [마지막 날]"
   ]
  },
  {
   "id": "k",
   "voice": "gp",
   "gap": 0.15,
   "say": "그동안 고마웠네.",
   "cap": [
    ""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.15,
   "say": "봉투엔 한 달 치 우유 값, 그리고 쪽지 한 장.",
   "cap": [
    "봉투엔 한 달 치 / [우유 값] / 그리고 쪽지 한 장"
   ]
  },
  {
   "id": "m",
   "voice": "gp",
   "gap": 0.15,
   "say": "우리 아들 가게, 잘 지켜 줘서 고맙네.",
   "cap": [
    ""
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.15,
   "say": "알고 보니 사장님 아버지. 알바생이 착한지 몰래 보러 오신 거였다.",
   "cap": [
    "알고 보니 / [사장님 아버지] / 알바생이 착한지 / [몰래] 보러 오신 거였다"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 다음 달, 내 시급이 올랐다.",
   "cap": [
