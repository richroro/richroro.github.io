 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "할아버지한텐 돈 받지 말래.",
   "cap": [
    "할아버지한텐 / [돈 받지 말래]"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "편의점 야간 알바 첫날, 사장님이 그러더라.",
   "cap": [
    "야간 알바 첫날 / [사장님]이 그러더라"
   ]
  },
  {
   "id": "c",
   "voice": "boss",
   "gap": 0.1,
   "say": "새벽 세 시 할아버지는, 그냥 보내.",
   "cap": [
    "\"새벽 3시 할아버지는 / [그냥] 보내\""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "진짜 세 시 딱 되니까 할아버지가 오셨어.",
   "cap": [
    "진짜 [3시] 되니까 / 할아버지가 오셨어"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "우유 하나랑 빵 하나만 딱 올려놓으시고.",
   "cap": [
    "[우유] 하나 / [빵] 하나"
   ]
  },
  {
   "id": "f",
   "voice": "gpa",
   "gap": 0.1,
   "say": "학생, 얼마야?",
   "cap": [
    "\"학생, / [얼마]야?\""
   ]
  },
  {
   "id": "g",
   "voice": "me",
   "gap": 0.1,
   "say": "그냥 가셔도 돼요.",
   "cap": [
    "\"그냥 / [가셔도] 돼요\""
   ]
  },
  {
   "id": "h",
   "voice": "gpa",
   "gap": 0.1,
   "say": "허허, 그래? 고마워.",
   "cap": [
    "\"허허, 그래? / [고마워]\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "그렇게 한 달 내내 할아버지는 매일 오셨어.",
   "cap": [
    "한 달 내내 / [매일] 오셨어"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 하루는 내 이름표를 빤히 보시더니,",
   "cap": [
    "하루는 내 이름표를 / [빤히] 보시더니"
   ]
  },
  {
   "id": "k",
   "voice": "gpa",
   "gap": 0.1,
   "say": "자네, 우리 아들 가게에서 일 잘하네.",
   "cap": [
    "\"자네, [우리 아들 가게] / 일 잘하네\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "할아버지는 사장님 아버지였던 거야.",
   "cap": [
    "할아버지는 / [사장님 아버지]"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "새로 온 알바가 착한지 보러 오신 거였고.",
   "cap": [
    "새 알바가 [착한지] / 보러 오신 거야"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "다음 달 월급날, 통장을 보는데,",
   "cap": [
    "다음 달 월급날 / 통장을 봤는데"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "시급이 올라 있었어.",
   "cap": [
    "[시급]이 올랐어"
   ]
  },
  {
   "id": "p",
   "voice": "boss",
   "gap": 0.1,
   "say": "우리 아버지가 너 칭찬 엄청 하시더라.",
   "cap": [
    "\"아버지가 너 / [칭찬] 엄청 하시더라\""
   ]
  }
 ]
