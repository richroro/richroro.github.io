 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "옆집에서 삼 년째 반찬이 와.",
   "cap": [
    "옆집에서 [3년째] / 반찬이 와"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "매일 저녁, 우리 집 문고리에 반찬 봉지가 걸려 있어.",
   "cap": [
    "매일 저녁 문고리에 / [반찬 봉지]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "멸치볶음, 김치, 그리고 꼭 도라지 배즙이 하나씩 들어 있어.",
   "cap": [
    "반찬이랑 꼭 / [도라지 배즙] 하나"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.1,
   "say": "배즙은 왜 주시는 거지?",
   "cap": [
    "\"[배즙]은 / 왜 주시는 거지?\""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "범인은 옆집 할머니였어.",
   "cap": [
    "범인은 / [옆집 할머니]"
   ]
  },
  {
   "id": "f",
   "voice": "me",
   "gap": 0.1,
   "say": "할머니, 왜 자꾸 반찬 주세요?",
   "cap": [
    "\"할머니, 왜 자꾸 / [반찬] 주세요?\""
   ]
  },
  {
   "id": "g",
   "voice": "gma",
   "gap": 0.1,
   "say": "목 아플까 봐. 매일 밤에 노래하잖아.",
   "cap": [
    "\"목 아플까 봐 / 매일 밤 [노래]하잖아\""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "삼 년 전 그 주에, 나는 밤마다 오디션 노래 연습을 시작했거든.",
   "cap": [
    "3년 전 그 주에 / 밤마다 [노래 연습] 시작"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "벽이 얇아서 옆집에 다 들렸던 거야.",
   "cap": [
    "벽이 얇아서 / 옆집에 [다 들렸어]"
   ]
  },
  {
   "id": "j",
   "voice": "me",
   "gap": 0.1,
   "say": "죄송해요, 시끄러우셨죠?",
   "cap": [
    "\"죄송해요 / [시끄러우셨죠?]\""
   ]
  },
  {
   "id": "k",
   "voice": "gma",
   "gap": 0.1,
   "say": "아니. 그거 들어야 잠이 와.",
   "cap": [
    "\"아니. 그거 들어야 / [잠이 와]\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "할머니한텐 내 노래가 자장가였던 거야.",
   "cap": [
    "내 노래가 / 할머니 [자장가]"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 요즘 오디션 떨어지고 연습을 쉬었거든.",
   "cap": [
    "근데 요즘 / 연습을 [쉬었거든]"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "그랬더니 문고리에 반찬 대신 쪽지가 걸려 있었어.",
   "cap": [
    "그랬더니 문고리에 / 반찬 대신 [쪽지]"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "요즘 왜 안 불러. 잠이 안 와.",
   "cap": [
    "'요즘 왜 안 불러 / [잠이 안 와]'"
   ]
  },
  {
   "id": "p",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 오늘 밤도 노래해. 관객은 딱 한 명.",
   "cap": [
    "그래서 오늘도 노래해 / 관객은 [딱 한 명]"
   ]
  }
 ]
}