 "card": {
  "items": [
   {
    "at": 0.0,
    "ko": "배우 짐 캐리의 아버지는",
    "en": "훌륭한 코미디언이 될 수 있었다",
    "panel": {
     "big": "짐 캐리의\n아버지",
     "small": "누구보다 웃긴 사람",
     "bg": "#FFE8A3"
    }
   },
   {
    "at": 3.2,
    "ko": "하지만 그 꿈을 믿지 않았다",
    "panel": {
     "big": "꿈 대신",
     "small": "\"그게 가능하다고 믿지 않았다\"",
     "bg": "#E8DDFF"
    }
   },
   {
    "at": 6.2,
    "ko": "그래서 안정된 직장을 택했다",
    "panel": {
     "big": "회계사",
     "small": "안전한 길을 골랐다",
     "bg": "#CFE8FF"
    }
   },
   {
    "at": 9.2,
    "ko": "그런데 짐이 12살 때",
    "panel": {
     "big": "12살",
     "bg": "#2b2d42",
     "fg": "#ffffff",
     "small": "그 안전한 직장에서 해고"
    }
   },
   {
    "at": 12.2,
    "ko": "가족은 하루하루 버텨야 했다",
    "panel": {
     "big": "살아남기",
     "small": "가족 모두가 뭐든 해야 했다",
     "bg": "#FFD6C9"
    }
   },
   {
    "at": 15.2,
    "ko": "아들은 웃기는 일에 인생을 걸었고",
    "en": "한 해에 주연작 세 편",
    "panel": {
     "big": "1994",
     "small": "'에이스 벤추라' '마스크'\n'덤 앤 더머'",
     "bg": "#D9F2D0"
    }
   },
   {
    "at": 18.2,
    "ko": "세계적인 배우가 된 뒤",
    "panel": {
     "big": "졸업식 연설",
     "small": "한 대학의 졸업생들에게",
     "bg": "#FFE8A3"
    }
   },
   {
    "at": 21.2,
    "ko": "그는 졸업생들에게 먼저 이렇게 말했다",
    "panel": {
     "big": "두려움",
     "small": "\"많은 사람이 '현실적'이라는\n탈을 쓴 두려움으로 길을 고른다\"",
     "bg": "#2b2d42",
     "fg": "#ffffff"
    }
   },
   {
    "at": 24.2,
    "ko": "아버지에게 배운 걸 이렇게 말했다",
    "panel": {
     "big": "아버지에게\n배운 것",
     "bg": "#E8DDFF"
    }
   },
   {
    "at": 27.2,
    "ko": "아버지에게서 배운 가장 큰 교훈",
    "quote": {
     "ko": "원하지 않는 일을 해도/실패할 수 있다./그러니 사랑하는 일에 걸어 봐라.",
