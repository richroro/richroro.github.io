{
 "credit": "",
 "layout": "card",
 "card": {
  "items": [
   {
    "at": 0.0,
    "ko": "스무 살 때 차고에서 시작한 회사",
    "en": "스티브 잡스"
   },
   {
    "at": 3.2,
    "ko": "10년 만에 큰 회사가 됐다",
    "panel": {
     "big": "10년",
     "small": "직원 4,000명\n20억 달러짜리 회사",
     "bg": "#CFE8FF"
    }
   },
   {
    "at": 6.2,
    "ko": "그런데 서른 살에 쫓겨났다",
    "panel": {
     "big": "30살",
     "small": "그리고 해고",
     "bg": "#2b2d42",
     "fg": "#ffffff"
    }
   },
   {
    "at": 9.2,
    "ko": "그것도 모두가 보는 앞에서",
    "panel": {
     "big": "\"내가 만든\n회사에서?\"",
     "bg": "#FFD6C9"
    }
   },
   {
    "at": 12.2,
    "ko": "공개적으로 실패한 사람이 됐다",
    "panel": {
     "big": "도망칠까",
     "small": "실리콘밸리를 떠날 생각까지",
     "bg": "#E8DDFF"
    }
   },
   {
    "at": 15.2,
    "ko": "그래도 다시 회사를 차렸다",
    "panel": {
     "big": "다시 시작",
     "small": "넥스트(NeXT), 그리고 픽사",
     "bg": "#D9F2D0"
    }
   },
   {
    "at": 18.2,
    "ko": "픽사는 역사를 새로 썼고",
    "panel": {
     "big": "토이 스토리",
     "small": "세계 첫 컴퓨터 애니메이션 장편",
     "bg": "#FFE8A3"
    }
   },
   {
    "at": 21.2,
    "ko": "자신을 쫓아낸 회사로 다시",
    "panel": {
     "big": "돌아온\n창업자",
     "small": "애플이 넥스트를 사들였고\n그는 애플로 돌아왔다",
     "bg": "#CFE8FF"
    }
   },
   {
    "at": 24.2,
    "ko": "훗날 그는 해고를 이렇게 불렀다",
    "panel": {
     "big": "최고의 일",
     "small": "\"애플에서 해고된 건 내게 일어난\n최고의 일이었다\"",
     "bg": "#FFE8A3"
    }
   },
   {
    "at": 27.2,
    "ko": "훗날 졸업생들에게 남긴 말",
    "quote": {
     "ko": "가끔 인생이 벽돌로/머리를 내리칠 때가 있습니다./믿음을 잃지 마세요.",
     "orig": "Sometimes life hits you in the head with a brick. Don't lose faith.",
     "who": "스티브 잡스, 스탠퍼드대 졸업식 연설"
    }
   }
  ],
  "badge": {
   "name": "오늘의 한마디",
   "icon": "말",
   "color": "#c2410c"
  },
