  {"id": "e", "voice": "nar", "gap": 0.5, "say": "나는 지금 회사에 있다.| 그리고 나는,| 혼자 산다.", "cap": ["나는 지금 / [회사]에 있다", "그리고 나는", "[혼자] 산다"]},
  {"id": "f", "voice": "nar", "gap": 0.4, "say": "아침에 문은 분명히 잠그고 나왔다.", "cap": ["문은 분명히 / [잠그고] 나왔다"]},
  {"id": "g", "voice": "nar", "gap": 0.4, "say": "퇴근하고 집에 와 보니,| 문 앞엔 아무것도 없었다.", "cap": ["퇴근하고 / 집에 와 보니", "문 앞엔 / [아무것도] 없었다"]},
  {"id": "end", "voice": "nar", "gap": 0.6, "say": "이해하셨나요?| 정답은 댓글에.", "cap": ["[이해하셨나요?]", "정답은 [댓글]에"]}
