{
 "title": ["택배 기사님이 우리 집만", "오면 웃는 이유"],
 "voices": {
  "nar": {"edge": "ko-KR-SunHiNeural", "rate": "+12%"},
  "me": {"edge": "ko-KR-SunHiNeural", "rate": "+14%", "pitch": "+8Hz"},
