 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "요즘 택배 기사님들이 우리 집 앞에서 자꾸 웃는다.", "cap": ["요즘 택배 기사님들이 / 우리 집 앞에서 / [자꾸 웃는다]"]},
  {"id": "b", "voice": "nar", "gap": 0.15, "say": "현관 카메라를 보면, 다들 한참 웃다가 가더라.", "cap": ["현관 카메라를 보면 / 다들 [한참 웃다가] / 가더라"]},
  {"id": "c", "voice": "me", "gap": 0.15, "say": "우리 집 문에 뭐 묻었나?", "cap": [""]},
  {"id": "d", "voice": "nar", "gap": 0.2, "say": "영상을 전부 돌려 보니까, 공통점이 하나 있었다.", "cap": ["영상을 전부 돌려 보니까 / [공통점]이 하나 있었다"]},
  {"id": "e", "voice": "nar", "gap": 0.1, "say": "초인종을 누르자마자 빵 터진다는 거.", "cap": ["[초인종]을 누르자마자 / [빵 터진다]는 거"]},
  {"id": "f", "voice": "nar", "gap": 0.2, "say": "그래서 직접 눌러 봤다.", "cap": ["그래서 / [직접] 눌러 봤다"]},
  {"id": "g", "voice": "kid", "gap": 0.35, "say": "기사님 오늘도 고맙습니다! 사랑해요!", "cap": ["🔔 기사님 오늘도 / [고맙습니다! 사랑해요!]"]},
  {"id": "h", "voice": "nar", "gap": 0.2, "say": "범인은 다섯 살 조카. 놀러 왔을 때 몰래 녹음해 놨더라.", "cap": ["범인은 / [다섯 살 조카] / 놀러 왔을 때 / 몰래 [녹음]해 놨더라"]},
  {"id": "i", "voice": "kid", "gap": 0.15, "say": "기사님들 힘드니까!", "cap": [""]},
  {"id": "j", "voice": "nar", "gap": 0.2, "say": "다음 날, 문 앞에 사탕 하나랑 쪽지가 있었다.", "cap": ["다음 날 문 앞에 / [사탕 하나]랑 / 쪽지가 있었다"]},
  {"id": "k", "voice": "dr", "gap": 0.2, "say": "나도 사랑해. 택배 아저씨가.", "cap": [""]}
 ]
