  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "여기 어디야?",
   "cap": [
    "\"여기 어디야…?\""
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "출구 번호 헷갈려서 역에서만 십 분 헤맴.",
