   ]
  },
  {
   "id": "a8",
   "voice": "nar",
   "gap": 0.25,
   "say": "최소 주문 금액 맞추다 보면 두 끼 분량.",
   "cap": [
    "최소 주문 금액 맞추다 / 두 끼 분량 됨"
   ]
  },
  {
   "id": "a9",
   "voice": "nar",
   "gap": 0.25,
   "say": "택배 오면 괜히 신나서 문 앞으로 달려감.",
   "cap": [
    "택배 오면 괜히 신나서 / 문 앞으로 달려감"
   ]
  },
  {
   "id": "a7",
   "voice": "nar",
   "gap": 0.25,
   "say": "관리비 고지서 처음 보고 깜짝 놀람.",
