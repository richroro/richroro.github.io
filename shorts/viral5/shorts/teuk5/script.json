   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "빨래 돌려 놓고 까맣게 잊어버림.",
   "cap": [
    "빨래 돌려 놓고 / 까맣게 잊어버림"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "아 빨래!",
   "cap": [
    "\"아, 빨래!\""
   ]
  },
  {
   "id": "a6",
   "voice": "nar",
   "gap": 0.25,
   "say": "엄마 반찬이 세상에서 제일 맛있음.",
   "cap": [
