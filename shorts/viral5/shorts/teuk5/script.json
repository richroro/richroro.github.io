   ]
  },
  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "설거지 줄이는 거야.",
   "cap": [
    "\"설거지 줄이는 거야\""
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "대파 한 단은 끝까지 먹은 적이 없음.",
   "cap": [
    "대파 한 단은 / 끝까지 먹은 적 없음"
   ]
  },
  {
   "id": "a4",
   "voice": "nar",
   "gap": 0.25,
   "say": "휴지 없는 걸 마지막 한 칸에서 알게 됨.",
   "cap": [
