  {
   "id": "b",
   "voice": "buyer",
   "gap": 0.1,
   "say": "네고 되나요?",
   "cap": [
    "\"네고 되나요?\""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "네고 일 단계. 여기까진 국룰.",
   "cap": [
    "네고 [1단계] / 여기까진 국룰"
   ]
  },
  {
   "id": "d",
   "voice": "buyer",
   "gap": 0.1,
   "say": "팔천 원 되나요?",
   "cap": [
