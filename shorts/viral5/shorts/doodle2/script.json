   ]
  },
  {
   "id": "h",
   "voice": "buyer",
   "gap": 0.1,
   "say": "혹시 무료 나눔은 안 되나요?",
   "cap": [
    "\"무료 나눔은 / 안 되나요?\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "사 단계. 의자가 공짜가 되는 중.",
   "cap": [
    "[4단계] / 의자가 {0원}"
   ]
  },
  {
   "id": "j",
   "voice": "me",
   "gap": 0.1,
   "say": "아, 그냥 안 팔래요.",
   "cap": [
