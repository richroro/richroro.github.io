  {
   "id": "b",
   "voice": "me",
   "gap": 0.15,
   "say": "아으... 발 아파 죽겠다...",
   "cap": [
    ""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.2,
   "say": "그런데 그날부터, 밤마다 내 전투화가 사라졌다.",
   "cap": [
    "그런데 그날부터 / 밤마다 내 전투화가 / [사라졌다]"
