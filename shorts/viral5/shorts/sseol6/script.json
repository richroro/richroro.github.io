 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "신입이 매일 팀장님 책상에 사탕을 둬.",
   "cap": [
    "신입이 매일 / 팀장님 책상에 [사탕]"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 회의 있는 날엔 꼭 제일 큰 사탕이야.",
   "cap": [
    "근데 회의 있는 날엔 / 꼭 [제일 큰 사탕]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "그러니까 사무실에 소문이 돌았지.",
   "cap": [
    "사무실에 / [소문]이 돌았지"
   ]
  },
  {
   "id": "d",
   "voice": "c1",
   "gap": 0.1,
   "say": "저거 완전 아부 아니야?",
   "cap": [
    "\"저거 완전 / [아부] 아니야?\""
   ]
  },
  {
   "id": "e",
   "voice": "c2",
   "gap": 0.1,
   "say": "아니야, 짝사랑이래.",
   "cap": [
    "\"아니야, / [짝사랑]이래\""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "궁금해서 내가 직접 물어봤어.",
   "cap": [
    "궁금해서 / [직접] 물어봤어"
   ]
  },
  {
   "id": "g",
   "voice": "me",
   "gap": 0.1,
   "say": "너 팀장님 좋아해?",
   "cap": [
    "\"너 [팀장님] / 좋아해?\""
   ]
  },
  {
   "id": "h",
   "voice": "new",
   "gap": 0.1,
   "say": "아뇨. 회의 때문에요.",
   "cap": [
    "\"아뇨. / [회의] 때문에요\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "팀장님이 아침 굶은 날은, 회의가 두 시간을 넘는대.",
   "cap": [
    "팀장님이 굶은 날 / 회의가 [2시간]"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "신입이 석 달 동안 기록해서 알아낸 거래.",
   "cap": [
    "석 달 동안 / [기록]해서 알아냈대"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 사탕 하나로 당 충전을 시킨 거지.",
   "cap": [
    "사탕 하나로 / [당 충전]"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "효과는 진짜였어. 회의가 십 분 만에 끝나.",
   "cap": [
    "효과는 진짜 / 회의가 [10분] 컷"
   ]
  },
  {
   "id": "m",
   "voice": "boss",
   "gap": 0.1,
   "say": "자, 오늘은 여기까지.",
   "cap": [
    "\"자, 오늘은 / [여기까지]\""
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "지금은 사탕값을 팀원들이 나눠서 내.",
   "cap": [
    "지금은 사탕값을 / 팀원들이 [나눠서] 내"
   ]
  },
  {
   "id": "o",
   "voice": "new",
   "gap": 0.1,
   "say": "팀장님, 오늘은 두 개 드세요. 회의 많아요.",
   "cap": [
    "\"오늘은 [두 개] 드세요 / 회의 많아요\""
   ]
  }
 ]
