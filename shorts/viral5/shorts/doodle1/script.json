 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "님 방 멀티탭, 몇 년 됐음?",
   "cap": [
    "님 방 멀티탭 / [몇 년] 됐음?"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "기억 안 나면, 이미 꽤 된 거임.",
   "cap": [
    "기억 안 나면 / 이미 [꽤 된] 거임"
   ]
  },
  {
   "id": "b2",
   "voice": "nar",
   "gap": 0.12,
   "say": "콘센트, 멀티탭 사고만 5년간 387건.",
   "cap": [
    "콘센트·멀티탭 사고 / 5년간 [387건]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "그럼 멀티탭 수명은 몇 년일까?",
   "cap": [
    "멀티탭 [수명]은 / 몇 년일까?"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.08,
   "say": "삼 년? 오 년?",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "정답. 딱 정해진 숫자는 없음.",
   "cap": [
    "정답: 정해진 / 숫자는 {없음}"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "대신 멀티탭이 직접 신호를 보냄.",
   "cap": [
    "대신 멀티탭이 / 직접 [신호]를 보냄"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "플러그가 헐렁하게 빠지면 신호 하나.",
   "cap": [
    "플러그가 / [헐렁]하면 하나"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "누렇게 변하거나 그을렸으면 둘.",
   "cap": [
    "[누렇게] 변하면 둘"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "타는 냄새가 나면 바로 교체.",
   "cap": [
    "[타는 냄새]면 / {바로 교체}"
   ]
  },
  {
   "id": "i2",
   "voice": "me",
   "gap": 0.08,
   "say": "킁킁, 이거 무슨 냄새지?",
   "cap": [
    ""
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "콘센트 사이 먼지도 불씨가 됨.",
   "cap": [
    "콘센트 사이 / [먼지]도 불씨"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 멀티탭에 멀티탭 꽂기? 금지.",
   "cap": [
    "멀티탭에 멀티탭? / {금지}"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "에어컨, 온열기는 벽 콘센트에 바로.",
   "cap": [
    "에어컨·온열기는 / [벽 콘센트]에"
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.15,
   "say": "님 멀티탭은 몇 개 해당됨?",
   "cap": [
