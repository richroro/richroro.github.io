  },
  {
   "id": "b",
   "voice": "friend",
   "gap": 0.06,
   "say": "칸이 모자란데 어떡해.",
   "cap": [
    "\"칸이 모자란데 어떡해\""
   ]
  },
  {
   "id": "c",
   "voice": "friend",
   "gap": 0.06,
   "say": "근데 요즘 폰이 하루 종일 충전 중이야.",
   "cap": [
    "\"근데 요즘 폰이 하루 / 종일 충전 중이야\""
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.06,
   "say": "정부도 멀티탭에 또 연결하지 말랬어.",
   "cap": [
    "\"정부도 멀티탭에 / 또 연결하지 말랬어\""
   ]
  },
  {
   "id": "e",
   "voice": "friend",
   "gap": 0.06,
   "say": "그거 그냥 잔소리잖아.",
   "cap": [
    "\"그거 그냥 잔소리잖아\""
   ]
  },
  {
   "id": "f",
   "voice": "me",
   "gap": 0.06,
   "say": "콘센트, 멀티탭 사고만 5년간 387건이래.",
   "cap": [
    "\"멀티탭 사고만 / 5년간 [387건]이래\""
   ]
  },
  {
   "id": "g",
   "voice": "friend",
   "gap": 0.06,
   "say": "우리 건 멀쩡하거든?",
   "cap": [
    ""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.08,
   "say": "그래서 도치가 탑을 한 층씩 따라 내려가 봄.",
   "cap": [
    "탑을 한 층씩 [따라] 내려가 봄"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.08,
   "say": "삼 층엔 충전기 다섯 개, 이 층엔 선풍기.",
