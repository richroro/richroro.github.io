 "lines": [
  {
   "id": "a0",
   "voice": "gpa",
   "gap": 0.0,
   "say": "삼겹살, 이 인분.",
   "cap": [
    "\"삼겹살 [2인분]\""
   ]
  },
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.08,
   "say": "매주 목요일 일곱 시, 늘 혼자 오시는 할아버지.",
   "cap": [
    "매주 [목요일 7시] / 늘 혼자 오는 할아버지"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.08,
   "say": "근데 꼭 이 인분을 시키고, 딱 반만 드세요, 나머지는 손도 안 대고.",
   "cap": [
    "꼭 2인분 시키고 [딱 반만] 드심"
   ]
  },
  {
   "id": "c",
   "voice": "gpa",
   "gap": 0.06,
   "say": "학생, 저녁은 먹었어?",
   "cap": [
    ""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.08,
   "say": "네, 먹었죠, 사실 제 저녁은 매일 컵라면.",
   "cap": [
    "\"네, 먹었죠\" 사실 매일 [컵라면]"
   ]
  },
  {
   "id": "e",
   "voice": "boss",
   "gap": 0.06,
   "say": "남은 거야, 잔말 말고 구워 먹어.",
   "cap": [
    ""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.08,
   "say": "목요일마다 나오는 직원 고기, 사장님 최고.",
   "cap": [
    "목요일마다 나오는 [직원 고기]"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.08,
   "say": "사장님, 저 할아버지 매번 반이나 남기세요, 그냥 일 인분만 드려요.",
   "cap": [
    "\"매번 반이나 남기세요\" / \"그냥 [1인분]만 드려요\""
   ]
  },
  {
   "id": "h",
   "voice": "boss",
   "gap": 0.06,
   "say": "잔말 말고, 이 인분 그대로 드려.",
   "cap": [
    "\"잔말 말고 [2인분] 드려\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.08,
   "say": "그런데 그 주 목요일, 할아버지가 안 오셨다.",
   "cap": [
    "그 주 목요일 / 할아버지가 [안 오셨다]"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.08,
   "say": "사장님, 오늘은 직원 고기 없어요?",
   "cap": [
    "\"오늘은 [직원 고기] 없어요?\""
   ]
  },
  {
   "id": "k",
   "voice": "boss",
   "gap": 0.06,
   "say": "없어, 어르신이 안 오셨잖아.",
   "cap": [
    "\"없어. 어르신이 안 오셨잖아\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.08,
   "say": "장부엔 이렇게 적혀 있었다, 목요일 이 인분, 일 인분은 알바 학생 저녁밥.",
   "cap": [
    "목요일 2인분 / 1인분은 [알바 학생 저녁]"
   ]
  },
  {
   "id": "m",
   "voice": "boss",
   "gap": 0.06,
   "say": "그 어르신도 사십 년 전에 여기서 불판 닦았어, 우리 아버지가 똑같이 해 드렸대.",
   "cap": [
    "\"그 어르신도 / [40년 전] 여기 알바\" / \"우리 아버지가 / 똑같이 해 드렸대\""
   ]
  },
  {
   "id": "n",
   "voice": "gpa",
   "gap": 0.06,
   "say": "학생, 저녁은 먹었어?",
   "cap": [
    "\"학생, 저녁은 먹었어?\""
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.08,
   "say": "네, 덕분에 잘 먹었어요.",
   "cap": [
    "\"네, [덕분에] 잘 먹었어요\""
   ]
  }
