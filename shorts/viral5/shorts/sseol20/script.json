 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "매달 일 일, 모르는 사람이 만 원을 보내.",
   "cap": [
    "매달 1일 / 모르는 [만 원]이 와"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "입금자 이름은 매번 똑같아, 하나.",
   "cap": [
    "입금자는 / 매번 '[하나]'"
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.1,
   "say": "하나, 그게 누구지?",
   "cap": [
    "\"[하나]? / 그게 누구지?\""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "벌써 일 년째, 한 번도 안 빠졌어.",
   "cap": [
    "벌써 [1년째] / 한 번도 안 빠졌어"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "혹시 사기인가 싶어서 은행에도 물어봤어.",
   "cap": [
    "혹시 [사기]인가 / 은행에 물어봤어"
   ]
  },
  {
   "id": "f",
   "voice": "clk",
   "gap": 0.1,
   "say": "보낸 분 계좌는 정상이에요.",
   "cap": [
    "\"보낸 분 계좌는 / [정상]이에요\""
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 나도 일 원 보내면서 메모를 적었어.",
   "cap": [
    "그래서 [1원] 보내며 / 메모를 적었어"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "다음 달 일 일, 만 원이랑 메모가 같이 왔어.",
   "cap": [
    "다음 달 1일 / 만 원과 [메모]"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "초등학교 때 빌린 천 원 갚아요.",
   "cap": [
    "'초등학교 때 빌린 / [천 원] 갚아요'"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "기억났어, 이 학년 때 준비물 못 산 짝꿍한테 천 원 빌려줬거든.",
   "cap": [
    "2학년 때 짝꿍한테 / [천 원] 빌려줬어"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 천 원 갚으려고 일 년 동안 만 원씩 보낸 거야.",
   "cap": [
    "천 원 갚으려고 / 1년 동안 [만 원]씩"
   ]
  },
  {
   "id": "l",
   "voice": "me",
   "gap": 0.1,
   "say": "야, 너 이자를 얼마나 쳐 준 거야?",
   "cap": [
    "\"야, [이자]를 / 얼마나 쳐 준 거야?\""
   ]
  },
  {
   "id": "m",
   "voice": "fr",
   "gap": 0.1,
   "say": "그때 그 천 원 없었으면 나 울었어.",
   "cap": [
    "\"그 천 원 없었으면 / 나 [울었어]\""
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 이번 달엔 내가 만 원을 보냈어.",
   "cap": [
    "이번 달엔 / [내가] 만 원 보냄"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "메모는, 밥 사, 십이만 원어치.",
   "cap": [
    "메모: '밥 사' / [12만 원]어치"
   ]
  }
 ]
}