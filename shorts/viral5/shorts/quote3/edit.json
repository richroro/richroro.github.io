 "card": {
  "items": [
   {
    "at": 0.0,
    "ko": "서른한 살, 베토벤에게 생긴 일",
    "en": "루트비히 판 베토벤"
   },
   {
    "at": 3.2,
    "ko": "음악가의 귀가 점점 멀어졌다"
   },
   {
    "at": 6.2,
    "ko": "빈 근교 시골 마을에 머물던 가을",
    "panel": {
     "big": "숨겼다",
     "small": "\"더 크게 말해 주세요\"\n그 말을 할 수 없었다",
     "bg": "#2b2d42",
     "fg": "#ffffff"
    }
   },
   {
    "at": 9.2,
    "ko": "그곳에서 몰래 편지를 썼다",
    "panel": {
     "big": "동생들에게",
     "small": "귀가 멀어 간다는 고백",
     "bg": "#FFE8A3",
     "doodle": "music"
    }
   },
   {
    "at": 12.2,
    "ko": "절망이 가득한 편지였다",
    "panel": {
     "big": "부치지\n않은 편지",
     "small": "그가 세상을 떠난 뒤에야 발견됐다",
     "bg": "#E8DDFF"
    }
   },
   {
    "at": 15.2,
    "ko": "그런데 그 편지 한가운데",
    "quote": {
     "ko": "오직 예술이 나를 붙잡았다./내 안의 모든 걸 꺼내기 전엔/세상을 떠날 수 없었다.",
     "orig": "nur sie die Kunst, sie hielt mich zurück, ach es dünkte mir unmöglich, die Welt eher zu verlassen, bis ich das alles hervorgebracht …",
     "who": "베토벤, 하일리겐슈타트 유서"
    }
   },
   {
    "at": 19.6,
    "ko": "그는 다시 피아노 앞에 앉았다",
    "en": "베토벤이 쓰던 피아노"
   },
   {
    "at": 22.6,
    "ko": "거의 듣지 못하게 된 뒤 완성한 곡",
    "en": "교향곡 9번 '합창'"
   },
   {
    "at": 25.6,
    "ko": "공연이 끝났을 때",
    "panel": {
     "big": "초연 날",
     "small": "그는 박수 소리를 듣지 못했다",
     "bg": "#CFE8FF"
    }
   },
   {
    "at": 28.6,
    "ko": "돌아선 그의 눈앞엔 환호가 있었다",
    "panel": {
     "big": "돌아보니",
     "small": "객석 가득 박수 치는 사람들",
     "bg": "#FFE8A3"
    }
   }
  ],
