 "lines": [
  {
   "id": "a0",
   "voice": "boss",
   "gap": 0.0,
   "say": "김칫국물 총각 왔네!",
   "cap": [
    "\"김칫국물 총각 왔네!\""
   ]
  },
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.08,
   "say": "이름도 안 말했는데 사장님이 내 셔츠를 꺼냄.",
   "cap": [
    "이름도 안 말했는데 / 내 셔츠를 [꺼냄]"
   ]
  },
  {
   "id": "a2",
   "voice": "me",
   "gap": 0.06,
   "say": "단추 하나 없는데, 다림질만 해 주세요.",
   "cap": [
    "\"단추 하나 없는데, / 다림질만 해 주세요\""
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.08,
   "say": "동네 세탁소 사장님 기억력, 진짜 미침.",
   "cap": [
    "세탁소 사장님 기억력 [미침]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.08,
   "say": "번호표도 없음, 장부도 안 봄.",
   "cap": [
    "번호표 없음 장부도 [안 봄]"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.06,
   "say": "제 거 어떻게 아셨어요?",
   "cap": [
    "\"제 거 어떻게 아셨어요?\""
   ]
  },
  {
   "id": "e",
   "voice": "boss",
   "gap": 0.06,
   "say": "커피 자국 바지는 삼 층 아가씨 거고.",
   "cap": [
    "\"커피 자국 바지는 / [3층] 아가씨 거\""
   ]
  },
  {
   "id": "f",
   "voice": "boss",
   "gap": 0.06,
   "say": "단추 하나 없는 코트는 경비 아저씨 거고.",
   "cap": [
    "\"단추 하나 없는 코트는 / 경비 아저씨 거고\""
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.08,
   "say": "사장님은 사람을 얼룩으로 기억함.",
   "cap": [
    "사람을 [얼룩]으로 기억함"
   ]
  },
  {
   "id": "h",
   "voice": "me",
   "gap": 0.06,
   "say": "그럼 저는 영원히 김칫국물이에요?",
   "cap": [
    "\"그럼 저는 영원히 / 김칫국물이에요?\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.08,
   "say": "솔직히 좀 억울함, 그날만 흘린 건데.",
   "cap": [
    "솔직히 좀 억울 / 그날만 [흘린] 건데"
   ]
  },
  {
   "id": "i2",
   "voice": "me",
   "gap": 0.06,
   "say": "응, 다음 주 면접이라 셔츠 맡겼어.",
   "cap": [
    ""
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.08,
   "say": "근데 다음 주, 맡긴 셔츠를 찾으러 감.",
   "cap": [
    "다음 주 셔츠 찾으러 감"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.08,
   "say": "떨어졌던 단추가 새로 달려 있었음.",
   "cap": [
    "떨어진 단추가 [새로] 달려 있음"
   ]
  },
  {
   "id": "l",
   "voice": "boss",
   "gap": 0.06,
   "say": "그거 서비스야, 면접 본다며?",
   "cap": [
    ""
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.08,
   "say": "지나가듯 한 말까지 기억하고 계심.",
   "cap": [
    "지나가듯 한 말까지 [기억]하심"
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.08,
   "say": "님 동네에도 이런 사장님 있음?",
   "cap": [
    "님 동네에도 이런 [사장님] 있음?"
   ]
  }
 ]
}