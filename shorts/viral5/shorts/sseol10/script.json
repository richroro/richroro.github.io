 "tail": 0.45,
 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "동생 생일 선물이 양말 한 짝이야.",
   "cap": [
    "동생 생일 선물이 / 양말 [한 짝]"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "내 패딩 빌려 가서 안 돌려준 동생이, 생일에 상자를 주더라.",
   "cap": [
    "내 [패딩] 안 돌려준 동생이 / 생일 상자를 줬어"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "열어 보니까 양말 딱 한 짝이 들어 있더라.",
   "cap": [
    "열어 보니 / 양말 [한 짝]"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.1,
   "say": "야, 이게 뭐야, 나머지 한 짝은?",
   "cap": [
    "\"야, 이게 뭐야? / [나머지 한 짝]은?\""
   ]
  },
  {
   "id": "e",
   "voice": "sis",
   "gap": 0.1,
   "say": "있잖아, 잘 찾아봐.",
   "cap": [
    "\"있잖아. / [잘 찾아봐]\""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "다음 선물은 이어폰 한쪽, 그다음엔 머리끈.",
   "cap": [
    "다음엔 [이어폰 한쪽] / 그다음엔 머리끈"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "마지막엔 접는 우산까지 나왔어.",
   "cap": [
    "마지막엔 / [접는 우산]까지"
   ]
  },
  {
   "id": "h",
   "voice": "me",
   "gap": 0.1,
   "say": "얘 쓰레기 모으나?",
   "cap": [
    "\"얘 [쓰레기] / 모으나?\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 우산을 펼쳐 보니까, 내 이름이 써 있는 거야.",
   "cap": [
    "우산을 펼쳐 보니 / [내 이름]이 써 있어"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "그제야 알았어, 전부 내가 잃어버린 거였어.",
   "cap": [
    "전부 내가 / [잃어버린] 거였어"
   ]
  },
  {
   "id": "k",
   "voice": "sis",
   "gap": 0.1,
   "say": "오빠가 흘린 거, 일 년 동안 주웠어.",
   "cap": [
    "\"오빠가 흘린 거 / [1년 동안] 주웠어\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "양말은 소파 밑에서, 이어폰은 버스에서.",
   "cap": [
    "양말은 [소파 밑] / 이어폰은 버스"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "괜히 감동받아서 동생 머리를 쓰다듬었지.",
   "cap": [
    "괜히 감동받아서 / 머리를 [쓰다듬었지]"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 마지막 상자를 열었는데,",
   "cap": [
    "마지막 상자를 / [열었는데]"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "동생이 빌려 가서 안 돌려준 내 패딩이 들어 있었어.",
   "cap": [
    "동생이 빌려 간 / [내 패딩]이 들어 있었어"
   ]
  },
  {
   "id": "p",
   "voice": "sis",
   "gap": 0.1,
   "say": "그건 잃어버린 거 아니야, 선물이야.",
   "cap": [
    "\"그건 잃어버린 거 아냐 / [선물]이야\""
   ]
  }
 ]
}