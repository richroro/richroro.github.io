  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "내 동생은 생일마다 이상한 선물을 준다.",
   "cap": [
    "내 동생은 생일마다 / [이상한 선물]을 준다"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.2,
   "say": "올해는 양말, 그것도 한 짝.",
   "cap": [
    "올해는 양말 / 그것도 [한 짝]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.1,
   "say": "작년엔 이어폰 한쪽.",
   "cap": [
    "작년엔 [이어폰 한쪽]"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.1,
   "say": "그 전엔 머리끈 하나랑 접는 우산.",
   "cap": [
    "그 전엔 [머리끈] 하나랑 / [접는 우산]"
   ]
  },
  {
   "id": "e",
   "voice": "me",
   "gap": 0.15,
   "say": "야, 이거 다 쓰레기 아니야?",
   "cap": [
    ""
   ]
  },
  {
   "id": "f",
   "voice": "sis",
   "gap": 0.15,
   "say": "오빠, 잘 좀 봐 봐.",
   "cap": [
    ""
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.2,
   "say": "자세히 보니, 전부 내가 잃어버렸던 물건들이었다.",
   "cap": [
    "자세히 보니 / 전부 내가 / [잃어버렸던 물건]들이었다"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.1,
   "say": "동생이 일 년 내내 몰래 주워 모은 거였다.",
   "cap": [
    "동생이 [1년 내내] / 몰래 주워 모은 거였다"
   ]
  },
  {
   "id": "h2",
   "voice": "me",
   "gap": 0.15,
   "say": "너... 이걸 다 모은 거야?",
   "cap": [
    ""
   ]
  },
  {
   "id": "i",
   "voice": "sis",
   "gap": 0.15,
   "say": "오빠는 맨날 잃어버리잖아.",
   "cap": [
    ""
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.2,
   "say": "그리고 마지막 상자 안에는,",
   "cap": [
