 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "우즈베키스탄을 이긴 그날 밤, 대표팀에 은퇴 소동이 났습니다.",
   "cap": [
    "우즈벡 이긴 그날 밤",
    "대표팀 [은퇴 소동]"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "주인공은 구십육년생, 김민재, 황인범, 황희찬.",
   "cap": [
    "[96년생] 3명",
    "김민재·황인범·황희찬"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "보도에 따르면, 셋은 경기 직후 라커룸에서 동반 은퇴를 시사했습니다.",
   "cap": [
    "경기 직후 라커룸",
    "[동반 은퇴] 시사"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "현영민 전력강화위원장이 자정을 넘겨 면담했고,",
   "cap": [
    "전력강화위원장",
    "[자정 넘어] 면담"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.1,
   "say": "주장 손흥민의 리더십에 변화가 필요하다고 말한 것으로 전해졌습니다.",
   "cap": [
    "주장 손흥민",
    "[리더십] 변화 요구",
    "(보도)"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "설득 끝에 소동은 일단락. 황인범은 은퇴 질문에 아니라고 답했습니다.",
   "cap": [
    "설득 끝 [일단락]",
    "황인범 은퇴설 [부인]"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "손흥민은 이번 논란에 따로 입장을 밝히지 않았습니다.",
   "cap": [
    "손흥민",
    "[별도 입장 없음]"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.15,
   "say": "다음 소집은 십일월. 셋을 다시 볼 수 있을까요?",
   "cap": [
    "다음 소집은 [11월]",
    "셋 다시 볼 수 있을까?"
   ]
  }
 ]
