  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "카페 진동벨, 받는 순간부터 게임 시작임.",
   "cap": [
    "진동벨 받는 순간 / [게임] 시작"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "자리에 앉자마자 벨만 쳐다봄.",
   "cap": [
    "앉자마자 / 벨만 [쳐다봄]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "친구 말은 하나도 안 들림.",
   "cap": [
    "친구 말은 / 하나도 {안 들림}"
   ]
  },
  {
   "id": "c2",
   "voice": "friend",
   "gap": 0.08,
   "say": "야, 내 말 듣고 있어?",
   "cap": [
    ""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "옆 테이블 벨이 울리면 내 건 줄 알고 움찔.",
   "cap": [
    "옆 테이블 벨에 / 내 건 줄 [움찔]"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "십 분째 조용함. 혹시 고장 남?",
   "cap": [
    "[10분]째 조용 / 혹시 {고장}?"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "결국 카운터에 확인하러 감.",
   "cap": [
    "결국 카운터에 / [확인]하러 감"
   ]
  },
  {
   "id": "g",
   "voice": "me",
   "gap": 0.08,
   "say": "저기, 제 거 아직인가요?",
   "cap": [
    ""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 순간 손에서 벨이 울림. 부르르르.",
   "cap": [
    "그 순간 손에서 / [부르르르]"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "카운터 바로 앞에서 울리는 벨. 민망함 백 퍼센트.",
   "cap": [
    "카운터 앞에서 울림 / 민망함 {100%}"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 알고 보니, 그거 친구 벨이었음.",
   "cap": [
    "알고 보니 / {친구} 벨이었음"
   ]
  },
  {
   "id": "k",
   "voice": "friend",
   "gap": 0.08,
   "say": "오, 내 거 가져왔어? 고마워!",
   "cap": [
    ""
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.15,
   "say": "님은 진동벨 울리면 몇 초 만에 일어남?",
   "cap": [
    "님은 벨 울리면 / [몇 초] 만에 일어남?"
   ]
  }
 ]
