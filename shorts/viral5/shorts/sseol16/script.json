 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "할아버지는 매일 아침, 창밖 나무만 찍는다.",
   "cap": [
    "할아버지는 매일 아침 / 창밖 [나무]만 찍는다"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.15,
   "say": "같은 자리, 같은 각도로, 딱 한 장씩.",
   "cap": [
    "같은 자리 같은 각도로 / 딱 [한 장]씩"
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.15,
   "say": "할아버지, 그 나무가 그렇게 예뻐요?",
   "cap": [
    ""
   ]
  },
  {
   "id": "d",
   "voice": "gp",
   "gap": 0.1,
   "say": "응. 오늘 거 찍어야지.",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.2,
   "say": "사진첩을 열어 보니, 나무 사진만 삼백 장이었다.",
   "cap": [
    "사진첩을 열어 보니 / 나무 사진만 [300장]"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.1,
   "say": "봄엔 꽃, 여름엔 초록, 가을엔 단풍.",
   "cap": [
    "봄엔 꽃 / 여름엔 초록 / 가을엔 [단풍]"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.2,
   "say": "알고 보니, 할머니가 오랫동안 입원해 계실 때,",
   "cap": [
    "알고 보니 / 할머니가 오랫동안 / [입원]해 계실 때"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.1,
   "say": "창밖 계절을 못 보는 할머니한테, 하루 한 장씩 보낸 거였다.",
   "cap": [
    "창밖 계절을 못 보는 / 할머니한테 / [하루 한 장]씩 보낸 거"
   ]
  },
  {
   "id": "i",
   "voice": "gm",
   "gap": 0.15,
   "say": "오늘은 잎이 더 빨개졌네.",
   "cap": [
    ""
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.2,
   "say": "그리고 오늘, 할머니가 퇴원하셨다.",
   "cap": [
    "그리고 오늘 / 할머니가 [퇴원]하셨다"
   ]
  },
  {
   "id": "k",
   "voice": "gm",
   "gap": 0.15,
   "say": "어머, 사진보다 훨씬 예쁘네.",
   "cap": [
    ""
   ]
  },
  {
   "id": "l",
   "voice": "gp",
   "gap": 0.1,
