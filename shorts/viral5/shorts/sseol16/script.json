 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "할아버지가 일 년째 나무만 찍어.",
   "cap": [
    "할아버지가 1년째 / [나무만] 찍어"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "매일 아침 같은 시간, 같은 자리에서, 같은 나무만.",
   "cap": [
    "매일 같은 시간 / 같은 자리, [같은 나무]"
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.1,
   "say": "할아버지, 나무가 그렇게 좋아?",
   "cap": [
    "\"할아버지, 나무가 / [그렇게] 좋아?\""
   ]
  },
  {
   "id": "d",
   "voice": "gpa",
   "gap": 0.1,
   "say": "응, 이 나무가 제일 예뻐.",
   "cap": [
    "\"응, 이 나무가 / [제일] 예뻐\""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "휴대폰 사진첩이 전부 그 나무였어.",
   "cap": [
    "사진첩이 전부 / [그 나무]"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 사진마다 누구한테 보낸 기록이 있는 거야.",
   "cap": [
    "사진마다 / [보낸 기록]이 있어"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "받는 사람은 할머니였어.",
   "cap": [
    "받는 사람은 / [할머니]"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "할머니는 일 년째 병원에 입원해 계셨거든.",
   "cap": [
    "할머니는 1년째 / [병원]에 계셨어"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "병실 창밖으로는 회색 벽만 보였대.",
   "cap": [
    "병실 창밖은 / [회색 벽]뿐"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 할아버지가 바깥 계절을 하루 한 장씩 보낸 거야.",
   "cap": [
    "바깥 계절을 / 하루 [한 장]씩"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "봄엔 꽃, 여름엔 초록, 가을엔 단풍, 겨울엔 눈.",
   "cap": [
    "봄엔 꽃, 여름엔 초록 / 가을엔 단풍, 겨울엔 눈"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 오늘, 할머니가 퇴원하셨어.",
   "cap": [
    "그리고 오늘 / 할머니가 [퇴원]"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "할머니가 그 나무 앞에 서서 한참 보시더니,",
   "cap": [
    "그 나무 앞에서 / 한참 보시더니"
   ]
  },
  {
   "id": "n",
   "voice": "gma",
   "gap": 0.1,
   "say": "사진보다 실물이 더 예쁘네.",
   "cap": [
    "\"사진보다 / [실물]이 더 예쁘네\""
   ]
  },
  {
   "id": "o",
   "voice": "gpa",
   "gap": 0.1,
   "say": "그럼 내일부턴 당신을 찍어야지.",
   "cap": [
    "\"내일부턴 / [당신]을 찍어야지\""
   ]
  }
 ]
}