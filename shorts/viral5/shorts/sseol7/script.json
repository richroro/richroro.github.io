 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "소개팅 상대가 내 이름 듣고 웃었어.",
   "cap": [
    "소개팅남이 / [내 이름]에 웃었어"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 그 사람 바지에 갈색 털이 잔뜩 묻어 있었어.",
   "cap": [
    "근데 그 사람 바지에 / [갈색 털]이 잔뜩"
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.1,
   "say": "안녕하세요, 보리예요.",
   "cap": [
    "\"안녕하세요 / [보리]예요\""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 상대가 갑자기 고개를 숙이는 거야.",
   "cap": [
    "근데 상대가 / 갑자기 [고개]를 숙여"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "어깨가 막 떨리고, 웃음을 참는 게 보였어.",
   "cap": [
    "어깨가 떨리고 / [웃음]을 참더라"
   ]
  },
  {
   "id": "f",
   "voice": "me",
   "gap": 0.1,
   "say": "제 이름이 웃겨요?",
   "cap": [
    "\"제 이름이 / [웃겨요?]\""
   ]
  },
  {
   "id": "g",
   "voice": "he",
   "gap": 0.1,
   "say": "아니요, 죄송해요. 진짜 아니에요.",
   "cap": [
    "\"아니요 / [진짜 아니에요]\""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "기분 상해서 밥만 먹고 일어나려는데,",
   "cap": [
    "기분 상해서 / [일어나려는데]"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 사람이 휴대폰을 보여 주더라.",
   "cap": [
    "그 사람이 / [휴대폰]을 보여 줬어"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "화면에는 갈색 강아지 사진이 있었어.",
   "cap": [
    "화면에는 / 갈색 [강아지]"
   ]
  },
  {
   "id": "k",
   "voice": "he",
   "gap": 0.1,
   "say": "우리 집 강아지 이름이 보리예요.",
   "cap": [
    "\"우리 강아지 이름이 / [보리]예요\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "아침에도 보리야 밥 먹자, 하고 나왔대.",
   "cap": [
    "아침에도 / '보리야 [밥 먹자]'"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 말에 나도 빵 터져서, 그날 세 시간을 떠들었어.",
   "cap": [
    "나도 빵 터져서 / [3시간] 떠들었어"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 삼 년 뒤, 우리는 결혼했어.",
   "cap": [
    "3년 뒤 / 우리는 [결혼]했어"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "지금 우리 집에서 보리야, 하고 부르면,",
   "cap": [
    "지금 우리 집에서 / '[보리야]' 부르면"
   ]
  },
  {
   "id": "p",
   "voice": "nar",
   "gap": 0.12,
   "say": "보리 둘이 동시에 달려와.",
   "cap": [
    "보리 [둘]이 / 동시에 달려와"
   ]
  }
 ]
}