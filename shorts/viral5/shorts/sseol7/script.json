{
 "title": ["소개팅 상대가 내 이름 듣고", "웃음 참은 이유"],
 "voices": {
  "nar": {"edge": "ko-KR-SunHiNeural", "rate": "+12%"},
  "me": {"edge": "ko-KR-SunHiNeural", "rate": "+12%", "pitch": "+8Hz"},
  "him": {"edge": "ko-KR-InJoonNeural", "rate": "+10%", "pitch": "+0Hz"}
 },
 "tail": 0.5,
 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "첫 소개팅 날, 떨리는 마음으로 인사를 했다.", "cap": ["첫 소개팅 날 / 떨리는 마음으로 / 인사를 했다"]},
  {"id": "b", "voice": "me", "gap": 0.15, "say": "안녕하세요, 보리예요.", "cap": [""]},
  {"id": "c", "voice": "nar", "gap": 0.2, "say": "그 순간, 상대가 입술을 꽉 깨물었다.", "cap": ["그 순간 / 상대가 [입술을 꽉] 깨물었다"]},
  {"id": "d", "voice": "nar", "gap": 0.1, "say": "밥 먹을 때도, 커피 마실 때도, 계속 웃음 참는 얼굴.", "cap": ["밥 먹을 때도 / 커피 마실 때도 / 계속 [웃음 참는 얼굴]"]},
  {"id": "e", "voice": "me", "gap": 0.15, "say": "내 이름이 그렇게 웃긴가...", "cap": [""]},
  {"id": "f", "voice": "nar", "gap": 0.2, "say": "결국 참다못해 물어봤다.", "cap": ["결국 [참다못해] / 물어봤다"]},
  {"id": "g", "voice": "me", "gap": 0.1, "say": "저기... 왜 자꾸 웃으세요?", "cap": [""]},
  {"id": "h", "voice": "him", "gap": 0.15, "say": "죄송해요... 저희 집 강아지 이름이 보리예요.", "cap": [""]},
  {"id": "i", "voice": "nar", "gap": 0.2, "say": "다음 주말, 진짜 보리를 만났다.", "cap": ["다음 주말 / [진짜 보리]를 만났다"]},
  {"id": "j", "voice": "nar", "gap": 0.1, "say": "꼬리를 흔들면서 나한테 와락 안기더라.", "cap": ["꼬리를 흔들면서 / 나한테 [와락] 안기더라"]},
  {"id": "k", "voice": "nar", "gap": 0.2, "say": "그리고 삼 년 뒤, 우리는 결혼했다.", "cap": ["그리고 3년 뒤 / 우리는 [결혼했다]"]},
  {"id": "l", "voice": "nar", "gap": 0.15, "say": "지금 우리 집엔 보리가 둘이다.", "cap": ["지금 우리 집엔 / [보리가 둘]이다"]},
  {"id": "m", "voice": "him", "gap": 0.15, "say": "보리야~!", "cap": [""]},
  {"id": "n", "voice": "nar", "gap": 0.1, "say": "부르면 둘 다 온다.", "cap": ["부르면 [둘 다 온다]"]}
 ]
}
