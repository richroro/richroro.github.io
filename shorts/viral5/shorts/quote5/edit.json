{
 "credit": "",
 "layout": "card",
 "card": {
  "items": [
   {
    "at": 0.0,
    "ko": "생후 19개월, 심한 병을 앓은 뒤",
    "en": "헬렌 켈러"
   },
   {
    "at": 3.2,
    "ko": "보지도 듣지도 못하게 됐다",
    "panel": {
     "big": "어둠과\n침묵",
     "bg": "#2b2d42",
     "fg": "#ffffff"
    }
   },
   {
    "at": 6.2,
    "ko": "7살 되기 직전, 선생님이 찾아왔다",
    "en": "앤 설리번"
   },
   {
    "at": 9.2,
    "ko": "어느 날 우물가에서",
    "panel": {
     "big": "w-a-t-e-r",
     "small": "펌프 물 아래 손을 넣고\n다른 손바닥에 쓴 글자",
     "bg": "#CFE8FF"
    }
   },
   {
    "at": 12.2,
    "ko": "처음으로 말을 알아들었다",
    "panel": {
     "big": "물!",
     "small": "모든 것에 이름이 있었다",
     "bg": "#FFE8A3"
    }
   },
   {
    "at": 15.2,
    "ko": "손바닥 글자로 세상을 배웠다"
   },
   {
    "at": 18.2,
    "ko": "열 살엔 입으로 말하는 법도 배웠다"
   },
   {
    "at": 21.2,
    "ko": "24살, 대학을 우등으로 졸업",
    "en": "시청각장애인 최초의 학사"
   },
   {
    "at": 24.2,
    "ko": "그 무렵 그녀가 쓴 문장",
    "panel": {
     "big": "23살에\n펴낸 글",
     "small": "제목은 '낙관주의'",
     "bg": "#E8DDFF"
    }
   },
   {
    "at": 27.2,
    "ko": "어둠 속에서 찾아낸 한 문장",
    "quote": {
     "ko": "낙관은 성취로 이끄는 믿음이다./희망 없이는/아무것도 할 수 없다.",
     "orig": "Optimism is the faith that leads to achievement; nothing can be done without hope.",
     "who": "헬렌 켈러, 「낙관주의」"
    }
   }
  ],
  "badge": {
   "name": "오늘의 한마디",
   "icon": "말",
   "color": "#c2410c"
  },
