 "lines": [
  {
   "id": "a0",
   "voice": "dad",
   "gap": 0.0,
   "say": "멀쩡한 걸 왜 버려!",
   "cap": [
    "\"멀쩡한 걸 왜 버려!\""
   ]
  },
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.08,
   "say": "현관 소화기 바꾸자고 했다가 들은 말.",
   "cap": [
    "현관 소화기 / 바꾸자 했다가 [들은 말]"
   ]
  },
  {
   "id": "b",
   "voice": "me",
   "gap": 0.06,
   "say": "아빠, 바늘이 초록 밖이야.",
   "cap": [
    "\"아빠, 바늘이 초록 밖이야\""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.08,
   "say": "압력계 바늘이 초록 밖이면 압력이 빠진 거라 교체.",
   "cap": [
    "바늘이 초록 밖 압력 빠짐 [교체]"
   ]
  },
  {
   "id": "d",
   "voice": "dad",
   "gap": 0.06,
   "say": "한 번도 안 썼으니까 새거지.",
   "cap": [
    "\"한 번도 안 썼으니까 새거지\""
   ]
  },
  {
   "id": "e",
   "voice": "me",
   "gap": 0.06,
   "say": "여기 제조 이천십 년이라고 적혀 있는데?",
   "cap": [
    "\"여기 제조 / [2010년]이라는데?\""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.08,
   "say": "분말 소화기는 딱 십 년.",
   "cap": [
    "분말 소화기는 딱 [10년]"
   ]
  },
  {
   "id": "g",
   "voice": "dad",
   "gap": 0.06,
   "say": "그럼 검사받으면 되잖아.",
   "cap": [
    "\"그럼 검사받으면 되잖아\""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.08,
   "say": "검사 합격해도 연장은 한 번, 삼 년뿐.",
   "cap": [
    "검사 합격해도 / 연장은 1번 [3년]"
   ]
  },
  {
   "id": "i",
   "voice": "me",
   "gap": 0.06,
   "say": "이천십에 십삼 더하면 이천이십삼, 이미 지났어.",
   "cap": [
    ""
   ]
  },
  {
   "id": "j",
   "voice": "dad",
   "gap": 0.06,
   "say": "알았다, 알았어, 새로 사자.",
   "cap": [
    "\"알았다, 알았어. 새로 사자\""
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.08,
   "say": "근데 다음 날, 그 소화기가 안 버려짐.",
   "cap": [
    "근데 다음 날 / 소화기가 [안 버려짐]"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.08,
   "say": "현관문 밑에 받쳐져 있었음.",
   "cap": [
    "현관문 밑에 [받쳐져] 있었음"
   ]
  },
  {
   "id": "m",
   "voice": "dad",
   "gap": 0.06,
   "say": "문 받침으로는 아직 쌩쌩하잖아.",
   "cap": [
    "\"문 받침으로는 / 아직 쌩쌩하잖아\""
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.08,
   "say": "님 집 소화기 바늘, 지금 초록임?",
   "cap": [
    "님 집 소화기 바늘 지금 [초록]임?"
   ]
