 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "님 집 소화기, 바늘이 어디 가리킴?",
   "cap": [
    "님 집 소화기 / [바늘] 어디 가리킴?"
   ]
  },
  {
   "id": "b",
   "voice": "me",
   "gap": 0.08,
   "say": "소화기에 바늘이 있었어?",
   "cap": [
    ""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "손잡이 옆 동그란 압력계. 그게 소화기 건강 상태임.",
   "cap": [
    "손잡이 옆 압력계 / 소화기 [건강 상태]"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "바늘이 초록색 칸 안에 있으면 정상.",
   "cap": [
    "바늘이 [초록색] 안 / 정상"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "초록을 벗어났으면 압력이 빠진 거라 교체.",
   "cap": [
    "초록 벗어나면 / 압력 빠짐 {교체}"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 소화기에도 기한이 있음.",
   "cap": [
    "그리고 소화기에도 / [기한]이 있음"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "분말 소화기는 딱 십 년.",
   "cap": [
    "분말 소화기는 / [10년]"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "지나면 교체. 검사에 합격하면 한 번만 삼 년 연장.",
   "cap": [
    "검사 합격하면 / 한 번만 [3년] 연장"
   ]
  },
  {
   "id": "h2",
   "voice": "me",
   "gap": 0.08,
   "say": "우리 집 거 이천십 년산인데?",
   "cap": [
    ""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "쓰는 법도 딱 네 동작.",
   "cap": [
    "쓰는 법도 / 딱 [네 동작]"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "안전핀 뽑고, 바람 등지고, 호스는 불 쪽으로.",
   "cap": [
    "[안전핀] 뽑고 / 호스는 [불 쪽]"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "손잡이 꽉 쥐고, 빗자루로 쓸듯이.",
   "cap": [
    "손잡이 꽉 쥐고 / [빗자루]로 쓸듯이"
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.15,
   "say": "님 집 소화기 바늘, 지금 초록임?",
   "cap": [
    "님 집 소화기 바늘 / 지금 [초록]임?"
   ]
  }
 ]
