  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "환갑 아빠가 매일 새벽, 영어 단어장을 편다.",
   "cap": [
    "환갑 아빠가 매일 새벽 / [영어 단어장]을 편다"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.15,
   "say": "새벽 다섯 시면 어김없이 거실 불이 켜졌다.",
   "cap": [
    "새벽 5시면 / 어김없이 [거실 불]이 켜졌다"
   ]
  },
  {
   "id": "c",
   "voice": "mom",
   "gap": 0.15,
   "say": "당신 갑자기 왜 그래요?",
   "cap": [
    ""
   ]
  },
  {
   "id": "d",
   "voice": "dad",
   "gap": 0.1,
   "say": "몰라도 돼.",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.15,
   "say": "엄마도 모른다길래, 문 뒤에 숨어서 들어 봤다.",
   "cap": [
    "엄마도 모른다길래 / [문 뒤에 숨어서] 들어 봤다"
   ]
  },
  {
   "id": "f",
   "voice": "dad",
   "gap": 0.15,
   "say": "나이스 투 미츄. 아임 수아스 파더.",
   "cap": [
    ""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.2,
   "say": "그러고 보니, 다음 달에 외국에서 자란 남자친구를 데려간다고 했었지.",
   "cap": [
    "그러고 보니 / 다음 달에 [외국에서 자란] / 남자친구 데려간다고 했지"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.2,
   "say": "그리고 드디어 그날.",
   "cap": [
    "그리고 드디어 그날"
   ]
  },
  {
   "id": "k",
   "voice": "dad",
   "gap": 0.15,
   "say": "나, 나이스 투 미츄!",
   "cap": [
    ""
   ]
  },
  {
   "id": "l",
   "voice": "bf",
   "gap": 0.1,
   "say": "안녕하세요 아버님! 저 한국말 잘해요!",
   "cap": [
    ""
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.15,
   "say": "아빠는 그대로 얼어 버렸다.",
   "cap": [
    "아빠는 그대로 / [얼어] 버렸다"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.2,
   "say": "그 뒤로 아빠는, 공부한 게 아까워서 영어로만 말한다.",
   "cap": [
    "그 뒤로 아빠는 / 공부한 게 아까워서 / [영어로만] 말한다"
   ]
  },
  {
   "id": "o",
   "voice": "dad",
   "gap": 0.15,
   "say": "하우 아 유? 아임 파인, 땡큐!",
   "cap": [
    ""
   ]
  }
