 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "예순 살 아빠가 영어를 시작했어.",
   "cap": [
    "60살 아빠가 / [영어]를 시작했어"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "매일 새벽 다섯 시에 거실에서 중얼중얼하는 거야.",
   "cap": [
    "매일 새벽 [5시] / 거실에서 중얼중얼"
   ]
  },
  {
   "id": "c",
   "voice": "dad",
   "gap": 0.1,
   "say": "아임, 수아스, 파더.",
   "cap": [
    "\"아임... 수아스... / [파더]...\""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "딱 그 한 문장만 백 번씩 연습하더라.",
   "cap": [
    "딱 한 문장만 / [100번]씩"
   ]
  },
  {
   "id": "e",
   "voice": "mom",
   "gap": 0.1,
   "say": "니 아빠 요즘 왜 저러니?",
   "cap": [
    "\"니 아빠 요즘 / [왜 저러니?]\""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "사실 그건 나 때문이었어.",
   "cap": [
    "사실 그건 / [나] 때문이었어"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "다음 주에 남자친구가 인사 오기로 했거든.",
   "cap": [
    "다음 주에 / [남자친구]가 인사 와"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "외국에서 자랐다고만 했더니, 아빠가 그날 영어 책을 산 거야.",
   "cap": [
    "외국에서 자랐다고[만] 했더니 / 그날 영어 책 샀어"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "드디어 그날, 아빠가 문을 열자마자.",
   "cap": [
    "드디어 그날 / 문 열자마자"
   ]
  },
  {
   "id": "j",
   "voice": "dad",
   "gap": 0.1,
   "say": "하이, 아임 수아스 파더.",
   "cap": [
    "\"하이! / 아임 [수아스 파더]\""
   ]
  },
  {
   "id": "k",
   "voice": "bf",
   "gap": 0.1,
   "say": "안녕하세요 아버님. 말씀 편하게 하세요.",
   "cap": [
    "\"안녕하세요 아버님 / [편하게] 하세요\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "남자친구는 한국말을 나보다 잘했어.",
   "cap": [
    "남자친구는 / 한국말을 [나보다] 잘해"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 아빠는 석 달 연습한 게 아까웠는지,",
   "cap": [
    "근데 아빠는 / 석 달 연습이 [아까웠는지]"
   ]
  },
  {
   "id": "n",
   "voice": "dad",
   "gap": 0.1,
   "say": "오케이, 땡큐, 굿.",
   "cap": [
    "\"오케이... 땡큐... / [굿]\""
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "지금도 남자친구한테는 영어로만 말해.",
   "cap": [
    "지금도 남친한텐 / [영어]로만 말해"
   ]
  },
  {
   "id": "p",
   "voice": "bf",
   "gap": 0.1,
   "say": "네 아버님, 저도 굿이에요.",
   "cap": [
    "\"네 아버님 / 저도 [굿]이에요\""
   ]
  }
 ]
}