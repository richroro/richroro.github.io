 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "우리 할아버지는 매일 오전 열 시, 은행에 가신다.",
   "cap": [
    "우리 할아버지는 / 매일 [오전 10시] / 은행에 가신다"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.1,
   "say": "돈을 찾는 것도, 넣는 것도 아닌데.",
   "cap": [
    "돈을 찾는 것도 / 넣는 것도 [아닌데]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.2,
   "say": "가족들이 걱정돼서, 하루는 몰래 따라가 봤다.",
   "cap": [
    "가족들이 걱정돼서 / 하루는 [몰래] 따라가 봤다"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.2,
   "say": "할아버지는 은행 로비에 앉아서,",
   "cap": [
    "할아버지는 / [은행 로비]에 앉아서"
   ]
  },
  {
   "id": "e",
   "voice": "gp",
   "gap": 0.15,
   "say": "어서 오세요!",
   "cap": [
    ""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.1,
   "say": "손님이 들어올 때마다 인사를 하고 계셨다.",
   "cap": [
    "손님이 들어올 때마다 / [인사]를 하고 계셨다"
   ]
  },
  {
   "id": "g",
   "voice": "staff",
   "gap": 0.2,
   "say": "아, 지점장님 손녀분이세요?",
   "cap": [
    ""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.15,
   "say": "알고 보니 할아버지는, 삼십 년 전 이 지점의 지점장이었다.",
   "cap": [
    "알고 보니 할아버지는 / [30년 전] / 이 지점의 [지점장]이었다"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.15,
   "say": "직원들도 다 알아서, 매일 커피를 갖다 드린단다.",
   "cap": [
    "직원들도 다 알아서 / 매일 [커피]를 / 갖다 드린단다"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.2,
   "say": "오늘은 신입 직원 교육까지 하셨다.",
   "cap": [
    "오늘은 [신입 직원 교육]까지 / 하셨다"
   ]
  },
  {
   "id": "k",
   "voice": "staff",
   "gap": 0.15,
   "say": "감사합니다, 명예 지점장님!",
   "cap": [
    ""
   ]
  }
