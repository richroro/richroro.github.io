 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "할아버지가 은행에 출근해.",
   "cap": [
    "할아버지가 / 은행에 [출근]해"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "매일 오전 열 시, 천 원짜리 한 장 들고 나가셔.",
   "cap": [
    "매일 오전 [10시] / 천 원 한 장 들고"
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.1,
   "say": "할아버지 은퇴하신 지 딱 이십 년 됐는데?",
   "cap": [
    "\"은퇴하신 지 / 딱 [20년] 됐는데?\""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "궁금해서 몰래 따라가 봤어.",
   "cap": [
    "궁금해서 / [몰래] 따라가 봤어"
   ]
  },
  {
   "id": "e",
   "voice": "clk",
   "gap": 0.1,
   "say": "할아버님, 오늘도 천 원이시죠?",
   "cap": [
    "\"할아버님 / 오늘도 [천 원]이시죠?\""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "직원들도 다 아는 단골이었어, 매일 딱 천 원만 넣고 가신대.",
   "cap": [
    "매일 딱 [천 원]만 / 넣고 가신대"
   ]
  },
  {
   "id": "g",
   "voice": "me",
   "gap": 0.1,
   "say": "천 원을 왜 매일 넣지?",
   "cap": [
    "\"천 원을 / 왜 [매일] 넣지?\""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "할머니한테 물어봤더니, 할머니가 갑자기 딴청을 피우시더라.",
   "cap": [
    "할머니한테 물었더니 / 갑자기 [딴청]"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 내 스무 살 생일, 할아버지가 통장을 하나 주셨어.",
   "cap": [
    "내 스무 살 생일 / 할아버지가 [통장]을"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "첫 줄 날짜가, 내가 태어난 날이었어.",
   "cap": [
    "첫 줄 날짜가 / [내가 태어난 날]"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "이십 년 동안 하루도 안 빠지고, 천 원씩.",
   "cap": [
    "20년 동안 하루도 안 빠지고 / [천 원]씩"
   ]
  },
  {
   "id": "l",
   "voice": "gpa",
   "gap": 0.1,
   "say": "대학 가면 노트북 사.",
   "cap": [
    "\"대학 가면 / [노트북] 사\""
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 잔액을 보는데 좀 이상했어.",
   "cap": [
    "근데 잔액이 / 좀 [이상했어]"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "칠백삼십만 원이어야 하는데, 삼백만 원밖에 없는 거야.",
   "cap": [
    "730만 원이어야 하는데 / [300만 원]"
   ]
  },
  {
   "id": "o",
   "voice": "gpa",
   "gap": 0.1,
   "say": "중간에 할머니가 몇 번 찾아 쓰셨다.",
   "cap": [
    "\"중간에 [할머니]가 / 몇 번 찾아 쓰셨다\""
   ]
  },
  {
   "id": "p",
   "voice": "gma",
   "gap": 0.1,
   "say": "이자는 할미가 갚을게.",
   "cap": [
    "\"[이자]는 / 할미가 갚을게\""
   ]
  }
 ]
