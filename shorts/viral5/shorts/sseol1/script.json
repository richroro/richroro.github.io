 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "육학년 때, 짝꿍이 매일 내 우유를 마셨다.",
   "cap": [
    "6학년 때 짝꿍이 / 매일 [내 우유]를 마셨다"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.15,
   "say": "우유만 나오면, 내 것까지 가져가서 원샷.",
   "cap": [
    "우유만 나오면 / 내 것까지 [원샷]"
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.15,
   "say": "야! 그거 내 거잖아!",
   "cap": [
    ""
   ]
  },
  {
   "id": "d",
   "voice": "jj",
   "gap": 0.1,
   "say": "응. 맛있더라.",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.2,
   "say": "그렇게 일 년 동안 뺏긴 우유만 이백 개.",
   "cap": [
    "그렇게 1년 동안 / 뺏긴 우유 [200개]"
   ]
  },
  {
   "id": "e2",
   "voice": "me",
   "gap": 0.15,
   "say": "얘는 우유에 미쳤나?",
   "cap": [
    ""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.2,
   "say": "졸업식 날, 걔가 할 말이 있다며 나를 불렀다.",
   "cap": [
    "졸업식 날 / 걔가 [할 말이] 있대"
   ]
  },
  {
   "id": "g",
   "voice": "jj",
   "gap": 0.15,
   "say": "사실 나... 우유 못 먹어.",
   "cap": [
    ""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.2,
   "say": "알고 보니, 내가 우유만 먹으면 배 아파하는 걸 보고,",
   "cap": [
    "알고 보니 / 내가 우유만 먹으면 / [배 아파하는 걸] 보고"
   ]
  },
  {
   "id": "h2",
   "voice": "nar",
   "gap": 0.1,
   "say": "선생님 몰래 대신 마셔 준 거였다.",
   "cap": [
    "선생님 몰래 / [대신] 마셔 준 거"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.2,
   "say": "덕분에 걔는 일 년 만에 키가 십오 센티 컸고,",
   "cap": [
    "덕분에 걔는 / 1년 만에 키가 [15cm] 컸고"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.15,
   "say": "십오 년이 지난 지금은...",
   "cap": [
    "15년이 지난 지금은..."
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.2,
   "say": "여보! 우유 좀 남기라고!",
   "cap": [
    ""
   ]
  }
 ]
