 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "짝꿍이 내 우유를 일 년 마셨어.",
   "cap": [
    "짝꿍이 [내 우유]를 / 1년 마셨어"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "육학년 때 급식 우유만 나오면, 내 것까지 가져가서 원샷하는 거야.",
   "cap": [
    "급식 우유만 나오면 / 내 것까지 [원샷]"
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.1,
   "say": "야, 그거 내 거잖아!",
   "cap": [
    "\"야! 그거 / [내 거]잖아!\""
   ]
  },
  {
   "id": "d",
   "voice": "jj",
   "gap": 0.1,
   "say": "응 맛있더라.",
   "cap": [
    "\"응. 맛있더라~\""
   ]
  },
  {
   "id": "d2",
   "voice": "nar",
   "gap": 0.12,
   "say": "웃긴 건, 그 뒤로 내가 보건실 갈 일이 싹 없어졌다는 거야.",
   "cap": [
    "웃긴 건 그 뒤로 / 내가 [보건실] 갈 일이 없어짐"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "그렇게 일 년 동안 뺏긴 우유가 무려 이백 개야.",
   "cap": [
    "1년 동안 뺏긴 우유 / 무려 [200개]"
   ]
  },
  {
   "id": "f",
   "voice": "me",
   "gap": 0.1,
   "say": "얘 진짜 우유에 미쳤나?",
   "cap": [
    "\"얘 우유에 / [미쳤나?]\""
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 이상한 게, 걔는 마실 때마다 표정이 썩어 있었거든.",
   "cap": [
    "근데 걔는 마실 때마다 / 표정이 [썩어] 있었어"
   ]
  },
  {
   "id": "g2",
   "voice": "nar",
   "gap": 0.12,
   "say": "한번은 마시고 나서 화장실로 뛰어가는 것도 봤어.",
   "cap": [
    "마시고 나서 / [화장실로] 뛰는 것도 봤어"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "그러다 졸업식 날, 걔가 할 말 있다고 날 부르더라.",
   "cap": [
    "졸업식 날 / 걔가 [할 말] 있대"
   ]
  },
  {
   "id": "i",
   "voice": "jj",
   "gap": 0.1,
   "say": "사실 나, 우유 못 먹어.",
   "cap": [
    "\"사실 나... / [우유 못 먹어]\""
   ]
  },
  {
   "id": "j",
   "voice": "me",
   "gap": 0.1,
   "say": "뭐 그럼 그걸 왜 마셨는데?",
   "cap": [
    "\"뭐? 그럼 / [왜] 마셨는데?\""
   ]
  },
  {
   "id": "k",
   "voice": "jj",
   "gap": 0.1,
   "say": "너 우유만 먹으면 배 아파서 보건실 갔잖아.",
   "cap": [
    "\"너 우유만 먹으면 / [배 아파서] 보건실 갔잖아\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "남기면 혼나니까, 몰래 대신 마셔 준 거였어.",
   "cap": [
    "남기면 혼나니까 / [대신] 마셔 준 거야"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "덕분에 걔는 일 년 만에 키가 십오 센티 컸고,",
   "cap": [
    "덕분에 걔는 / 키가 [15cm] 컸고"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "십오 년 지난 지금은...",
   "cap": [
    "15년 지난 지금은..."
   ]
  },
  {
   "id": "o",
   "voice": "me2",
   "gap": 0.1,
   "say": "여보, 우유 좀 남기라고!",
   "cap": [
    "\"여보! / [우유 좀 남기라고!]\""
   ]
  },
  {
   "id": "p",
   "voice": "jj2",
   "gap": 0.1,
   "say": "습관 돼서 못 끊겠어.",
   "cap": [
    "\"습관 돼서 / [못 끊겠어]\""
   ]
  }
 ]
}