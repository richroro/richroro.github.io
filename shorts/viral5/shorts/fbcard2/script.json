 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "한국 남자축구 최다골 기록이, 사십칠 년 만에 바뀌었습니다.",
   "cap": ["남자 최다골 기록", "[47년] 만에 바뀌었다"]},
  {"id": "b", "voice": "nar", "gap": 0.12, "say": "시월 육일 우즈베키스탄전, 전반 육 분.",
   "cap": ["10월 6일 우즈벡전", "전반 [6분]"]},
  {"id": "c", "voice": "nar", "gap": 0.1, "say": "손흥민의 오른발 프리킥이 골문 구석에 꽂힙니다.",
   "cap": ["오른발 [프리킥]", "골문 구석에 꽂혔다"]},
  {"id": "d", "voice": "nar", "gap": 0.12, "say": "에이매치 백오십일 경기 만에 통산 오십구 호 골.",
   "cap": ["151경기 만에", "통산 [59호 골]"]},
  {"id": "e", "voice": "nar", "gap": 0.12, "say": "차범근의 오십팔 골을 넘어 단독 일위입니다.",
   "cap": ["차범근 58골 넘어", "[단독 1위]"]},
  {"id": "f", "voice": "nar", "gap": 0.12, "say": "차범근의 오십팔 호 골은 천구백칠십팔 년 십이월이었습니다.",
   "cap": ["차범근 58호 골은", "[1978년] 12월"]},
  {"id": "g", "voice": "nar", "gap": 0.12, "say": "손흥민은 함께한 십육 년이 제일 소중하다고 했습니다.",
   "cap": ["\"함께한 [16년]이", "제일 소중\""]},
  {"id": "h", "voice": "nar", "gap": 0.15, "say": "그런데 남녀 통틀어 한국 최다골은 따로 있습니다. 여자대표팀 지소연, 칠십육 골.",
   "cap": ["남녀 통틀어 1위는?", "[지소연] 76골"]},
  {"id": "i", "voice": "nar", "gap": 0.15, "say": "이 기록, 누가 깰 수 있을까요?",
   "cap": ["이 기록, 누가 깰까?"]}
 ]
