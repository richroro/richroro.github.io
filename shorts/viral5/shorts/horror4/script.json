{
 "title": ["\\[괴담] 이해하면 소름 돋는", "거울"],
 "voices": {"nar": {"edge": "ko-KR-InJoonNeural", "rate": "+5%", "pitch": "-10Hz"}},
 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "새로 이사 온 원룸엔,| 커다란 거울이 하나 있다.", "cap": ["새로 이사 온 / [원룸]", "커다란 [거울]이 / 하나 있다"]},
  {"id": "b", "voice": "nar", "gap": 0.3, "say": "이상하게,| 거울 속 방은 늘 조금 더 어두웠다.", "cap": ["이상하게", "거울 속 방은 / 늘 [더 어두웠다]"]},
  {"id": "c", "voice": "nar", "gap": 0.3, "say": "조명 탓이겠거니 했다.", "cap": ["[조명] 탓이겠거니"]},
  {"id": "d", "voice": "nar", "gap": 0.4, "say": "오늘 밤,| 불을 끄고 누웠다.| 방이 깜깜해졌다.", "cap": ["오늘 밤", "[불을 끄고] 누웠다", "방이 / [깜깜]해졌다"]},
  {"id": "e", "voice": "nar", "gap": 0.4, "say": "무심코 거울 쪽으로 고개를 돌렸는데,", "cap": ["무심코 거울 쪽으로 / 고개를 돌렸는데"]},
  {"id": "f", "voice": "nar", "gap": 0.3, "say": "거울 속 방은,| 아직 불이 켜져 있었다.", "cap": ["거울 속 방은", "아직 [불이 켜져] 있었다"]},
  {"id": "g", "voice": "nar", "gap": 0.5, "say": "그리고 거울 속 침대엔,| 아무도 누워 있지 않았다.", "cap": ["거울 속 [침대]엔", "[아무도] / 누워 있지 않았다"]},
  {"id": "end", "voice": "nar", "gap": 0.6, "say": "이해하셨나요?| 정답은 댓글에.", "cap": ["[이해하셨나요?]", "정답은 [댓글]에"]}
 ],
