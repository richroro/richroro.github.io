   "id": "a1",
   "voice": "nar",
   "gap": 0.05,
   "say": "일단 회원권은",
   "cap": [
    "일단 회원권은"
   ]
  },
  {
   "id": "a1b",
   "voice": "nar",
   "gap": 0.25,
   "say": "일 년짜리부터 끊음.",
   "cap": [
    "1년짜리부터 끊음"
   ]
  },
  {
   "id": "a2",
   "voice": "nar",
   "gap": 0.25,
   "say": "운동복부터 풀세트로 장만함.",
   "cap": [
    "운동복부터 / 풀세트로 장만"
   ]
  },
  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "장비가 반이야.",
   "cap": [
    "\"장비가 반이야\""
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "기구 쓰는 법 몰라서 옆 사람 몰래 따라 함.",
   "cap": [
    "기구 쓰는 법 몰라서 / 옆 사람 몰래 따라 함"
   ]
  },
  {
   "id": "a4",
   "voice": "nar",
   "gap": 0.25,
   "say": "첫날부터 너무 열심히 해 버림.",
   "cap": [
    "첫날부터 / 너무 열심히 해 버림"
   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "다음 날 계단을 못 내려감.",
   "cap": [
    "다음 날 / 계단을 못 내려감"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "다리가 내 다리가.",
   "cap": [
    "\"다리가… 내 다리가…\""
   ]
  },
  {
   "id": "a6",
   "voice": "nar",
   "gap": 0.25,
   "say": "운동했으니까 치킨은 괜찮음.",
   "cap": [
    "운동했으니까 / 치킨은 괜찮음"
   ]
  },
  {
   "id": "a8",
   "voice": "nar",
   "gap": 0.25,
   "say": "거울 앞에서 근육 생겼나 매일 확인.",
   "cap": [
    "거울 앞에서 / 근육 생겼나 매일 확인"
   ]
  },
  {
   "id": "a9",
   "voice": "nar",
   "gap": 0.25,
   "say": "운동 끝나면 인증샷부터 찍음.",
   "cap": [
    "운동 끝나면 / 인증샷부터 찍음"
   ]
  },
  {
   "id": "a7",
   "voice": "nar",
   "gap": 0.25,
   "say": "결국 일 년 회원권으로 샤워만 하고 옴.",
   "cap": [
    "결국 1년 회원권으로 / 샤워만 하고 옴"
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.25,
   "say": "여러분은 몇 개 해당?",
   "cap": [
