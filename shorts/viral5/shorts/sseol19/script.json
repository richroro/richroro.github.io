  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "할머니가 우리 반 단톡방에 있어.",
   "cap": [
    "할머니가 우리 반 / [단톡방]에 있어"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "어느 날 단톡방에 할미라는 사람이 들어왔어.",
   "cap": [
    "어느 날 단톡방에 / '[할미]'가 들어왔어"
   ]
  },
  {
   "id": "c",
   "voice": "fr",
   "gap": 0.1,
   "say": "할미, 누구 할머니야?",
   "cap": [
    "\"[할미]? / 누구 할머니야?\""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "나는 바로 알았어, 우리 할머니 사진이었거든.",
   "cap": [
    "나는 알았어 / [우리 할머니] 사진"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "할머니가 내 폰으로 사진 보다가 초대를 눌렀대.",
   "cap": [
    "할머니가 내 폰 보다가 / [초대]를 눌렀대"
   ]
  },
  {
   "id": "f",
   "voice": "gma",
   "gap": 0.1,
   "say": "얘들아, 우리 손주 잘 부탁해.",
   "cap": [
    "\"얘들아 / 우리 [손주] 잘 부탁해\""
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 한마디에 단톡방이 난리가 났어.",
   "cap": [
    "그 한마디에 / 단톡방이 [난리]"
   ]
  },
  {
   "id": "h",
   "voice": "fr2",
   "gap": 0.1,
   "say": "할머니 안녕하세요.",
   "cap": [
    "\"할머니 / [안녕하세요]\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "다음 날부터 할머니가 매일 아침 인사를 올려.",
   "cap": [
    "다음 날부터 / 매일 [아침 인사]"
   ]
  },
  {
   "id": "j",
   "voice": "gma",
   "gap": 0.1,
   "say": "오늘 비 온다, 우산 챙겨라.",
   "cap": [
    "\"오늘 비 온다 / [우산] 챙겨라\""
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 그날 진짜 비가 왔어.",
   "cap": [
    "근데 그날 / 진짜 [비]가 왔어"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "그때부터 애들이 할머니 말을 믿기 시작했어.",
   "cap": [
    "애들이 할머니를 / [믿기] 시작했어"
   ]
  },
  {
   "id": "m",
   "voice": "fr",
   "gap": 0.1,
   "say": "할머니, 내일 시험 나와요?",
   "cap": [
    "\"할머니, 내일 / [시험] 나와요?\""
   ]
  },
  {
   "id": "n",
   "voice": "gma",
   "gap": 0.1,
   "say": "공부한 데서 나온다.",
   "cap": [
    "\"[공부한 데]서 / 나온다\""
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "지금은 반장 공지보다 할머니 말을 더 잘 들어.",
   "cap": [
    "지금은 반장보다 / [할머니 공지]가 더 셈"
   ]
  },
  {
   "id": "p",
   "voice": "nar",
   "gap": 0.12,
   "say": "졸업식 날엔 우리 반 전부 할머니랑 사진 찍었어.",
   "cap": [
    "졸업식 날 / 반 전체가 [할머니랑] 찰칵"
   ]
  }
 ]
