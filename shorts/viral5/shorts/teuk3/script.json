   "gap": 0.05,
   "say": "사 교시부터",
   "cap": [
    "4교시부터"
   ]
  },
  {
   "id": "a1b",
   "voice": "nar",
   "gap": 0.25,
   "say": "오늘 급식 메뉴만 생각함.",
   "cap": [
    "오늘 급식 메뉴만 생각함"
   ]
  },
  {
   "id": "a2",
   "voice": "nar",
   "gap": 0.25,
   "say": "종 치자마자 뛰지 않고 아주 빠르게 걸어감.",
   "cap": [
    "종 치자마자 뛰지 않고 / 아주 빠르게 걸어감"
   ]
  },
  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "뛰는 거 아니에요!",
   "cap": [
    "\"뛰는 거 아니에요!\""
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "줄 서서 앞에 몇 명 남았는지 계속 셈.",
   "cap": [
    "줄 서서 앞에 / 몇 명 남았는지 계속 셈"
   ]
  },
  {
   "id": "a4",
   "voice": "nar",
   "gap": 0.25,
   "say": "맛있는 반찬은 아껴 뒀다가 마지막에 먹음.",
   "cap": [
    "맛있는 반찬은 아껴 뒀다 / 마지막에 먹음"
   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "급식 국자가 한 번 더 오면 그날은 대성공.",
   "cap": [
    "국자가 한 번 더 오면 / 그날은 대성공"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "오늘 푸딩 나온대!",
   "cap": [
    "\"오늘 푸딩 나온대!\""
   ]
  },
  {
   "id": "a6",
   "voice": "nar",
   "gap": 0.25,
   "say": "친구가 안 먹는 반찬 슬쩍 노림.",
   "cap": [
    "친구가 안 먹는 반찬 / 슬쩍 노림"
   ]
  },
  {
   "id": "a8",
   "voice": "nar",
   "gap": 0.25,
   "say": "급식표 보고 좋아하는 날은 동그라미.",
   "cap": [
    "급식표 보고 / 좋아하는 날은 동그라미"
   ]
  },
  {
   "id": "a9",
   "voice": "nar",
   "gap": 0.25,
   "say": "카레 나오는 날은 복도 냄새부터 다름.",
   "cap": [
    "카레 나오는 날은 / 복도 냄새부터 다름"
   ]
  },
  {
   "id": "a7",
   "voice": "nar",
   "gap": 0.25,
   "say": "졸업하고 나니까 그 급식이 제일 그리움.",
   "cap": [
    "졸업하고 나니까 / 그 급식이 제일 그리움"
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.25,
   "say": "여러분은 몇 개 해당?",
   "cap": [
