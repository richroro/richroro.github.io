 },
 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "밤 열한 시.| 건물엔 나 혼자 남아 있었다.", "cap": ["밤 [열한 시]", "건물엔 / [나 혼자]"]},
  {"id": "b", "voice": "nar", "gap": 0.3, "say": "일 층에서 엘리베이터를 불렀다.", "cap": ["[1층]에서 / 엘리베이터를"]},
  {"id": "c", "voice": "nar", "gap": 0.3, "say": "숫자가 천천히 내려온다.| 사, 삼, 이, 일.", "cap": ["숫자가 / 천천히 내려온다", "사, 삼, 이, [일]"]},
  {"id": "d", "voice": "nar", "gap": 0.4, "say": "띵.| 문이 열렸다.| 안은 텅 비어 있었다.", "cap": ["띵", "문이 열렸다", "안은 [텅] 비어 있었다"]},
  {"id": "e", "voice": "nar", "gap": 0.3, "say": "한 발 들어서는데,| 삐 하고 경고음이 울렸다.", "cap": ["한 발 들어서는데", "[삐—] 경고음"]},
  {"id": "f", "voice": "lift", "gap": 0.25, "say": "정원이 초과되었습니다.", "cap": ["[정원 초과]입니다"]},
  {"id": "g", "voice": "nar", "gap": 0.5, "say": "나는 조용히 뒷걸음질 쳤다.| 문이 닫히고,| 엘리베이터는 위로 올라갔다.", "cap": ["조용히 / [뒷걸음질] 쳤다", "문이 닫히고", "위로 / [올라갔다]"]},
  {"id": "h", "voice": "nar", "gap": 0.4, "say": "나는 다음 걸 타기로 했다.", "cap": ["나는 [다음 걸] / 타기로 했다"]},
  {"id": "end", "voice": "nar", "gap": 0.6, "say": "이해하셨나요?| 정답은 댓글에.", "cap": ["[이해하셨나요?]", "정답은 [댓글]에"]}
 ],
