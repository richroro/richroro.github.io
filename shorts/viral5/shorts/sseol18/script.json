  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "엄마랑 같은 해에 입학했어.",
   "cap": [
    "엄마랑 같은 해에 / [입학]했어"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "내가 대학 붙은 날, 엄마도 합격 문자를 받았거든.",
   "cap": [
    "내가 대학 붙은 날 / 엄마도 [합격] 문자"
   ]
  },
  {
   "id": "c",
   "voice": "mom",
   "gap": 0.1,
   "say": "나도 붙었다, 사회복지학과.",
   "cap": [
    "\"나도 붙었다 / [사회복지학과]\""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "엄마는 스무 살에 나를 가져서 대학을 못 갔대.",
   "cap": [
    "엄마는 스무 살에 / 날 가져서 [대학] 못 갔대"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 마흔에 수능을 다시 본 거야.",
   "cap": [
    "그래서 [마흔]에 / 수능을 다시 봤어"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 문제는, 학교까지 같다는 거야.",
   "cap": [
    "근데 문제는 / [같은 학교]"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "입학식 날, 엄마가 우리 과 단체 사진에 껴 있었어.",
   "cap": [
    "입학식 날 / 엄마가 [단체 사진]에"
   ]
  },
  {
   "id": "h",
   "voice": "me",
   "gap": 0.1,
   "say": "엄마, 여기 우리 과야.",
   "cap": [
    "\"엄마, 여기 / [우리 과]야\""
   ]
  },
  {
   "id": "i",
   "voice": "mom",
   "gap": 0.1,
   "say": "알아, 너 친구 사귀나 보러 왔지.",
   "cap": [
    "\"알아 / 너 [친구] 사귀나 보러 왔지\""
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "도서관에 가면 엄마가 내 자리까지 맡아 놔.",
   "cap": [
    "도서관 가면 / 엄마가 [내 자리]까지"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "그동안 나는 동아리, 엠티, 미팅으로 바빴고.",
   "cap": [
    "그동안 나는 / 동아리, [엠티], 미팅"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "동기들은 엄마를 언니라고 불러.",
   "cap": [
    "동기들은 엄마를 / [언니]라고 불러"
   ]
  },
  {
   "id": "m",
   "voice": "fr",
   "gap": 0.1,
   "say": "언니, 과제 같이 해요.",
   "cap": [
    "\"언니, / [과제] 같이 해요\""
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 첫 학기 성적표가 나왔어.",
   "cap": [
    "그리고 첫 학기 / [성적표]"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "엄마는 장학금, 나는 학사 경고.",
   "cap": [
    "엄마는 [장학금] / 나는 학사 경고"
   ]
  },
  {
   "id": "p",
   "voice": "mom",
   "gap": 0.1,
   "say": "다음 학기엔 엄마랑 같이 공부하자.",
   "cap": [
    "\"다음 학기엔 / 엄마랑 [같이] 공부하자\""
   ]
  }
 ]
