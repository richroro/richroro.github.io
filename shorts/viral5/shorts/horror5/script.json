{
 "title": ["\\[괴담] 이해하면 소름 돋는", "비상계단"],
 "voices": {"nar": {"edge": "ko-KR-InJoonNeural", "rate": "+5%", "pitch": "-10Hz"}},
 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "엘리베이터 점검 날.| 열두 층을 계단으로 내려갔다.", "cap": ["엘리베이터 / [점검] 날", "[12층]을 / 계단으로"]},
  {"id": "b", "voice": "nar", "gap": 0.3, "say": "비상계단은 센서등이라,| 사람이 지나가야만 불이 켜진다.", "cap": ["비상계단은 / [센서등]", "사람이 지나가야 / [불이] 켜진다"]},
  {"id": "c", "voice": "nar", "gap": 0.4, "say": "그런데 이상했다.| 내가 내려가기도 전에,| 아래층 불이 먼저 켜졌다.", "cap": ["그런데 / 이상했다", "내가 내려가기도 / 전에", "[아래층] 불이 / [먼저] 켜졌다"]},
  {"id": "d", "voice": "nar", "gap": 0.3, "say": "열한 층, 열 층, 아홉 층.| 끝까지 꼭 한 층씩 먼저.", "cap": ["11층, 10층, 9층", "끝까지 / 꼭 [한 층씩] 먼저"]},
  {"id": "e", "voice": "nar", "gap": 0.4, "say": "고장인가 보다 하고,| 일 층 문손잡이를 잡았다.", "cap": ["[고장]인가 보다", "1층 / 문손잡이를 잡았다"]},
  {"id": "f", "voice": "nar", "gap": 0.4, "say": "그때 등 뒤에서 딸깍.| 이 층 불이 켜졌다.", "cap": ["그때 / 등 뒤에서 [딸깍]", "[2층] 불이 / 켜졌다"]},
  {"id": "g", "voice": "nar", "gap": 0.5, "say": "나는 뒤돌아보지 않았다.", "cap": ["나는 / [뒤돌아보지] 않았다"]},
  {"id": "end", "voice": "nar", "gap": 0.6, "say": "이해하셨나요?| 정답은 댓글에.", "cap": ["[이해하셨나요?]", "정답은 [댓글]에"]}
 ],
 "tail": 0.6
}
