  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "강아지가 아빠 퇴근을 알아.",
   "cap": [
    "강아지가 / 아빠 [퇴근]을 알아"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "우리 집 초코는 아빠 오기 딱 십 분 전에 현관에 앉아.",
   "cap": [
    "아빠 오기 [10분 전] / 현관에 딱 앉아"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 이상하게, 엄마가 외출한 날만 틀려.",
   "cap": [
    "근데 엄마가 / [외출한 날]만 틀려"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.1,
   "say": "초코 너 초능력 있어?",
   "cap": [
    "\"초코 너 / [초능력] 있어?\""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 하루는 초코를 하루 종일 지켜봤어.",
   "cap": [
    "그래서 하루 종일 / [초코]를 지켜봤어"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "저녁 일곱 시 오십 분, 엄마 휴대폰이 울렸어.",
   "cap": [
    "저녁 7시 50분 / [엄마 폰]이 울렸어"
   ]
  },
  {
   "id": "g",
   "voice": "dad",
   "gap": 0.1,
   "say": "나 주차장이야. 올라간다.",
   "cap": [
    "\"나 [주차장]이야 / 올라간다\""
   ]
  },
  {
   "id": "h",
   "voice": "mom",
   "gap": 0.1,
   "say": "초코야, 아빠 오신다.",
   "cap": [
    "\"초코야 / [아빠 오신다]~\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 말 듣자마자 초코가 현관으로 달려가.",
   "cap": [
    "그 말 듣자마자 / 초코가 [현관]으로"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "초능력이 아니라, 엄마 말을 외운 거였어.",
   "cap": [
    "초능력이 아니라 / 엄마 말을 [외운] 거야"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 엄마가 장난으로 한번 그 말을 해 봤어.",
   "cap": [
    "엄마가 [장난]으로 / 한번 말해 봤어"
   ]
  },
  {
   "id": "l",
   "voice": "mom",
   "gap": 0.1,
   "say": "초코야, 아빠 오신다.",
   "cap": [
    "\"초코야 / [아빠 오신다]~\""
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "초코는 현관에서 한 시간을 기다렸어.",
   "cap": [
    "초코는 현관에서 / [한 시간]을 기다렸어"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 진짜 아빠가 왔을 때,",
   "cap": [
    "그리고 진짜 / [아빠]가 왔을 때"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "초코는 아빠를 쳐다보지도 않았어.",
   "cap": [
    "초코는 아빠를 / [쳐다보지도] 않았어"
   ]
  },
  {
   "id": "p",
   "voice": "dad",
   "gap": 0.1,
   "say": "초코야, 나 왜 삐졌어?",
   "cap": [
    "\"초코야 / 나 [왜] 삐졌어?\""
   ]
  }
 ]
