 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "강아지 초코는, 아빠 퇴근 십 분 전에 현관에 앉는다.",
   "cap": [
    "강아지 초코는 / 아빠 퇴근 [10분 전]에 / 현관에 앉는다"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.15,
   "say": "가족들은 초코가 초능력견이라고 믿었다.",
   "cap": [
    "가족들은 초코가 / [초능력견]이라고 믿었다"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.15,
   "say": "초코야, 너 아빠 냄새 맡는 거야?",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.2,
   "say": "그러다 어느 날, 엄마가 전화 받는 걸 봤다.",
   "cap": [
    "그러다 어느 날 / 엄마가 [전화] 받는 걸 봤다"
   ]
  },
  {
   "id": "f",
   "voice": "mom",
   "gap": 0.15,
   "say": "응, 주차장이야? 알았어~",
   "cap": [
    ""
   ]
  },
  {
   "id": "g",
   "voice": "mom",
   "gap": 0.1,
   "say": "초코야! 아빠 오신다~",
   "cap": [
    ""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.2,
   "say": "아빠는 매일 주차장에서 엄마한테 전화를 했고,",
   "cap": [
    "아빠는 매일 / [주차장]에서 엄마한테 / 전화를 했고"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.1,
   "say": "초코는 아빠 오신다, 그 한마디를 외운 거였다.",
   "cap": [
    "초코는 / [아빠 오신다] / 그 한마디를 외운 거"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.2,
   "say": "그런데 하루는 엄마가 장난으로 그 말을 했다.",
   "cap": [
    "그런데 하루는 / 엄마가 [장난으로] / 그 말을 했다"
   ]
  },
  {
   "id": "k",
   "voice": "mom",
   "gap": 0.1,
   "say": "초코야! 아빠 오신다~",
   "cap": [
    ""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.15,
   "say": "초코는 꼬리를 흔들며 한 시간을 기다렸고,",
   "cap": [
    "초코는 꼬리를 흔들며 / [한 시간]을 기다렸고"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.2,
   "say": "정작 진짜 온 아빠는, 한 시간 동안 외면당했다.",
   "cap": [
    "정작 진짜 온 아빠는 / 한 시간 동안 [외면]당했다"
