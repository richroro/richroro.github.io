 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "팔월인데 내 자리에 핫팩이 있어.",
   "cap": [
    "8월인데 내 자리에 / [핫팩]이 있어"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "고삼 여름, 독서실 에어컨 바로 밑 자리에서 살았거든.",
   "cap": [
    "고3 여름 / [에어컨 바로 밑] 자리"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 매일 저녁 내 책상에 핫팩이 하나씩 놓여 있는 거야.",
   "cap": [
    "매일 저녁 책상에 / [핫팩] 하나"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.1,
   "say": "누가 장난치나? 한여름에 핫팩을?",
   "cap": [
    "\"한여름에 / [핫팩]을?\""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 하루는 일찍 와서 숨어서 봤어.",
   "cap": [
    "일찍 와서 / [숨어서] 봤어"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "핫팩을 놓고 간 사람은 독서실 사장님이었어.",
   "cap": [
    "놓고 간 사람은 / [사장님]"
   ]
  },
  {
   "id": "g",
   "voice": "me",
   "gap": 0.1,
   "say": "사장님, 이거 왜 주시는 거예요?",
   "cap": [
    "\"사장님, 이거 / [왜] 주시는 거예요?\""
   ]
  },
  {
   "id": "h",
   "voice": "boss",
   "gap": 0.1,
   "say": "너 에어컨 바로 밑이잖아. 맨날 떨더라.",
   "cap": [
    "\"너 [에어컨] 바로 밑이잖아 / 맨날 떨더라\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "생각해 보니 나는 매일 담요를 두르고 공부했어.",
   "cap": [
    "생각해 보니 / 매일 [담요] 두르고 공부"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "자리를 바꾸기엔 거기가 제일 조용했거든.",
   "cap": [
    "자리 바꾸기엔 / 거기가 [제일 조용]해"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "다음 날 갔더니, 그 에어컨에 종이가 붙어 있었어.",
   "cap": [
    "다음 날 그 에어컨에 / [종이]가 붙어 있었어"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "사장님 글씨로, 고장. 딱 두 글자.",
   "cap": [
    "사장님 글씨로 / '[고장]'"
   ]
  },
  {
   "id": "m",
   "voice": "st",
   "gap": 0.1,
   "say": "아 왜 저것만 고장이야, 더워.",
   "cap": [
    "\"왜 저것만 [고장]이야 / 더워\""
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "애들은 덥다고 난리였는데, 사장님은 모른 척하셨어.",
   "cap": [
    "애들은 덥다고 난리 / 사장님은 [모른 척]"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "그해 겨울, 나는 수능을 잘 봤어.",
   "cap": [
    "그해 겨울 / [수능] 잘 봤어"
   ]
  },
  {
   "id": "p",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 그 에어컨은, 지금도 고장이래.",
   "cap": [
    "그 에어컨은 / 지금도 [고장]이래"
   ]
  }
 ]
}