  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "딱 오 분만.",
   "cap": [
    "\"딱 5분만…!\""
   ]
  },
  {
   "id": "a2",
   "voice": "nar",
   "gap": 0.25,
   "say": "주말까지 며칠 남았는지 출근 전부터 셈.",
   "cap": [
    "주말까지 며칠 남았는지 / 출근 전부터 셈"
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "씻다가 그대로 다시 잠들 뻔함.",
   "cap": [
    "씻다가 그대로 / 다시 잠들 뻔함"
   ]
  },
  {
   "id": "a4",
   "voice": "nar",
   "gap": 0.25,
   "say": "지하철에서 서서 졸다가 내릴 역 지나침.",
   "cap": [
    "지하철에서 서서 졸다가 / 내릴 역 지나침"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "헉 여기 어디야?",
   "cap": [
    "\"헉, 여기 어디야?\""
   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "출입 카드 삑 소리가 하루 중 제일 슬픔.",
   "cap": [
    "출입 카드 '삑' 소리가 / 하루 중 제일 슬픔"
   ]
  },
  {
   "id": "a6",
   "voice": "nar",
   "gap": 0.25,
   "say": "커피 마시기 전엔 메일을 읽어도 글자가 안 들어옴.",
   "cap": [
    "커피 전엔 메일을 읽어도 / 글자가 안 들어옴"
   ]
  },
  {
   "id": "a8",
   "voice": "nar",
   "gap": 0.25,
   "say": "엘리베이터 닫힘 버튼 괜히 연타.",
   "cap": [
    "엘리베이터 닫힘 버튼 / 괜히 연타"
   ]
  },
  {
   "id": "a9",
   "voice": "nar",
   "gap": 0.25,
   "say": "퇴근까지 남은 시간 오전에만 열 번 계산.",
   "cap": [
    "퇴근까지 남은 시간 / 오전에만 열 번 계산"
   ]
  },
  {
   "id": "a7",
   "voice": "nar",
   "gap": 0.25,
   "say": "이렇게 버텼는데 아직 오전 열 시.",
