 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "깜빡이도 안 켜고 내 앞으로 훅 들어오는 차.",
   "cap": [
    "깜빡이 없이 / 내 앞으로 [훅]"
   ]
  },
  {
   "id": "b",
   "voice": "me",
   "gap": 0.1,
   "say": "으악! 깜빡이 좀 켜!",
   "cap": [
    ""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "급브레이크를 밟으면 뒤차까지 위험해져요.",
   "cap": [
    "급브레이크에 / 뒤차까지 [위험]"
   ]
  },
  {
   "id": "d",
   "voice": "vil",
   "gap": 0.1,
   "say": "뭐 어때, 들어왔잖아~",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "그렇다고 쫓아가서 똑같이 하면, 그건 보복운전.",
   "cap": [
    "쫓아가서 똑같이? / 그건 [보복운전]"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "법은 이래요. 차로를 바꾸려면 30미터 전부터, 고속도로는 100미터 전부터 깜빡이.",
   "cap": [
    "차로 변경 [30m] 전부터 / 고속도로는 [100m] 전"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.1,
   "say": "그리고 다 옮길 때까지 계속 켜 둬야 해요.",
   "cap": [
    "다 옮길 때까지 / [계속] 켜기"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 빌런, 옆 차로에서 또 훅.",
   "cap": [
    "그 빌런, 또 [훅]"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.1,
   "say": "그런데 하필, 바로 뒤차가.",
   "cap": [
    "그런데 하필 / [바로 뒤차가]"
   ]
  },
  {
   "id": "j",
   "voice": "cop",
   "gap": 0.1,
   "say": "깜빡이 안 켠 차량, 우측에 세우세요.",
   "cap": [
    ""
   ]
  },
  {
   "id": "k",
   "voice": "vil",
   "gap": 0.1,
   "say": "헉, 경찰차였어?",
   "cap": [
    ""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "진로 변경 신호 불이행, 승용차 범칙금 3만 원.",
   "cap": [
    "신호 불이행 / 범칙금 [3만 원]"
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "깜빡이 한 번이면 공짜였는데.| 여러분은 잘 켜시나요?",
   "cap": [
    "깜빡이 한 번이면 [공짜]",
    "여러분은 / [잘 켜시나요]?"
   ]
  }
 ]
