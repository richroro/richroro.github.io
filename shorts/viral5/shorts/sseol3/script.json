 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "비만 오면 내 운동화가 사라져.",
   "cap": [
    "비만 오면 / 내 [운동화]가 사라져"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "현관에 있던 운동화가 감쪽같이 없어지는 거야.",
   "cap": [
    "현관에 있던 운동화가 / [감쪽같이] 없어져"
   ]
  },
  {
   "id": "c",
   "voice": "me",
   "gap": 0.1,
   "say": "할머니, 내 운동화 못 봤어?",
   "cap": [
    "\"할머니, 내 / [운동화] 못 봤어?\""
   ]
  },
  {
   "id": "d",
   "voice": "gma",
   "gap": 0.1,
   "say": "몰라. 할미 무릎이 쑤셔. 장화 신고 가.",
   "cap": [
    "\"몰라. 할미 [무릎] 쑤셔 / 장화 신고 가\""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "노란 장화 신고 학교 가면 어떻게 되는지 알아?",
   "cap": [
    "노란 장화 신고 / [학교] 가면?"
   ]
  },
  {
   "id": "f",
   "voice": "fr",
   "gap": 0.1,
   "say": "야, 너 아기 장화 신었어?",
   "cap": [
    "\"야, 너 / [아기 장화] 신었어?\""
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "그렇게 놀림받은 게 벌써 세 번째야.",
   "cap": [
    "놀림받은 게 / 벌써 [세 번째]"
   ]
  },
  {
   "id": "g2",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 이상한 건, 다음 날 돌아온 운동화가 늘 따끈따끈했다는 거야.",
   "cap": [
    "근데 돌아온 운동화가 / 늘 [따끈따끈]했어"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 비 오는 밤에 몰래 지켜봤거든.",
   "cap": [
    "비 오는 밤 / [몰래] 지켜봤어"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "할머니가 내 운동화를 들고 욕실로 가는 거야.",
   "cap": [
    "할머니가 운동화 들고 / [욕실]로 가더라"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "솔로 박박 빨더니, 전기장판 위에 말리더라.",
   "cap": [
    "솔로 박박 빨고 / [전기장판]에 말려"
   ]
  },
  {
   "id": "k",
   "voice": "gma",
   "gap": 0.1,
   "say": "젖은 신발 신으면 발 썩어.",
   "cap": [
    "\"젖은 신발 신으면 / [발 썩어]\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "젖어서 온 내 운동화가 계속 신경 쓰였던 거지.",
   "cap": [
    "젖어 온 운동화가 / [신경] 쓰였던 거야"
   ]
  },
  {
   "id": "m",
   "voice": "me",
   "gap": 0.1,
   "say": "할머니, 그냥 말하지 그랬어.",
   "cap": [
    "\"할머니, 그냥 / [말하지] 그랬어\""
   ]
  },
  {
   "id": "n",
   "voice": "gma",
   "gap": 0.1,
   "say": "말하면 니가 장화를 안 신잖아.",
   "cap": [
    "\"말하면 니가 / 장화 [안 신잖아]\""
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 문제는, 할머니가 일기예보보다 무릎을 믿는다는 거야.",
   "cap": [
    "문제는 할머니가 / 예보보다 [무릎]을 믿어"
   ]
  },
  {
   "id": "p",
   "voice": "nar",
   "gap": 0.12,
   "say": "오늘도 쨍쨍한데, 무릎이 비 온대서 장화 신고 간다.",
   "cap": [
    "오늘도 쨍쨍한데 / 무릎 예보로 [장화] 신고 간다"
   ]
  }
 ]
