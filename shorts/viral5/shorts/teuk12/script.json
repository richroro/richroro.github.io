  {
   "id": "a1",
   "voice": "nar",
   "gap": 0.05,
   "say": "고기 굽는 사람은",
   "cap": [
    "고기 굽는 사람은"
   ]
  },
  {
   "id": "a1b",
   "voice": "nar",
   "gap": 0.25,
   "say": "정작 한 점도 못 먹음.",
   "cap": [
    "정작 한 점도 못 먹음"
   ]
  },
  {
   "id": "a2",
   "voice": "nar",
   "gap": 0.25,
   "say": "다 익었냐고 물으면 대답은 늘 조금만 더.",
   "cap": [
    "다 익었냐고 물으면 / 대답은 늘 '조금만 더'"
   ]
  },
  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "이제 먹어도 돼?",
   "cap": [
    "\"이제 먹어도 돼?\""
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "쌈 싸 먹다가 입보다 쌈이 더 커짐.",
   "cap": [
    "쌈 싸 먹다가 / 입보다 쌈이 더 커짐"
   ]
  },
  {
   "id": "a4",
   "voice": "nar",
   "gap": 0.25,
   "say": "김치를 불판에 올리면 그때부터 진짜 시작.",
   "cap": [
    "김치를 불판에 올리면 / 그때부터 진짜 시작"
   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "옷에 밴 고기 냄새는 집에 가서야 앎.",
   "cap": [
    "옷에 밴 고기 냄새는 / 집에 가서야 앎"
   ]
  },
  {
   "id": "a6",
   "voice": "nar",
   "gap": 0.25,
   "say": "배부르다면서 볶음밥은 꼭 시킴.",
   "cap": [
    "배부르다면서 / 볶음밥은 꼭 시킴"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "볶음밥 배는 따로 있어.",
   "cap": [
    "\"볶음밥 배는 따로 있어\""
   ]
  },
  {
   "id": "a8",
   "voice": "nar",
   "gap": 0.25,
   "say": "고기 냄새 맡으면 배불러도 또 배고파짐.",
   "cap": [
    "고기 냄새 맡으면 / 배불러도 또 배고픔"
   ]
  },
  {
   "id": "a9",
   "voice": "nar",
   "gap": 0.25,
   "say": "쌈장 하나로 밥 한 공기 뚝딱.",
   "cap": [
    "쌈장 하나로 / 밥 한 공기 뚝딱"
   ]
  },
  {
   "id": "a7",
   "voice": "nar",
   "gap": 0.25,
   "say": "마지막 한 점은 아무도 손 안 댐.",
   "cap": [
    "마지막 한 점은 / 아무도 손 안 댐"
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.25,
   "say": "여러분은 몇 개 해당?",
   "cap": [
