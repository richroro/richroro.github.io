 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "새벽 세 시 편의점. 문이 딸랑.",
   "cap": [
    "새벽 [3시] 편의점 / 문이 딸랑"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "매일 같은 시간에 오는 손님이 있음.",
   "cap": [
    "매일 [같은 시간]에 / 오는 손님"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "컵라면 하나, 삼각김밥 하나. 늘 똑같음.",
   "cap": [
    "컵라면 하나, 삼각김밥 하나 / 늘 [똑같음]"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "말 한마디 없이 먹고 감. 솔직히 좀 무서움.",
   "cap": [
    "말없이 먹고 감 / 솔직히 {좀 무서움}"
   ]
  },
  {
   "id": "e",
   "voice": "me",
   "gap": 0.08,
   "say": "혹시 수상한 사람인가?",
   "cap": [
    ""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "그러다 비가 엄청 오던 날 새벽.",
   "cap": [
    "비가 [엄청] 오던 / 날 새벽"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 손님이 들어오자마자 계산대로 직진.",
   "cap": [
    "들어오자마자 / 계산대로 [직진]"
   ]
  },
  {
   "id": "h",
   "voice": "me",
   "gap": 0.08,
   "say": "뭐, 뭐 찾으세요?",
   "cap": [
    ""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "내민 건 따뜻한 캔커피 하나.",
   "cap": [
    "내민 건 / 따뜻한 [캔커피] 하나"
   ]
  },
  {
   "id": "j",
   "voice": "guest",
   "gap": 0.08,
   "say": "매일 고생 많아요. 이건 학생 거.",
   "cap": [
    ""
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "알고 보니 야간 근무 마치고 오는 길이었음.",
   "cap": [
    "알고 보니 / [야간 근무] 퇴근길"
   ]
  },
  {
   "id": "k2",
   "voice": "nar",
   "gap": 0.12,
   "say": "그날 이후, 그 손님 오면 내가 먼저 인사함.",
   "cap": [
    "그날 이후 / 내가 [먼저] 인사함"
   ]
  },
  {
   "id": "l",
   "voice": "me",
   "gap": 0.08,
   "say": "오늘도 수고하셨어요!",
   "cap": [
    ""
   ]
  },
  {
   "id": "z",
   "voice": "nar",
   "gap": 0.15,
   "say": "님은 새벽에 이런 손님 만나 봄?",
   "cap": [
    "님은 이런 손님 / [만나 봄]?"
   ]
  }
 ]
