 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "새벽 세 시,| 현관에서 소리가 났다.", "cap": ["새벽 [세 시]", "현관에서 / 소리가 났다"]},
  {"id": "b", "voice": "nar", "gap": 0.3, "say": "삑, 삑, 삑, 삑.| 띠리릭.", "cap": ["삑, 삑, 삑, 삑", "[띠리릭]"]},
  {"id": "c", "voice": "nar", "gap": 0.3, "say": "도어락이 열리는 소리였다.| 비밀번호는 나만 안다.", "cap": ["[도어락]이 / 열리는 소리", "비밀번호는 / [나만] 안다"]},
  {"id": "d", "voice": "nar", "gap": 0.4, "say": "잠시 뒤,| 띠리릭.| 다시 잠기는 소리.", "cap": ["잠시 뒤", "[띠리릭]", "다시 [잠기는] 소리"]},
  {"id": "e", "voice": "nar", "gap": 0.3, "say": "무서워서 아침까지| 이불 밖으로 나가지 못했다.", "cap": ["무서워서 / 아침까지", "이불 밖으로 / 못 나갔다"]},
  {"id": "f", "voice": "nar", "gap": 0.4, "say": "아침에 현관을 확인했다.| 모든 게 그대로였다.", "cap": ["아침에 / 현관을 확인했다", "모든 게 / [그대로]였다"]},
  {"id": "g", "voice": "nar", "gap": 0.4, "say": "어젯밤보다,| 신발이 한 켤레 더 많다는 것만 빼면.", "cap": ["어젯밤보다", "[신발]이 / 한 켤레 [더]"]},
  {"id": "h", "voice": "nar", "gap": 0.5, "say": "나는 혼자 산다.", "cap": ["나는 [혼자] 산다"]},
  {"id": "end", "voice": "nar", "gap": 0.6, "say": "이해하셨나요?| 정답은 댓글에.", "cap": ["[이해하셨나요?]", "정답은 [댓글]에"]}
