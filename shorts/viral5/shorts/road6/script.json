 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "앞이 꽉 막혔는데, 교차로로 밀고 들어가는 차.",
   "cap": [
    "앞이 꽉 막혔는데 / 교차로로 [밀고 들어가는 차]"
   ]
  },
  {
   "id": "b",
   "voice": "vil",
   "gap": 0.1,
   "say": "앞차만 따라가면 되지~",
   "cap": [
    ""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "결국 신호가 바뀌고, 교차로 한가운데 딱 멈췄어요.",
   "cap": [
    "신호가 바뀌고 / 교차로 [한가운데]"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.1,
   "say": "아니, 우리 신호인데 못 가잖아!",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "옆 길 차들까지 줄줄이 멈추는, 이게 꼬리물기.",
   "cap": [
    "옆 길까지 멈추는 / [꼬리물기]"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "법은 이래요.| 교차로 안에 멈추게 될 것 같으면,| 초록불이어도 들어가면 안 돼요.",
   "cap": [
    "법은 이래요",
    "교차로 안에 / [멈출 것 같으면]",
    "[초록불]이어도 / 진입 금지"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "정답은, 정지선 앞에서 한 번 기다리기.",
   "cap": [
    "정답은 / [정지선] 앞에서 대기"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 빌런, 교차로를 빠져나가자마자.",
   "cap": [
    "그 빌런, / 빠져나가자마자"
   ]
  },
  {
   "id": "i",
   "voice": "cop",
   "gap": 0.1,
   "say": "교차로 막으셨죠? 우측에 세우세요.",
   "cap": [
    ""
   ]
  },
  {
   "id": "j",
   "voice": "vil",
   "gap": 0.1,
   "say": "앞차 따라간 것뿐인데…",
   "cap": [
    ""
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "교차로 통행방법 위반, 승용차 범칙금 4만 원.",
   "cap": [
    "교차로 통행방법 위반 / 범칙금 [4만 원]"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "막히면 정지선에서 한 번 기다리기.| 여러분 동네에도 꼬리물기 많죠?",
   "cap": [
    "막히면 [정지선]에서 대기",
    "여러분 동네에도 / [꼬리물기] 많죠?"
   ]
  }
 ]
