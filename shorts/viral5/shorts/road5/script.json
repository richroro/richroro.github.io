  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "터널 안 실선인데, 차선을 이리저리 바꾸는 차.",
   "cap": [
    "터널 안 [실선]인데 / 차선을 [이리저리]"
   ]
  },
  {
   "id": "b",
   "voice": "vil",
   "gap": 0.1,
   "say": "실선? 그냥 선이잖아~",
   "cap": [
    ""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "터널은 어둡고 좁아서, 갑자기 끼어들면 피할 곳이 없어요.",
   "cap": [
    "어둡고 좁은 터널 / 피할 곳이 [없어요]"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.1,
   "say": "깜짝이야! 실선이잖아!",
   "cap": [
    ""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "화난다고 경적을 계속 울리면, 그것도 위반이에요.",
   "cap": [
    "경적 [계속] 울리면 / 그것도 [위반]"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "법은 이래요.| 흰색 실선에선 차로를 바꾸면 안 돼요.",
   "cap": [
    "법은 이래요",
    "[흰색 실선]에선 / 차로 변경 금지"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "그리고 터널 안에선 앞지르기도 금지예요.",
   "cap": [
    "터널 안은 / [앞지르기]도 금지"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 빌런, 터널 끝에서 또 휙.",
   "cap": [
    "그 빌런, / 또 [휙]"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "그런데 하필, 바로 옆 차로에.",
   "cap": [
    "그런데 하필 / [바로 옆]에"
   ]
  },
  {
   "id": "j",
   "voice": "cop",
   "gap": 0.1,
   "say": "실선에서 차로 바꾸셨죠? 앞에 세우세요.",
   "cap": [
    ""
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "진로 변경 금지 위반, 승용차 범칙금 3만 원.",
   "cap": [
    "진로 변경 금지 위반 / 범칙금 [3만 원]"
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "터널에선 내 차로 그대로.| 여러분은 잘 지키시나요?",
   "cap": [
    "터널에선 [내 차로] 그대로",
    "여러분은 / [잘 지키시나요]?"
   ]
  }
 ]
