 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "반장이 백 일째 쪽지를 줘.",
   "cap": [
    "반장이 100일째 / [쪽지]를 줘"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "아침마다 접힌 쪽지가 하나씩 있는 거야.",
   "cap": [
    "아침마다 / 접힌 쪽지 [하나]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "물 많이 마셔, 우산 챙겨, 밥 꼭 먹어.",
   "cap": [
    "'물 많이 마셔' / '우산 챙겨' / '밥 꼭 먹어'"
   ]
  },
  {
   "id": "d",
   "voice": "me",
   "gap": 0.1,
   "say": "이거 완전 나 좋아하는 거 아냐?",
   "cap": [
    "\"이거 완전 / [나 좋아하는] 거 아냐?\""
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "짝꿍도 옆에서 백 퍼센트라고 난리였어.",
   "cap": [
    "짝꿍도 옆에서 / [100%]라고 난리"
   ]
  },
  {
   "id": "f",
   "voice": "fr",
   "gap": 0.1,
   "say": "야, 이건 고백이야 고백.",
   "cap": [
    "\"야, 이건 [고백]이야\""
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 밤새 고민하다가 답장을 썼어.",
   "cap": [
    "밤새 고민하다가 / [답장]을 썼어"
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "나도 너 좋아. 이렇게 딱 한 줄.",
   "cap": [
    "'나도 너 좋아' / [딱 한 줄]"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "다음 날 반장 책상에 몰래 넣어 놨지.",
   "cap": [
    "반장 책상에 / [몰래] 넣어 놨지"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 그날 저녁에 엄마가 날 부르는 거야.",
   "cap": [
    "그날 저녁 / [엄마]가 날 불렀어"
   ]
  },
  {
   "id": "k",
   "voice": "mom",
   "gap": 0.1,
   "say": "너 반장한테 이런 거 썼니?",
   "cap": [
    "\"너 반장한테 / [이런 거] 썼니?\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "엄마 손에 내 답장이 들려 있더라.",
   "cap": [
    "엄마 손에 / [내 답장]이..."
   ]
  },
  {
   "id": "m",
   "voice": "nar",
   "gap": 0.12,
   "say": "알고 보니 반장은 엄마 친구 아들이었고,",
   "cap": [
    "알고 보니 반장은 / [엄마 친구 아들]"
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 쪽지는 전부 엄마가 부탁한 잔소리였어.",
   "cap": [
    "쪽지는 전부 / 엄마의 [잔소리]"
   ]
  },
  {
   "id": "o",
   "voice": "mom",
   "gap": 0.1,
   "say": "답장은 엄마가 잘 받았다.",
   "cap": [
    "\"답장은 / [엄마가] 잘 받았다\""
   ]
  },
  {
   "id": "p",
   "voice": "me",
   "gap": 0.1,
   "say": "아 진짜 이사 가고 싶다.",
   "cap": [
    "\"아 진짜 / [이사] 가고 싶다\""
   ]
  }
 ]
