   "id": "a0",
   "voice": "back",
   "gap": 0.0,
   "say": "저기요, 제 무릎이요!",
   "cap": [
    "\"저기요, 제 무릎이요!\""
   ]
  },
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.08,
   "say": "기차 의자 끝까지 젖혔다가 들은 말.",
   "cap": [
    "의자 끝까지 젖혔다가 [들은 말]"
   ]
  },
  {
   "id": "b",
   "voice": "me",
   "gap": 0.06,
   "say": "저도 표 값 다 냈는데요?",
   "cap": [
    "\"저도 표 값 다 냈는데요?\""
   ]
  },
  {
   "id": "c",
   "voice": "back",
   "gap": 0.06,
   "say": "도시락 먹고 있었단 말이에요.",
   "cap": [
    "\"도시락 먹고 있었단 말이에요\""
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.08,
   "say": "젖히는 쪽은 의자에 있는 기능이니까 내 권리라는 쪽.",
   "cap": [
    "젖히는 쪽 의자 기능 = [권리]"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.08,
   "say": "뒷사람은 끝까지 오면 도시락도 노트북도 못 편다는 쪽.",
   "cap": [
    "뒷사람 도시락도 [못 폄]"
   ]
  },
  {
   "id": "f",
   "voice": "back",
   "gap": 0.06,
   "say": "좋아요, 그럼 저도 젖힐게요.",
   "cap": [
    "\"좋아요. 그럼 저도 젖힐게요\""
   ]
  },
  {
   "id": "f2",
   "voice": "me",
   "gap": 0.06,
   "say": "네? 그건 좀…",
   "cap": [
    "\"네? 그건 좀…\""
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.08,
   "say": "뒷사람도 끝까지 젖힘.",
