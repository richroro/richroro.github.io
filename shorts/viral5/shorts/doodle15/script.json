   ]
  },
  {
   "id": "h",
   "voice": "back2",
   "gap": 0.06,
   "say": "저기요, 제 커피요!",
   "cap": [
    "\"저기요, 제 커피요!\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.08,
   "say": "그 뒷사람도 끝까지 젖힘.",
   "cap": [
    "그 뒷사람도 [끝까지] 젖힘"
