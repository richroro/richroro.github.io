{
 "credit": "",
 "layout": "card",
 "card": {
  "items": [
   {
    "at": 0.0,
    "ko": "21살 대학원생이 받은 진단",
    "en": "스티븐 호킹"
   },
   {
    "at": 3.2,
    "ko": "근육이 점점 힘을 잃는 병, 루게릭병",
    "panel": {
     "big": "2년",
     "small": "의사가 말한 남은 시간",
     "bg": "#2b2d42",
     "fg": "#ffffff"
    }
   },
   {
    "at": 6.2,
    "ko": "그래도 우주 연구를 멈추지 않았다"
   },
   {
    "at": 9.2,
    "ko": "폐렴으로 목소리마저 잃었지만",
    "panel": {
     "big": "43살",
     "small": "수술로 목소리를 잃었다",
     "bg": "#FFD6C9"
    }
   },
   {
    "at": 12.2,
    "ko": "컴퓨터 목소리로 세상과 말했다",
    "panel": {
     "big": "2,000만 부",
     "small": "그가 쓴 책 '시간의 역사'",
     "bg": "#FFE8A3"
    }
   },
   {
    "at": 15.2,
    "ko": "그리고 아주 오래 살았다",
    "panel": {
     "big": "55년 더",
     "small": "2년이라던 그는 76살까지 살았다",
     "bg": "#D9F2D0"
    }
   },
   {
    "at": 18.2,
    "ko": "73살, 블랙홀 강연에서",
    "en": "스웨덴 스톡홀름"
   },
   {
    "at": 21.2,
    "ko": "어려운 물리 이야기 끝에",
    "panel": {
     "big": "블랙홀의\n비밀",
     "bg": "#0b1026",
     "fg": "#ffffff",
     "doodle": "stars"
    }
   },
   {
    "at": 24.2,
    "ko": "그가 사람들에게 건넨 말",
    "quote": {
     "ko": "블랙홀에 빠진 것 같아도/포기하지 마세요./빠져나갈 길은 있습니다.",
     "orig": "If you feel you are in a black hole, don't give up. There's a way out.",
     "who": "스티븐 호킹, 스톡홀름 강연"
    }
   },
   {
    "at": 28.6,
    "ko": "2년을 선고받았던 사람의 말"
   }
  ],
