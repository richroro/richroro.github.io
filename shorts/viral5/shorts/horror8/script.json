 "lines": [
  {"id": "a", "voice": "nar", "gap": 0.05, "say": "혼자 캠핑을 갔다.| 밤새 비가 내렸다.", "cap": ["[혼자] 캠핑", "밤새 / [비]가 내렸다"]},
  {"id": "b", "voice": "nar", "gap": 0.3, "say": "새벽에 텐트 밖에서,| 철벅, 철벅, 발소리가 났다.", "cap": ["새벽 / 텐트 밖에서", "[철벅, 철벅] / 발소리"]},
  {"id": "c", "voice": "nar", "gap": 0.3, "say": "발소리는 텐트 주위를| 천천히 한 바퀴 돌았다.", "cap": ["텐트 주위를", "천천히 / [한 바퀴]"]},
  {"id": "d", "voice": "nar", "gap": 0.4, "say": "나는 침낭 속에서| 숨죽인 채 아침을 기다렸다.", "cap": ["침낭 속에서 / [숨죽인] 채", "아침을 기다렸다"]},
  {"id": "e", "voice": "nar", "gap": 0.4, "say": "아침에 나가 보니,| 젖은 흙 위에 발자국이 남아 있었다.", "cap": ["아침에 나가 보니", "젖은 흙 위에 / [발자국]"]},
  {"id": "f", "voice": "nar", "gap": 0.4, "say": "텐트 입구에서 나와서,| 한 바퀴 돌고,| 다시 입구로 들어간 발자국.", "cap": ["텐트 [입구]에서 / 나와서", "한 바퀴 돌고", "다시 [입구로] / 들어간 발자국"]},
  {"id": "g", "voice": "nar", "gap": 0.5, "say": "나는 밤새| 텐트 밖으로 나간 적이 없다.", "cap": ["나는 밤새", "텐트 밖으로 / [나간 적이 없다]"]}
  ,{"id": "end", "voice": "nar", "gap": 0.6, "say": "이해하셨나요?| 정답은 댓글에.", "cap": ["[이해하셨나요?]", "정답은 [댓글]에"]}
