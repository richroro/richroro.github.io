   ]
  },
  {
   "id": "a2",
   "voice": "nar",
   "gap": 0.25,
   "say": "우산 없는 날만 골라서 갑자기 소나기.",
   "cap": [
    "우산 없는 날만 골라서 / 갑자기 소나기"
   ]
  },
  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "아니 왜 지금?",
   "cap": [
    "\"아니, 왜 지금?!\""
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "집에 우산 많은데 또 하나 삼.",
   "cap": [
    "집에 우산 많은데 / 또 하나 삼"
   ]
  },
  {
   "id": "a4",
   "voice": "nar",
   "gap": 0.25,
   "say": "양말 젖으면 하루 종일 찝찝함.",
   "cap": [
    "양말 젖으면 / 하루 종일 찝찝"
   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "비만 오면 괜히 파전 생각남.",
   "cap": [
    "비만 오면 괜히 / 파전 생각남"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "파전 먹으러 갈 사람?",
   "cap": [
    "\"파전 먹으러 갈 사람?\""
   ]
  },
  {
   "id": "a6",
   "voice": "nar",
   "gap": 0.25,
   "say": "빗소리 들으면 잠이 쏟아짐.",
   "cap": [
    "빗소리 들으면 / 잠이 쏟아짐"
   ]
  },
  {
   "id": "a8",
   "voice": "nar",
   "gap": 0.25,
   "say": "우산 쓰고 걸어도 가방은 꼭 젖음.",
   "cap": [
    "우산 쓰고 걸어도 / 가방은 꼭 젖음"
   ]
  },
  {
   "id": "a9",
   "voice": "nar",
   "gap": 0.25,
   "say": "비 오는 날 버스는 꼭 더 늦게 오는 느낌.",
   "cap": [
