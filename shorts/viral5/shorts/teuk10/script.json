   ]
  },
  {
   "id": "a1b",
   "voice": "nar",
   "gap": 0.25,
   "say": "그 선이 안 보임.",
   "cap": [
    "그 선이 안 보임"
   ]
  },
  {
   "id": "a2",
   "voice": "nar",
   "gap": 0.25,
   "say": "삼 분 기다리라는데 일 분째 젓가락 들고 대기.",
   "cap": [
    "3분 기다리라는데 / 1분째 젓가락 들고 대기"
   ]
  },
  {
   "id": "c1",
   "voice": "me",
   "gap": 0.08,
   "say": "꼬들꼬들해야 맛있지.",
   "cap": [
    "\"꼬들꼬들해야 맛있지\""
   ]
  },
  {
   "id": "a3",
   "voice": "nar",
   "gap": 0.25,
   "say": "밤 열한 시 컵라면, 붓기는 내일의 나에게 맡김.",
   "cap": [
