   ]
  },
  {
   "id": "a4",
   "voice": "nar",
   "gap": 0.25,
   "say": "뚜껑 접어서 앞접시로 쓰는 건 국룰.",
   "cap": [
    "뚜껑 접어서 / 앞접시로 쓰는 건 국룰"
   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "국물은 안 마신다더니 결국 바닥까지 원샷.",
   "cap": [
    "국물은 안 마신다더니 / 결국 바닥까지 원샷"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "아 짜다. 물 물.",
   "cap": [
    "\"아 짜다… 물 물\""
   ]
  },
  {
   "id": "a6",
   "voice": "nar",
   "gap": 0.25,
   "say": "고르는 데 이십 분, 먹는 데 삼 분.",
   "cap": [
    "고르는 데 20분 / 먹는 데 3분"
   ]
  },
  {
   "id": "a8",
   "voice": "nar",
   "gap": 0.25,
   "say": "나무젓가락은 꼭 삐뚤게 쪼개짐.",
   "cap": [
    "나무젓가락은 / 꼭 삐뚤게 쪼개짐"
   ]
  },
  {
   "id": "a9",
   "voice": "nar",
   "gap": 0.25,
   "say": "뜨거운 물 부으면 안경에 김이 서림.",
   "cap": [
    "뜨거운 물 부으면 / 안경에 김 서림"
   ]
  },
  {
   "id": "a7",
   "voice": "nar",
   "gap": 0.25,
   "say": "다음엔 다른 맛 먹자 해 놓고 또 같은 맛 집어 듦.",
