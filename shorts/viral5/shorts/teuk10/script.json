   ]
  },
  {
   "id": "a5",
   "voice": "nar",
   "gap": 0.25,
   "say": "국물은 안 마신다더니 결국 바닥까지 원샷.",
   "cap": [
    "국물은 안 마신다더니 / 결국 바닥까지 원샷"
   ]
  },
  {
   "id": "c2",
   "voice": "me",
   "gap": 0.08,
   "say": "아 짜다. 물 물.",
