   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.1,
   "say": "그다음엔 빗속을 걷는 고양이.",
   "cap": [
    "그다음엔 / [빗속]을 걷는 고양이"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.15,
   "say": "그림이 만화처럼 이어지더라.",
   "cap": [
