  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "카페 컵에 내 만화가 연재돼.",
   "cap": [
    "카페 컵에 / [내 만화]가 연재돼"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "비 오는 날 노란 우산 쓰고 가는 단골 카페인데, 내 컵에만 그림을 그려 줘.",
   "cap": [
    "단골 카페 사장님이 / 내 컵에만 [그림]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "첫날은 노란 우산 쓴 고양이 한 마리.",
   "cap": [
    "첫날은 / [노란 우산] 쓴 고양이"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "다음엔 그 고양이가 버스를 타고, 그다음엔 비에 홀딱 젖어 있어.",
   "cap": [
    "다음엔 [버스] 타고 / 그다음엔 비에 젖고"
   ]
  },
  {
   "id": "e",
   "voice": "me",
   "gap": 0.1,
   "say": "이거 무슨 만화지, 다음 화 궁금하네.",
   "cap": [
    "\"이거 무슨 만화지? / [다음 화] 궁금하네\""
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 이상한 게, 그림은 비 오는 날에만 그려 주시는 거야.",
   "cap": [
    "근데 그림은 / [비 오는 날]만 그려"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 사장님한테 대놓고 물어봤어.",
   "cap": [
    "그래서 사장님한테 / [대놓고] 물어봤어"
   ]
  },
  {
   "id": "h",
   "voice": "me",
   "gap": 0.1,
   "say": "사장님, 이 고양이 누구예요?",
   "cap": [
    "\"사장님, 이 고양이 / [누구]예요?\""
   ]
  },
  {
   "id": "i",
   "voice": "boss",
   "gap": 0.1,
   "say": "손님이요, 비 오는 날만 노란 우산 쓰고 오시잖아요.",
   "cap": [
    "\"손님이요 / [노란 우산] 쓰고 오시잖아요\""
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "생각해 보니 나는 비 올 때만 그 카페에 갔어.",
   "cap": [
    "생각해 보니 / 나는 [비 올 때]만 갔어"
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "버스 놓친 날, 비 맞고 온 날까지 다 기억하신 거야.",
   "cap": [
    "버스 놓친 날까지 / [다 기억]하신 거야"
   ]
  },
  {
   "id": "l",
   "voice": "me",
   "gap": 0.1,
   "say": "그럼 맑은 날은요?",
   "cap": [
    "\"그럼 / [맑은 날]은요?\""
   ]
  },
  {
   "id": "m",
   "voice": "boss",
   "gap": 0.1,
   "say": "맑은 날엔 안 오시잖아요.",
   "cap": [
    "\"맑은 날엔 / [안 오시잖아요]\""
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "그 뒤로는 맑은 날에도 가.",
   "cap": [
    "그 뒤로는 / [맑은 날]에도 가"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "오늘 받은 컵에는, 고양이가 도장판을 들고 있었어.",
   "cap": [
    "오늘 컵엔 고양이가 / [도장판]을 들고 있어"
   ]
  },
  {
   "id": "p",
   "voice": "nar",
   "gap": 0.12,
   "say": "도장 열 개, 꽉 채워서.",
   "cap": [
    "도장 [10개] / 꽉 채워서"
   ]
  }
 ]
