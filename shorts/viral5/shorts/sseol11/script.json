  },
  {
   "id": "g",
   "voice": "boss",
   "gap": 0.2,
   "say": "손님이요.",
   "cap": [
    ""
   ]
  },
  {
   "id": "g2",
   "voice": "boss",
   "gap": 0.1,
   "say": "비 오는 날만, 노란 우산 쓰고 오시잖아요.",
   "cap": [
    ""
