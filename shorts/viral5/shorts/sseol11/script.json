  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "단골 카페 사장님은, 내 컵에만 그림을 그려 준다.",
   "cap": [
    "단골 카페 사장님은 / [내 컵에만] / 그림을 그려 준다"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.2,
   "say": "처음엔 고양이 한 마리.",
   "cap": [
    "처음엔 [고양이] 한 마리"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.1,
   "say": "다음엔 노란 우산을 쓴 고양이.",
