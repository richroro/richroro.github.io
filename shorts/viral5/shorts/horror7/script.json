{
 "title": [
  "\\[괴담] 이해하면 소름 돋는",
  "홈캠"
 ],
 "voices": {
  "nar": {
   "edge": "ko-KR-InJoonNeural",
   "rate": "+5%",
   "pitch": "-10Hz"
  }
 },
 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "혼자 사는 집에| 홈캠을 하나 달았다.",
   "cap": [
    "[혼자] 사는 집에",
    "[홈캠]을 달았다"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.3,
   "say": "렌즈는 현관을 향하게.| 누가 들어오면 바로 알 수 있게.",
   "cap": [
    "렌즈는 / [현관]을 향하게",
    "누가 들어오면 / 바로 알 수 있게"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.3,
   "say": "며칠 동안 찍힌 건,| 출퇴근하는 나뿐이었다.",
   "cap": [
    "며칠 동안 / 찍힌 건",
    "출퇴근하는 / [나뿐]이었다"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.4,
   "say": "오늘 아침,| 어젯밤 영상을 돌려 봤다.",
   "cap": [
    "오늘 아침",
    "[어젯밤] 영상을 / 돌려 봤다"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.3,
   "say": "새벽 두 시부터 네 시까지,| 자고 있는 내가 찍혀 있었다.",
   "cap": [
    "새벽 [2시]부터 / [4시]까지",
    "[자고 있는] 내가 / 찍혀 있었다"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.4,
   "say": "침대 바로 옆에서,| 나를 내려다보는 각도로.",
   "cap": [
    "침대 / [바로 옆]에서",
    "나를 / [내려다보는] 각도로"
   ]
  },
  {
   "id": "f2",
   "voice": "nar",
   "gap": 0.4,
   "say": "그날 밤 현관문은| 한 번도 열리지 않았다.",
   "cap": [
    "그날 밤 현관문은",
    "[한 번도] / 열리지 않았다"
   ]
  },
  {
   "id": "g",
   "voice": "nar",
   "gap": 0.5,
   "say": "홈캠은 지금도| 현관을 보고 있다.",
   "cap": [
    "홈캠은 지금도",
    "[현관]을 보고 있다"
   ]
  },
  {
   "id": "end",
   "voice": "nar",
   "gap": 0.6,
   "say": "이해하셨나요?| 정답은 댓글에.",
   "cap": [
    "[이해하셨나요?]",
    "정답은 [댓글]에"
   ]
  }
 ],
 "tail": 0.6
