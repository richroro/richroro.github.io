  {
   "id": "b",
   "voice": "mom",
   "gap": 0.08,
   "say": "냉장고에 있잖아!",
   "cap": [
    ""
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "열어 봄. 없음.",
   "cap": [
    "열어 봄 / {없음}"
   ]
  },
  {
   "id": "c2",
   "voice": "nar",
   "gap": 0.12,
   "say": "야채 칸, 냉동실, 문 칸까지 다 열어 봄.",
   "cap": [
    "야채 칸, 냉동실 / [문 칸]까지 다 봄"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "반찬통 탑을 하나씩 해체함.",
   "cap": [
    "반찬통 [탑]을 / 하나씩 해체"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "뒤에, 그 뒤에, 또 그 뒤까지 수색.",
   "cap": [
    "뒤에 뒤에 / [또 뒤]까지 수색"
   ]
  },
  {
   "id": "e2",
   "voice": "nar",
   "gap": 0.12,
   "say": "십 분째 냉장고 문 열고 서 있음.",
   "cap": [
    "[10분]째 / 문 열고 서 있음"
   ]
  },
  {
   "id": "m",
   "voice": "mom",
   "gap": 0.08,
   "say": "문 좀 닫아! 냉기 다 나가!",
   "cap": [
    ""
   ]
  },
  {
   "id": "f",
   "voice": "me",
   "gap": 0.08,
   "say": "엄마, 진짜 없는데?",
   "cap": [
    ""
   ]
  },
  {
   "id": "g",
   "voice": "mom",
   "gap": 0.08,
   "say": "눈은 장식이니?",
   "cap": [
    ""
   ]
  },
  {
   "id": "h",
   "voice": "nar",
   "gap": 0.12,
   "say": "엄마 등장. 문 열고 일 초 만에 꺼냄.",
   "cap": [
    "엄마 등장 / [1초] 만에 꺼냄"
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "심지어 맨 앞 칸에 있었음.",
   "cap": [
    "심지어 / {맨 앞 칸}에 있었음"
   ]
  },
  {
   "id": "j",
   "voice": "me",
   "gap": 0.08,
   "say": "아까는 진짜 없었다니까?",
   "cap": [
    ""
   ]
  },
  {
   "id": "k",
   "voice": "nar",
   "gap": 0.12,
   "say": "냉장고는 엄마 손에만 반응하는 듯.",
   "cap": [
