 "lines": [
  {
   "id": "a",
   "voice": "nar",
   "gap": 0.05,
   "say": "조카가 나보다 세 살 많아.",
   "cap": [
    "조카가 나보다 / [3살] 많아"
   ]
  },
  {
   "id": "b",
   "voice": "nar",
   "gap": 0.12,
   "say": "우리 집 족보는 좀 꼬였어.",
   "cap": [
    "우리 집 족보는 / 좀 [꼬였어]"
   ]
  },
  {
   "id": "c",
   "voice": "nar",
   "gap": 0.12,
   "say": "큰누나랑 나는 스물다섯 살 차이거든.",
   "cap": [
    "큰누나랑 나는 / [25살] 차이"
   ]
  },
  {
   "id": "d",
   "voice": "nar",
   "gap": 0.12,
   "say": "누나가 아들 낳고 삼 년 뒤에, 엄마가 나를 낳았어.",
   "cap": [
    "누나가 아들 낳고 / [3년 뒤] 내가 태어났어"
   ]
  },
  {
   "id": "e",
   "voice": "nar",
   "gap": 0.12,
   "say": "그래서 나보다 형인 조카가 생긴 거야.",
   "cap": [
    "그래서 나보다 / [형인 조카]"
   ]
  },
  {
   "id": "f",
   "voice": "nar",
   "gap": 0.12,
   "say": "문제는 걔랑 같은 학교를 다닌다는 거야.",
   "cap": [
    "문제는 / [같은 학교]"
   ]
  },
  {
   "id": "g",
   "voice": "nep",
   "gap": 0.1,
   "say": "야, 일 학년, 매점 가서 빵 사 와.",
   "cap": [
    "\"야, 1학년 / [빵] 사 와\""
   ]
  },
  {
   "id": "h",
   "voice": "me",
   "gap": 0.1,
   "say": "삼촌한테 말버릇이 그게 뭐야?",
   "cap": [
    "\"[삼촌]한테 / 말버릇이 그게 뭐야?\""
   ]
  },
  {
   "id": "i",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 사 온 빵은 꼭 반 갈라서 나한테 줘.",
   "cap": [
    "근데 사 온 빵은 / 꼭 [반 갈라서] 나 줘"
   ]
  },
  {
   "id": "j",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 명절만 되면 상황이 바뀌어.",
   "cap": [
    "근데 [명절]만 되면"
   ]
  },
  {
   "id": "k",
   "voice": "sis",
   "gap": 0.1,
   "say": "삼촌한테 세배 안 하니?",
   "cap": [
    "\"[삼촌]한테 / 세배 안 하니?\""
   ]
  },
  {
   "id": "l",
   "voice": "nar",
   "gap": 0.12,
   "say": "삼 학년 형이 일 학년 삼촌한테 절을 해.",
   "cap": [
    "3학년이 / 1학년한테 [세배]"
   ]
  },
  {
   "id": "m",
   "voice": "me",
   "gap": 0.1,
   "say": "그래, 올해도 공부 열심히 하고.",
   "cap": [
    "\"그래, 올해도 / [공부] 열심히 하고\""
   ]
  },
  {
   "id": "n",
   "voice": "nar",
   "gap": 0.12,
   "say": "그날 걔 표정이 진짜 겁나 썩었어.",
   "cap": [
    "그날 걔 표정 / 진짜 [겁나 썩었어]"
   ]
  },
  {
   "id": "o",
   "voice": "nar",
   "gap": 0.12,
   "say": "근데 학교에서 누가 나한테 시비를 걸었을 때,",
   "cap": [
    "근데 학교에서 누가 / 나한테 [시비] 걸 때"
   ]
  },
  {
   "id": "p",
   "voice": "nep",
   "gap": 0.1,
   "say": "우리 삼촌 건드리지 마.",
   "cap": [
    "\"우리 [삼촌] / 건드리지 마\""
   ]
  }
 ]
