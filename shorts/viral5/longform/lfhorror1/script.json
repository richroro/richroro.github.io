  {
   "id": "006",
   "chapter": "설정",
   "voice": "nar",
   "gap": 1.2,
   "say": "나는 스물네 살,|복학을 앞둔 휴학생이다.",
   "cap": [
    "나는 스물네 살,",
    "복학을 앞둔 휴학생이다."
