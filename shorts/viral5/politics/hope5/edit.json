 "lines": [
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 314.56,
   "en": "[Taking care of kids] makes me feel loved.",
   "ko": "아이들을 돌보면 사랑받는 느낌이 들어요.",
   "to": 316.8
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 317.34,
   "en": "I feel [somebody loves me].",
   "ko": "누군가 날 사랑한다는 느낌이요.",
   "to": 318.94
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 11.9,
   "en": "My name is Ruth Stevens, I am [75 years old].",
   "ko": "제 이름은 루스 스티븐스, 75살이에요.",
   "to": 14.84
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 34.84,
   "en": "I raised more than [10 children] who were not my own.",
   "ko": "제 자식이 아닌 아이를 10명 넘게 키웠어요.",
   "to": 38.02
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 42.02,
   "en": "Every child that I have taken care of [graduated school],",
   "ko": "제가 돌본 아이는 모두 학교를 졸업했고,",
   "to": 45.8
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 46.22,
   "en": "stayed off drugs while they live with me.",
   "ko": "저랑 사는 동안 마약에 손대지 않았어요.",
   "to": 48.94
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 65.64,
   "en": "When my grandson [Tamir] was born,",
   "ko": "손자 타미르가 태어났을 때,",
   "to": 68.3
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 68.42,
   "en": "I found out that he was placed in [foster care].",
   "ko": "위탁 가정에 보내졌다는 걸 알았어요.",
   "to": 70.76
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 79.58,
   "en": "Tamir is my grandson and he [needed to be with me].",
   "ko": "타미르는 제 손자예요. 저랑 있어야 했어요.",
   "to": 83.14
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 83.8,
   "en": "I took the train which was about [three and a half hours] from Philadelphia",
   "ko": "필라델피아에서 기차로 3시간 반을 오갔어요.",
   "to": 88.54
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 109.04,
   "en": "I was eventually able to [bring Tamir home] with me.",
   "ko": "결국 타미르를 집으로 데려왔어요.",
   "to": 111.9
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 112.44,
   "en": "He was about [eight weeks old].",
   "ko": "생후 8주쯤이었죠.",
   "to": 114.14
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 246.2,
   "en": "He just [graduated from high school].",
   "ko": "그 아이가 얼마 전 고등학교를 졸업했어요.",
   "to": 248.02
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 329.98,
   "en": "I do the best that I can to keep Tamir safe",
   "ko": "타미르를 지키려고 최선을 다해요.",
   "to": 332.16
  },
  {
   "who": 0,
   "src": "hope/stevens.mp4",
   "at": 332.66,
   "en": "and [I'm proud of myself] for raising him.",
   "ko": "그 아이를 키운 제가 자랑스러워요.",
   "to": 334.54
  }
 ],
 "keys": [
