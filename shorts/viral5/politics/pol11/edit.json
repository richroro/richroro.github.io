 "lines": [
  {
   "who": 0,
   "text": "그리고 또 하나, 지금 대중문화위원회 위원장 맡고서"
  },
  {
   "who": 0,
   "text": "개인적으로 무슨 이득을 취한 게 있습니까?"
  },
  {
   "who": 0,
   "text": "시간만 뺏긴 거 아닌가요, 지금까지?"
  },
  {
   "who": 1,
   "text": "그래도 너무 보람 있습니다."
  },
  {
   "who": 0,
   "text": "그게 애국심이라 보람이 있는 거지"
  },
  {
   "who": 0,
   "text": "속세적인 이득 취한 게 있어요? 지금?"
  },
  {
   "who": 1,
   "text": "돈은 좀 많이 썼습니다."
  },
  {
   "who": 0,
   "text": "개인 돈도 많이 썼죠."
  },
  {
   "who": 0,
   "text": "그리고 또 하나는 상표권 선취득에 관해서도"
  },
  {
   "who": 0,
   "text": "그 상표권 선취득으로 몇 년 후에 얼마를 벌어들일지 압니까? 모릅니까?"
  },
  {
   "who": 1,
   "text": "모르지만 아무튼 저희 회사에 남을 일은 없습니다."
  },
  {
   "who": 0,
   "text": "그런데 그걸 가지고 근본적으로 선의에 의해서"
  },
  {
   "who": 0,
   "text": "많은 걸 감수하고 하신 거 국민들이 다 아실 것 같습니다."
  }
 ],
