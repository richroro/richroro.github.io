 "lines": [
  {
   "who": 0,
   "at": 8.78,
   "en": "Yeah, human spaceflight was always the goal,",
   "ko": "네, 유인 우주비행은 언제나 목표였어요."
  },
  {
   "who": 0,
   "at": 11.9,
   "en": "the fundamental goal of SpaceX.",
   "ko": "스페이스X의 근본적인 목표죠.",
   "to": 13.8
  },
  {
   "who": 0,
   "at": 24.74,
   "en": "I cannot emphasize this enough.",
   "ko": "아무리 강조해도 모자랍니다."
  },
  {
   "who": 0,
   "at": 27.08,
   "en": "This is the thing that we need to do.",
   "ko": "이건 우리가 꼭 해야 하는 일이에요."
  },
  {
   "who": 0,
   "at": 28.72,
   "en": "We must make life [sustainably multiplanetary].",
   "ko": "생명이 여러 행성에서 계속 살 수 있게 해야 합니다."
  },
  {
   "who": 0,
   "at": 31.66,
   "en": "It's not one planet to the exclusion of another,",
   "ko": "한 행성을 버리자는 게 아니라"
  },
  {
   "who": 0,
   "at": 33.9,
   "en": "but to extend life beyond Earth,",
   "ko": "생명을 지구 밖으로 넓히자는 거죠."
  },
  {
   "who": 0,
   "at": 37.28,
   "en": "we are [life's agent] in this regard.",
   "ko": "그 점에서 우리는 생명의 대리인입니다.",
   "to": 39.6
  },
  {
   "who": 0,
   "at": 40.74,
   "en": "All the creatures and the plants",
   "ko": "지구의 모든 동물과 식물,"
  },
  {
   "who": 0,
   "at": 42.66,
   "en": "and everyone that exists here on Earth,",
   "ko": "여기 사는 모든 존재를"
  },
  {
   "who": 0,
   "at": 44.44,
   "en": "we can bring them to other planets,",
   "ko": "다른 행성으로 데려갈 수 있어요."
  },
  {
   "who": 0,
   "at": 46.48,
   "en": "and it's very important that we do so as soon as possible,",
   "ko": "그리고 최대한 빨리 해야 합니다."
  },
  {
   "who": 0,
   "at": 49.4,
   "en": "I think, [while the window of opportunity is open].",
   "ko": "기회의 창이 열려 있을 때요.",
   "to": 51.9
  },
  {
   "who": 0,
   "at": 68.4,
   "en": "We've got to [get it done].",
   "ko": "반드시 해내야 합니다.",
   "to": 69.4
  }
 ],
 "keys": [
  "여러 행성",
  "생명의 대리인",
  "열려 있을 때",
  "해내야"
 ]
