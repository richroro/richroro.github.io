 "lines": [
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 186.72,
   "en": "My neurologist tells me that my [Parkinson's] symptoms",
   "ko": "주치의가 그러는데, 제 파킨슨병 증상이",
   "to": 188.86
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 188.92,
   "en": "have remained [unusually steady],",
   "ko": "이상할 만큼 그대로래요.",
   "to": 190.52
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 191.12,
   "en": "saying it has never happened before in decades of her practice",
   "ko": "수십 년 진료하면서 처음 보는 일이라며",
   "to": 194.7
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 194.8,
   "en": "and dubbing it a [miracle].",
   "ko": "기적이라고 하더군요.",
   "to": 195.7
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 15.96,
   "en": "My name is Steve Sappington, I'm [73 years old].",
   "ko": "제 이름은 스티브 새핑턴, 73살입니다.",
   "to": 19.02
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 19.44,
   "en": "I'm married to my wife Dee for [51 years],",
   "ko": "아내 디와 결혼한 지 51년 됐고요.",
   "to": 22.1
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 209.74,
   "en": "When I first heard my diagnosis, it [rocked my world].",
   "ko": "처음 진단을 들었을 땐 세상이 무너지는 것 같았어요.",
   "to": 212.36
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 212.62,
   "en": "I didn't know what my [future] would hold.",
   "ko": "앞으로 어떻게 될지 몰랐죠.",
   "to": 214.1
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 79.76,
   "en": "I wanted [nothing to do with it] at the time.",
   "ko": "그땐 쳐다보기도 싫었어요.",
   "to": 81.74
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 81.9,
   "en": "Why would I want to go to a [boxing class]?",
   "ko": "내가 왜 복싱 수업에 가야 해?",
   "to": 83.74
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 91.92,
   "en": "Eventually I gave in, mostly to [get them off my back],",
   "ko": "결국 못 이기는 척 갔어요. 잔소리 그만 들으려고요.",
   "to": 94.8
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 95.36,
   "en": "but I went to observe a class [secretly determined to hate it].",
   "ko": "속으로는 싫어할 작정을 하고요.",
   "to": 98.58
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 98.74,
   "en": "Instead, I found it interesting and [even fun].",
   "ko": "그런데 웬걸, 재미있더라고요.",
   "to": 100.84
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 144.88,
   "en": "I decided to start a [nonprofit] to raise money to keep them going.",
   "ko": "수업이 이어지도록 비영리 단체를 직접 세웠어요.",
   "to": 147.92
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 196.54,
   "en": "I went [eight years] without needing to increase my medication.",
   "ko": "8년 동안 약을 늘리지 않아도 됐어요.",
   "to": 199.2
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 216.32,
   "en": "I was [skeptical] of the boxing class originally, but I went.",
   "ko": "처음엔 의심했지만, 그래도 갔어요.",
   "to": 218.82
  },
  {
   "who": 0,
   "src": "hope/sappington.mp4",
   "at": 218.96,
   "en": "That single decision [changed my life].",
   "ko": "그 결정 하나가 제 인생을 바꿨어요.",
   "to": 221.6
  }
 ],
 "keys": [
  "파킨슨병",
