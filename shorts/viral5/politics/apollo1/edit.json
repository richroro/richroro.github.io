 ],
 "lines": [
  {"who": 0, "at": 22.3, "to": 26.95, "ko": "왼손엔 깃털, 오른손엔 망치가 있어요.", "en": "Well, in my left hand, I have a feather; in my right hand, a hammer."},
  {"who": 0, "at": 27.0, "to": 33.1, "ko": "우리가 오늘 여기 온 건 오래전 갈릴레오라는 분 덕분이기도 하죠.", "en": "And I guess one of the reasons we got here today was because of a gentleman named Galileo, a long time ago,"},
  {"who": 0, "at": 33.4, "to": 38.0, "ko": "중력 속에서 물체가 떨어지는 방식에 대해 꽤 중요한 발견을 했던 분이요.", "en": "who made a rather significant discovery about falling objects in gravity fields."},
  {"who": 0, "at": 38.5, "to": 45.3, "ko": "그 발견을 확인하기에 달보다 더 좋은 곳이 있을까 싶었죠.", "en": "And we thought where would be a better place to confirm his findings than on the Moon."},
  {"who": 0, "at": 46.3, "to": 48.7, "ko": "그래서 여기서 한번 해 보려고요.", "en": "And so we thought we'd try it here for you."},
  {"who": 0, "at": 49.0, "to": 54.1, "ko": "깃털은 마침 매(팰컨)의 깃털이에요. 우리 ‘팰컨’ 호에 딱이죠.", "en": "The feather happens to be, appropriately, a falcon feather for our Falcon."},
  {"who": 0, "at": 54.4, "to": 59.2, "ko": "둘을 같이 떨어뜨릴게요. 바닥에 동시에 닿았으면 좋겠네요.", "en": "And I'll drop the two of them here and, hopefully, they'll hit the ground at the same time."},
  {"who": 0, "t": 37.45, "tend": 39.25, "ko": "과연…? 👀", "en": ""},
  {"who": 0, "t": 39.35, "tend": 43.0, "ko": "느리게 다시 보면 🔁", "en": ""},
  {"who": 0, "t": 43.11, "tend": 45.05, "ko": "어때요!", "en": "How about that!"},
  {"who": 1, "t": 45.15, "tend": 45.9, "ko": "어때요! 👏 (관제실 박수)", "en": "How about that!"},
  {"who": 0, "t": 45.95, "tend": 49.1, "ko": "갈릴레오 선생이 옳았다는 게 증명됐네요.", "en": "Which proves that Mr. Galileo was correct in his findings."},
  {"who": 1, "t": 49.6, "tend": 50.55, "ko": "완벽합니다.", "en": "Superb."},
  {"who": 0, "t": 50.65, "tend": 52.85, "ko": "공기가 없으니 무게와 상관없이 똑같이 떨어진 거예요", "en": ""},
  {"who": 0, "t": 52.9, "tend": 55.25, "ko": "망치는 1.32kg, 깃털은 미 공군사관학교 매의 깃털 🪶", "en": ""}
 ],
 "stickers": [
