 "lines": [
  {
   "who": 0,
   "text": "박진영 위원장님과 오버랩 되는 게"
  },
  {
   "who": 0,
   "text": "강훈식 전 비서실장, 최휘영 장관님"
  },
  {
   "who": 0,
   "text": "멕시코에서 대통령과 찍은 사진이 상당히 좀 아쉬웠어요.",
   "at": 19.1
  },
  {
   "who": 0,
   "text": "왜냐하면 국민들이 어떻게 생각할까."
  },
  {
   "who": 0,
   "text": "혹시 박진영 위원장은 저쪽에 섰나",
   "at": 26.4
  },
  {
   "who": 0,
   "text": "오히려 저는 박진영 위원장이 피해자가 아닌가",
   "at": 33.3
  },
  {
   "who": 0,
   "text": "피해를 보고 계시는 거 아닌가"
  },
  {
   "who": 0,
   "text": "이 정권의 흥망과 같이 가는 거 아닌가",
   "at": 42.9
  },
  {
   "who": 0,
   "text": "이런 걱정을 좀 하게 됐습니다."
  },
  {
   "who": 1,
   "text": "명확하게 밝힐 수 있습니다.",
   "at": 58.1
  },
  {
   "who": 1,
   "text": "이재명 대통령을 위해서 일한다는 생각을 해본 적도 없고요",
   "at": 62.35
  },
  {
   "who": 1,
   "text": "이 정권 혹은 민주당을 위해서 일한다는 생각을 1초도 해본 적이 없고"
  },
  {
   "who": 1,
   "text": "제 마음속에 1%도 없습니다."
  },
  {
   "who": 1,
   "text": "그냥 이 일이 우리 다음 세대에"
  },
  {
   "who": 1,
   "text": "정말 도움이 될 것 같아서 하는 겁니다."
  },
  {
   "who": 1,
   "text": "그 외에는 어떠한 생각도 없습니다."
  },
  {
   "who": 1,
   "text": "저 증인 선서 했으니까 믿어주세요."
  }
 ],
