 "lines": [
  {
   "who": 0,
   "at": 66.26,
   "en": "My decision to [turn professional]",
   "ko": "제가 프로로 전향한 건"
  },
  {
   "who": 0,
   "at": 68.2,
   "en": "was based on the desire to help my family",
   "ko": "가족을 돕고 싶어서였어요."
  },
  {
   "who": 0,
   "at": 71.3,
   "en": "cover the cost of [my father's care].",
   "ko": "아버지 치료비를 대려고요.",
   "to": 74.3
  },
  {
   "who": 0,
   "at": 14.6,
   "en": "During my personal accomplishments in the ring,",
   "ko": "제가 (10대 시절) 링에서 승승장구하는 동안"
  },
  {
   "who": 0,
   "at": 18.7,
   "en": "privately my family faced challenges",
   "ko": "집에서는 힘든 일을 겪고 있었어요."
  },
  {
   "who": 0,
   "at": 21.0,
   "en": "as my father struggled to manage his [diabetes].",
   "ko": "아버지가 당뇨와 힘겹게 싸우셨거든요.",
   "to": 23.6
  },
  {
   "who": 0,
   "at": 263.54,
   "en": "With just seconds left in the eighth round,",
   "ko": "(듀란과의 재대결) 8라운드 종료 몇 초 전,"
  },
  {
   "who": 0,
   "at": 265.96,
   "en": "Roberto Duran turned his back, walked to his corner,",
   "ko": "로베르토 듀란이 등을 돌려 코너로 걸어가더니"
  },
  {
   "who": 0,
   "at": 269.68,
   "en": "threw his hands up and said, [\"No mas.\"]",
   "ko": "두 손을 들고 말했죠. \"노 마스(그만).\""
  },
  {
   "who": 0,
   "at": 272.7,
   "en": "He quit.",
   "ko": "기권한 거예요.",
   "to": 273.5
  },
  {
   "who": 0,
   "at": 288.52,
   "en": "There are days that we all think about saying \"no mas,\"",
   "ko": "누구나 \"그만\"이라고 말하고 싶은 날이 있어요."
  },
  {
   "who": 0,
   "at": 294.1,
   "en": "but it's clear, it's totally clear",
   "ko": "하지만 분명해요."
  },
  {
   "who": 0,
   "at": 296.66,
   "en": "that [these children have fight in them].",
   "ko": "이 아이들에겐 싸울 힘이 있다는 걸요."
  },
  {
   "who": 0,
   "at": 299.3,
   "en": "They're willing to go [as many rounds as it takes]",
   "ko": "몇 라운드든 끝까지 싸울 거예요."
  },
  {
   "who": 0,
   "at": 302.46,
   "en": "to beat this formidable opponent.",
   "ko": "이 강한 상대를 이길 때까지요.",
   "to": 303.7
  }
 ],
 "keys": [
  "프로로",
