 "lines": [
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 80.44,
   "en": "When I first found out I had [diabetes],",
   "ko": "처음 당뇨인 걸 알았을 때,",
   "to": 82.65
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 82.8,
   "en": "I remember thinking that this would change my [whole life].",
   "ko": "제 인생이 통째로 바뀔 거라고 생각했어요.",
   "to": 85.25
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 85.3,
   "en": "I thought that I wouldn't realize my [dream] of being a sports star.",
   "ko": "운동선수가 되는 꿈은 못 이룰 줄 알았어요.",
   "to": 88.35
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 88.68,
   "en": "Now I can realize I can do [whatever I want].",
   "ko": "근데 이제 알아요. 뭐든 할 수 있다는 걸요.",
   "to": 90.6
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 38.06,
   "en": "I was diagnosed with T1D way back when I was [six years old].",
   "ko": "저는 6살 때 1형 당뇨 진단을 받았어요.",
   "to": 41.5
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 45.9,
   "en": "I kept asking the teacher to go to the bathroom because I [really, really] had to.",
   "ko": "화장실이 너무너무 급해서 선생님께 자꾸 말했어요.",
   "to": 49.65
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 50.04,
   "en": "She got [angry] at me because she thought I was just trying to skip class.",
   "ko": "선생님은 제가 수업을 빼먹으려는 줄 알고 화내셨죠.",
   "to": 53.25
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 53.76,
   "en": "She felt bad when she found out the [real reason].",
   "ko": "진짜 이유를 아시고는 미안해하셨어요.",
   "to": 56.15
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 91.28,
   "en": "Sometimes my Omnipod or CGM [beeps] in class",
   "ko": "수업 중에 인슐린 펌프나 혈당기가 삐삐 울리면",
   "to": 93.95
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 94.18,
   "en": "and the other kids say, \"Charlie, [stop making noise].\"",
   "ko": "친구들이 '찰리, 시끄러워!' 해요.",
   "to": 96.7
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 96.9,
   "en": "I just tell them that's my natural [robot noise].",
   "ko": "그럼 저는 '이건 원래 내 로봇 소리야' 하죠.",
   "to": 99.3
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 105.88,
   "en": "I want my disease to [go away] for me and all the other kids who suffer from it.",
   "ko": "제 병이 없어졌으면 좋겠어요. 아픈 다른 아이들 것도요.",
   "to": 109.65
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 27.9,
   "en": "And when I grow up, I hope to play in the major leagues for the [Boston Red Sox].",
   "ko": "커서 메이저리그 보스턴 레드삭스에서 뛰고 싶어요.",
   "to": 32.4
  },
  {
   "who": 0,
   "src": "hope/albair.mp4",
   "at": 130.22,
   "en": "I'll [invite you] to a game when I'm on the Red Sox.",
   "ko": "제가 레드삭스 선수가 되면 경기에 초대할게요.",
   "to": 132.0
  }
 ],
 "keys": [
  "통째로",
  "꿈은",
  "뭐든",
