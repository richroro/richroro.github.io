 "lines": [
  {
   "who": 0,
   "at": 305.74,
   "en": "Well, primarily just tending the store, Mr. Clark.",
   "ko": "뭐, 주로 집 보는 거죠."
  },
  {
   "who": 0,
   "at": 320.36,
   "en": "So I expect to be keeping the command module ready",
   "ko": "사령선을 계속 준비해 둘 거예요."
  },
  {
   "who": 0,
   "at": 325.04,
   "en": "for Neil and Buzz's return the next day,",
   "ko": "다음 날 닐과 버즈가 돌아올 때까지요."
  },
  {
   "who": 0,
   "at": 327.92,
   "en": "and I'll be [quite busy] doing that.",
   "ko": "그것만 해도 꽤 바쁠 겁니다.",
   "to": 329.8
  },
  {
   "who": 0,
   "at": 1418.16,
   "en": "No, I really don't, Mr. Rossiter.",
   "ko": "아뇨, 전혀요.",
   "to": 1420.4
  },
  {
   "who": 0,
   "at": 1433.14,
   "en": "I do have [one complaint], however.",
   "ko": "그런데 불만이 하나 있어요."
  },
  {
   "who": 0,
   "at": 1434.8,
   "en": "I'd like to point out to those of you",
   "ko": "여기 계신 분들,"
  },
  {
   "who": 0,
   "at": 1437.24,
   "en": "particularly in the television business",
   "ko": "특히 방송국 분들께 말씀드리는데"
  },
  {
   "who": 0,
   "at": 1439.98,
   "en": "that I have [no TV set] on board,",
   "ko": "제 우주선엔 TV가 없어요."
  },
  {
   "who": 0,
   "at": 1442.16,
   "en": "and therefore I'm going to be one of the few Americans",
   "ko": "그래서 저는 몇 안 되는 미국인이 될 거예요."
  },
  {
   "who": 0,
   "at": 1444.4,
   "en": "who's not going to be able to see the EVA,",
   "ko": "달 위를 걷는 장면을 못 보는 사람이요."
  },
  {
   "who": 0,
   "at": 1447.16,
   "en": "so I'd like you to [save the tapes] for me, please.",
   "ko": "그러니 녹화 테이프 좀 남겨 주세요."
  },
  {
   "who": 0,
   "at": 1450.84,
   "en": "I'd like to look at them after the flight.",
   "ko": "비행 끝나고 볼게요.",
   "to": 1452.3
  }
 ],
 "keys": [
