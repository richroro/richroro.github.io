 "lines": [
  {
   "who": 0,
   "en": "Now, Mr. Zuckerberg, I remember well",
   "ko": "저커버그 씨, 저는 똑똑히 기억합니다.",
   "t": 0.14,
   "tend": 2.9
  },
  {
   "who": 0,
   "at": 30.14,
   "en": "your first visit to Capitol Hill back in 2010.",
   "ko": "2010년 당신이 처음 의회에 왔을 때를요.",
   "to": 33.6
  },
  {
   "who": 0,
   "at": 33.9,
   "en": "You spoke to the Senate Republican High-Tech Task Force,",
   "ko": "상원 공화당 하이테크 태스크포스에서"
  },
  {
   "who": 0,
   "at": 36.44,
   "en": "which I chair.",
   "ko": "제가 이끄는 곳이죠.",
   "to": 37.6
  },
  {
   "who": 0,
   "at": 37.8,
   "en": "You said back then that Facebook would [always be free].",
   "ko": "그때 페이스북은 늘 무료일 거라고 했죠.",
   "to": 41.7
  },
  {
   "who": 0,
   "at": 41.9,
   "en": "Is that still your objective?",
   "ko": "지금도 그게 목표입니까?",
   "to": 43.9
  },
  {
   "who": 1,
   "at": 45.7,
   "en": "Senator, yes. There will always be",
   "ko": "네, 의원님. 페이스북에는 언제나"
  },
  {
   "who": 1,
   "at": 47.9,
   "en": "a version of Facebook that is free.",
   "ko": "무료 버전이 있을 겁니다.",
   "to": 49.4
  },
  {
   "who": 0,
   "at": 59.7,
   "en": "Well, if so, how do you sustain a business model",
   "ko": "그렇다면 그 사업은 어떻게 유지하죠?"
  },
  {
   "who": 0,
   "at": 61.82,
   "en": "in which users don't pay for your service?",
   "ko": "사용자가 서비스에 돈을 안 내는데요.",
   "to": 64.3
  },
  {
   "who": 1,
   "at": 66.75,
   "en": "Senator, [we run ads].",
   "ko": "의원님, 저희는 광고를 합니다.",
   "to": 69.5
  },
  {
   "who": 0,
   "at": 69.7,
   "en": "I see. That's great.",
   "ko": "그렇군요. 훌륭하네요.",
   "to": 71.85
  }
 ],
