 "lines": [
  {
   "who": 0,
   "at": 113.44,
   "en": "First thing I did was ask her, [am I going to die?]",
   "ko": "제일 먼저 의사에게 물었어요. \"저 죽나요?\"",
   "to": 116.2
  },
  {
   "who": 0,
   "at": 117.96,
   "en": "She assured me that I wasn't going to die,",
   "ko": "의사는 죽지 않는다고 안심시켜 줬어요."
  },
  {
   "who": 0,
   "at": 120.06,
   "en": "but that I'd have to manage this disease [for the rest of my life].",
   "ko": "대신 평생 이 병을 관리해야 한다고요.",
   "to": 122.4
  },
  {
   "who": 0,
   "at": 73.04,
   "en": "It was during a concert tour in 2005",
   "ko": "2005년 콘서트 투어 중에"
  },
  {
   "who": 0,
   "at": 74.78,
   "en": "that I was diagnosed with [type 1 diabetes].",
   "ko": "1형 당뇨 진단을 받았어요.",
   "to": 78.2
  },
  {
   "who": 0,
   "at": 84.28,
   "en": "I was thirsty all the time",
   "ko": "늘 목이 말랐고"
  },
  {
   "who": 0,
   "at": 85.44,
   "en": "and I had a bad attitude, [which is unlike me].",
   "ko": "짜증도 늘었죠. 원래 그런 애가 아닌데요.",
   "to": 88.8
  },
  {
   "who": 0,
   "at": 263.58,
   "en": "In the meantime, I've decided [not to let diabetes slow me down].",
   "ko": "그래서 당뇨 때문에 멈추지 않기로 했어요.",
   "to": 267.5
  },
  {
   "who": 0,
   "at": 298.9,
   "en": "While on that path, I want to be a [positive face] for diabetes.",
   "ko": "당뇨를 가진 사람의 밝은 얼굴이 되고 싶어요."
  },
  {
   "who": 0,
   "at": 302.64,
   "en": "I want to show kids with type 1 diabetes,",
   "ko": "1형 당뇨를 가진 아이들에게 보여 주고 싶어요."
  },
  {
   "who": 0,
   "at": 304.48,
   "en": "like all the kids sitting with me today,",
   "ko": "오늘 저와 함께 앉아 있는 아이들처럼요."
  },
  {
   "who": 0,
   "at": 307.18,
   "en": "that [they can live their dreams] while living with diabetes.",
   "ko": "당뇨가 있어도 꿈을 이룰 수 있다는 걸요.",
   "to": 311.8
  }
 ],
 "keys": [
  "\"저",
  "죽나요?\"",
  "평생",
  "멈추지",
  "꿈을"
 ]
