 "lines": [
  {"who": 0, "at": 3.5, "ko": "사실 바이든 대통령이나 백악관 참모들이", "en": "In fact, President Biden and/or his White House staff"},
  {"who": 0, "at": 8.8, "ko": "갈랜드 법무장관한테 대통령(트럼프)을 기소하라고 했죠?", "en": "told General Garland to prosecute the president, didn't he?", "to": 12.3},
  {"who": 1, "at": 13.9, "ko": "거듭 말씀드리지만, 그건 전혀 모릅니다.", "en": "Again, I have no idea about that."},
  {"who": 1, "at": 16.45, "ko": "제 일은…", "en": "What my job was, was to make—"},
  {"who": 0, "at": 17.94, "ko": "그건 아무것도 모르신다.", "en": "Don't know anything about that."},
  {"who": 0, "at": 19.05, "ko": "이빨 요정은 믿습니까?", "en": "Do you believe in the tooth fairy?", "to": 20.6},
  {"who": 1, "at": 22.7, "ko": "안 믿습니다.", "en": "I do not.", "to": 23.8},
  {"who": 0, "at": 24.55, "ko": "부활절 토끼는요?", "en": "How about the Easter Bunny?", "to": 26.3},
  {"who": 1, "at": 27.6, "ko": "부활절 토끼도 이젠 안 믿습니다.", "en": "I no longer believe in the Easter Bunny.", "to": 30.3},
  {"who": 0, "at": 108.45, "ko": "보스버그 판사한테 갔을 때 말도 안 했잖아요.", "en": "When you went to Judge Boasberg, you didn't even tell him"},
  {"who": 0, "at": 113.5, "ko": "의원들 통화기록을 구한다는 걸요. 그렇죠?", "en": "you were seeking the phone records of members of Congress, did you,"},
  {"who": 0, "at": 117.5, "ko": "판사가 동의 안 할 걸 알았으니까.", "en": "because you knew he wouldn't agree.", "to": 119.1},
  {"who": 1, "at": 131.65, "ko": "저희는 비공개 명령을 신청…", "en": "We sought nondisclosure orders from—", "to": 135.1},
  {"who": 0, "at": 135.2, "ko": "판사한테 말 안 했죠?", "en": "You didn't tell him, did you?", "to": 137.0},
  {"who": 1, "at": 137.7, "ko": "비공개 명령을 신청하면서 공개는 안 했습니다.", "en": "In seeking nondisclosure orders, we did not disclose.", "to": 140.6},
  {"who": 0, "at": 140.7, "ko": "말을 안 했다. 그런데 편향은 없으시다.", "en": "You didn't tell him, but you're unbiased."},
  {"who": 0, "at": 144.1, "ko": "개인적인 감정도 없으시고.", "en": "You have no personal feelings.", "to": 146.6},
  {"who": 0, "at": 149.7, "ko": "당신 때문에 토할 것 같네요.", "en": "You make me want to throw up in my mouth.", "to": 152.7}
 ],
