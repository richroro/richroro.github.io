 "lines": [
  {"who": 0, "at": 0.05, "to": 1.75, "ko": "오른쪽 5, 천천히 오른쪽… 정지", "en": "Right 5, easy right, and hold."},
  {"who": 0, "t": 1.85, "tend": 5.6, "ko": "알래스카 셰포낙 서쪽 약 16km 바다", "en": ""},
  {"who": 0, "t": 5.7, "tend": 9.5, "ko": "물범 사냥 나간 가족 4명 (어른 3, 아이 1)", "en": ""},
  {"who": 0, "t": 9.6, "tend": 12.6, "ko": "5.5m 배가 얼음 위에 갇혀 24시간 넘게 😰", "en": ""},
  {"who": 0, "at": 13.1, "to": 14.95, "ko": "정지", "en": "And hold."},
  {"who": 0, "at": 28.25, "to": 30.9, "ko": "무게 받아!", "en": "Take the load."},
  {"who": 0, "at": 31.25, "to": 33.7, "ko": "바스켓, 얼음에서 떠올랐다", "en": "Basket is clear of the deck."},
  {"who": 0, "at": 33.75, "to": 35.35, "ko": "천천히 뒤로, 왼쪽으로", "en": "Easy back and left."},
  {"who": 0, "at": 50.25, "to": 53.4, "ko": "뒤로 30", "en": "Back 30."},
  {"who": 0, "at": 53.6, "to": 57.2, "ko": "뒤로 20… 뒤로 10", "en": "Back 20. Back 10."},
  {"who": 0, "at": 58.5, "to": 60.95, "ko": "천천히 뒤로… 정지", "en": "Easy back, and hold."},
  {"who": 0, "at": 77.2, "to": 79.1, "ko": "생존자, 얼음에서 떠올랐다", "en": "Survivor's clear of the ice."},
  {"who": 0, "at": 79.2, "to": 81.2, "ko": "천천히 뒤로, 왼쪽으로 가도 좋다", "en": "Clear to move easy back and left."},
  {"who": 0, "at": 82.9, "to": 84.55, "ko": "생존자, 절반 올라왔다", "en": "Survivor's halfway up."},
