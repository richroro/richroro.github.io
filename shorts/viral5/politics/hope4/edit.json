 "lines": [
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 205.1,
   "en": "I was able to end my high school long jump career this year",
   "ko": "올해 고교 멀리뛰기 선수 생활을 마무리했어요.",
   "to": 207.48
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 207.56,
   "en": "by breaking a [39 year old] national high school record",
   "ko": "39년 묵은 미국 고교 기록을 깨면서요.",
   "to": 210.0
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 210.06,
   "en": "with a jump of [22 feet 5 inches].",
   "ko": "6m 83cm를 뛰었어요.",
   "to": 212.4
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 24.16,
   "en": "I was diagnosed with Type 1 diabetes when I was [ten years old].",
   "ko": "저는 10살에 1형 당뇨 진단을 받았어요.",
   "to": 27.38
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 47.84,
   "en": "The thing that stood out to me the most",
   "ko": "가장 기억에 남는 건",
   "to": 49.55
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 49.6,
   "en": "was being [benched] during my first soccer game after my diagnosis.",
   "ko": "진단 후 첫 축구 경기에서 벤치에 앉아 있던 거예요.",
   "to": 52.5
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 53.24,
   "en": "That really made me realize that diabetes wasn't going to ever [stop me]",
   "ko": "그때 깨달았어요. 당뇨는 저를 막을 수 없다는 걸요,",
   "to": 56.95
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 57.02,
   "en": "from doing the things I [loved most].",
   "ko": "제가 제일 좋아하는 걸 하는 데요.",
   "to": 58.54
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 59.82,
   "en": "I thought, I am [not sitting out] on anything ever again if I can help it.",
   "ko": "다짐했죠. 이제 절대 벤치에 앉아만 있지 않겠다고.",
   "to": 63.9
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 64.54,
   "en": "I am [figuring this thing out].",
   "ko": "이건 내가 꼭 이겨 낸다고요.",
   "to": 66.1
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 91.16,
   "en": "Managing my diabetes can be [really hard] at times,",
   "ko": "당뇨 관리가 정말 힘들 때도 있어요.",
   "to": 93.5
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 93.56,
   "en": "and I realize I can't figure everything out [on my own].",
   "ko": "혼자서는 다 해낼 수 없다는 것도 알아요.",
   "to": 95.94
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 197.66,
   "en": "the support of my [family] and the health care team",
   "ko": "가족과 의료진이 도와준 덕분에",
   "to": 200.18
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 200.38,
   "en": "have allowed me to [pursue my passion].",
   "ko": "좋아하는 걸 계속할 수 있었어요.",
   "to": 201.7
  },
  {
   "who": 0,
   "src": "hope/kate.mp4",
   "at": 228.76,
   "en": "My dream is to one day represent the United States at the [Olympics].",
   "ko": "언젠가 미국 대표로 올림픽에 나가는 게 꿈이에요.",
   "to": 231.46
  }
 ],
