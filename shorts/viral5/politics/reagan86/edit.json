 "lines": [
  {
   "who": 0,
   "at": 1.4,
   "en": "And I want to say something to the schoolchildren of America",
   "ko": "미국의 어린 학생 여러분께 할 말이 있습니다."
  },
  {
   "who": 0,
   "at": 3.8,
   "src": "speech/reagan86_broll.mp4",
   "en": "who were watching the live coverage of the shuttle's takeoff.",
   "ko": "왕복선 발사 생중계를 지켜본 여러분께요.",
   "to": 6.85
  },
  {
   "who": 0,
   "at": 7.45,
   "en": "I know it's hard to understand,",
   "ko": "이해하기 어렵다는 걸 압니다."
  },
  {
   "who": 0,
   "at": 9.2,
   "en": "but … painful things like this happen.",
   "ko": "하지만 … 이런 아픈 일이 일어납니다.",
   "to": 11.9
  },
  {
   "who": 0,
   "at": 12.35,
   "en": "It's all part of the process of exploration and discovery.",
   "ko": "모두 탐험하고 발견하는 과정의 일부입니다.",
   "to": 15.3
  },
  {
   "who": 0,
   "at": 15.95,
   "en": "It's all part of taking a chance and expanding man's horizons.",
   "ko": "모험을 하고 인류의 지평을 넓히는 일의 일부죠.",
   "to": 20.2
  },
  {
   "who": 0,
   "at": 21.3,
   "en": "The future doesn't belong to [the fainthearted];",
   "ko": "미래는 겁 많은 사람의 것이 아닙니다.",
   "to": 23.5
  },
  {
   "who": 0,
   "at": 24.4,
   "en": "it belongs to [the brave].",
   "ko": "용감한 사람의 것입니다.",
   "to": 26.2
  },
  {
   "who": 0,
   "at": 26.3,
   "src": "speech/reagan86_broll.mp4",
   "en": "The Challenger crew was pulling us into the future,",
   "ko": "챌린저호 승무원들은 우리를 미래로 이끌고 있었고,"
  },
  {
   "who": 0,
   "at": 29.0,
   "src": "speech/reagan86_broll.mp4",
   "en": "and we'll continue to follow them.",
   "ko": "우리는 계속 그들을 따라갈 것입니다.",
   "to": 31.85
  },
  {
   "who": 0,
   "at": 51.6,
   "en": "We'll continue [our quest in space].",
   "ko": "우리는 우주 탐사를 계속할 것입니다.",
   "to": 53.95
  },
  {
   "who": 0,
   "at": 54.05,
   "src": "speech/reagan86_broll.mp4",
   "en": "There will be more shuttle flights and more shuttle crews,",
   "ko": "왕복선 비행도, 승무원도 더 많아질 것입니다.",
   "to": 57.3
  },
  {
   "who": 0,
   "at": 57.45,
   "src": "speech/reagan86_broll.mp4",
   "en": "and, yes, more volunteers, more civilians,",
   "ko": "그렇습니다, 지원자도, 민간인도 더 많이,"
  },
  {
   "who": 0,
   "at": 60.3,
   "src": "speech/reagan86_broll.mp4",
   "en": "more teachers in space.",
   "ko": "우주에 가는 교사도 더 많아질 것입니다.",
   "to": 61.95
  },
  {
   "who": 0,
   "at": 62.6,
   "en": "Nothing ends here;",
   "ko": "여기서 끝나는 것은 없습니다."
  },
  {
   "who": 0,
   "at": 63.95,
   "en": "our hopes and our journeys continue.",
   "ko": "우리의 희망과 여정은 계속됩니다.",
   "to": 65.95
  },
  {
   "who": 0,
   "at": 118.6,
   "en": "We will never forget them,",
   "ko": "우리는 그들을 결코 잊지 않을 것입니다."
  },
  {
   "who": 0,
   "at": 120.25,
   "en": "nor the last time we saw them, this morning,",
   "ko": "오늘 아침 그들을 마지막으로 본 모습도요.",
   "to": 123.2
  },
  {
   "who": 0,
   "at": 123.35,
   "src": "speech/reagan86_broll.mp4",
   "en": "as they prepared for their journey and waved goodbye",
   "ko": "여정을 준비하며 손을 흔들어 작별하고",
   "to": 126.25
  },
  {
   "who": 0,
   "at": 126.3,
   "src": "speech/reagan86_broll.mp4",
   "en": "and [slipped the surly bonds of earth]",
   "ko": "지구의 거친 굴레를 벗어나"
  },
  {
   "who": 0,
   "at": 129.7,
   "src": "speech/reagan86_broll.mp4",
   "en": "to [touch the face of God].",
   "ko": "신의 얼굴을 만지러 떠난 모습을.",
   "to": 132.45
  }
 ],
