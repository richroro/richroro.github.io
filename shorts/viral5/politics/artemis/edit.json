 ],
 "lines": [
  {"who": 0, "t": 0.15, "tend": 4.4, "ko": "사람 4명을 태운 로켓이 달로 🚀", "en": ""},
  {"who": 0, "t": 4.5, "tend": 7.9, "ko": "1972년 아폴로 17호 이후 처음 달에 가는 사람들", "en": ""},
  {"who": 0, "t": 8.05, "tend": 12.2, "ko": "달을 보는데 갑자기 벅찬 감동이 밀려왔어요.", "en": "I just had an overwhelming sense of being moved by looking at the moon."},
  {"who": 0, "t": 12.45, "tend": 17.15, "ko": "1~2초뿐이었고, 다시 느껴 보려 해도 안 되더라고요.", "en": "It lasted just a second or two and I actually couldn't even make it happen again."},
  {"who": 0, "t": 17.75, "tend": 23.75, "ko": "그런데 갑자기 달 풍경에 빨려 들어가면서 실감이 났어요.", "en": "But something just drew me in suddenly to the lunar landscape and it became real,"},
  {"who": 0, "t": 23.8, "tend": 29.35, "ko": "달은 정말 우주에 따로 존재하는 하나의 천체예요.", "en": "and the truth is, the moon really is its own celestial body in the universe."},
  {"who": 0, "t": 29.7, "tend": 35.6, "ko": "하늘에 걸린 포스터가 아니라, 진짜 ‘장소’예요.", "en": "It's not just a poster in the sky that goes by. It is a real place."},
  {"who": 0, "t": 36.35, "tend": 40.9, "ko": "그렇게 보고 나서 우리의 집, 지구와 비교해 보면", "en": "And when we have that perspective and we can compare it to our home of the Earth,"},
  {"who": 0, "t": 40.95, "tend": 44.3, "ko": "우리가 얼마나 많은 걸 함께 누리는지 새삼 느껴요.", "en": "it just reminds us how much we have in common."},
  {"who": 0, "t": 44.35, "tend": 46.3, "ko": "필요한 건 전부 지구가 주잖아요.", "en": "Everything we need, the Earth provides,"},
  {"who": 0, "t": 46.4, "tend": 50.05, "ko": "그것 자체가 어찌 보면 기적이에요.", "en": "and that in and of itself is somewhat of a miracle."},
  {"who": 0, "t": 50.25, "tend": 53.5, "ko": "4월 10일, 낙하산 3개를 펴고 무사히 귀환 🪂", "en": ""},
  {"who": 0, "t": 53.6, "tend": 56.6, "ko": "사람이 가장 멀리 다녀온 기록도 새로 썼어요", "en": ""}
 ],
