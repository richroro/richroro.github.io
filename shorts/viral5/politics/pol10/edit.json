 "lines": [
  {
   "who": 0,
   "text": "저는 정말 그러니까 대통령도 SNS에서 미안하다고 하고"
  },
  {
   "who": 0,
   "text": "그래서 저는 우리 박진영 위원장의 대표께서",
   "at": 8.6
  },
  {
   "who": 0,
   "text": "정말 본연의 일자리로 돌아가셔서"
  },
  {
   "who": 0,
   "text": "그런 역할을 했으면 좋겠다."
  },
  {
   "who": 0,
   "text": "연 매출이 8천억이 넘는 거 아닙니까?"
  },
  {
   "who": 0,
   "text": "연봉이 지금 얼마나 되죠? 우리 박진영 대표."
  },
  {
   "who": 0,
   "text": "연봉이 한 20억 30억 정도 되는 걸로 알고 있는데",
   "at": 28.8
  },
  {
   "who": 0,
   "text": "오늘 하루만 하더라도 연봉으로 치면 일당이 800만 원"
  },
  {
   "who": 1,
   "text": "저 대통령이 아니라 대통령 위에 위에 분이 오셔도",
   "at": 58.25
  },
  {
   "who": 1,
   "text": "제가 생각할 때 우리나라를 위한 일이 아닌 것 같으면 저 안 해요."
  },
  {
   "who": 1,
   "text": "진짜 안 합니다."
  },
  {
   "who": 1,
   "text": "한 번도 누가 뭐 하라고 해서 겁먹고 하는 성격도 아니고요."
  },
  {
   "who": 1,
   "text": "이거 잘 되면 진짜 정말 좋아요, 우리나라에."
  },
  {
   "who": 1,
   "text": "절대 이거를 무슨 대통령을 위해 민주당을 위해",
   "at": 80.75
  },
  {
   "who": 1,
   "text": "저는 그런 사람도 아니고요."
  },
  {
   "who": 1,
   "text": "믿으셨으면 좋겠습니다."
  }
 ],
