 "lines": [
  {
   "who": 0,
   "at": 3.56,
   "en": "I wasn't always the best student when I was younger.",
   "ko": "어릴 때 저는 늘 좋은 학생은 아니었습니다."
  },
  {
   "who": 0,
   "at": 6.74,
   "en": "I made [my share of mistakes].",
   "ko": "실수도 꽤 많이 했죠.",
   "to": 8.9
  },
  {
   "who": 0,
   "at": 9.74,
   "en": "I still remember a conversation I had with my mother in high school.",
   "ko": "고등학생 때 어머니와 나눈 대화가 아직도 기억납니다."
  },
  {
   "who": 0,
   "at": 13.1,
   "en": "I was kind of a goof-off.",
   "ko": "저는 좀 농땡이였거든요.",
   "to": 15.3
  },
  {
   "who": 0,
   "at": 21.3,
   "en": "And my grades were slipping.",
   "ko": "성적은 떨어지고 있었고"
  },
  {
   "who": 0,
   "at": 23.44,
   "en": "I hadn't started my college applications.",
   "ko": "대학 지원서는 시작도 안 했죠.",
   "to": 25.96
  },
  {
   "who": 0,
   "at": 32.1,
   "en": "I was doing good enough.",
   "ko": "그럭저럭 괜찮게는 하고 있었어요."
  },
  {
   "who": 0,
   "at": 33.72,
   "en": "I was smart enough that I could kind of get by.",
   "ko": "머리가 꽤 좋아서 대충 넘어갈 수 있었거든요."
  },
  {
   "who": 0,
   "at": 38.2,
   "en": "But I wasn't really applying myself.",
   "ko": "하지만 제대로 노력하지는 않았습니다.",
   "to": 40.0
  },
  {
   "who": 0,
   "at": 68.12,
   "en": "She said, you can't just sit around",
   "ko": "어머니는 말씀하셨죠. 가만히 앉아서"
  },
  {
   "who": 0,
   "at": 69.9,
   "en": "waiting for luck to see you through.",
   "ko": "운이 해결해 주길 기다려선 안 된다고.",
   "to": 72.6
  },
  {
   "who": 0,
   "at": 73.76,
   "en": "She said, you can get into any school you want in the country",
   "ko": "전국 어느 학교든 원하는 곳에 갈 수 있다고,"
  },
  {
   "who": 0,
   "at": 77.28,
   "en": "if you just put in a little bit of effort.",
   "ko": "조금만 노력하면 말이죠.",
   "to": 79.9
  },
  {
   "who": 0,
   "at": 80.78,
   "en": "She gave me a hard look, and she said,",
   "ko": "그러고는 저를 매섭게 보시며 말씀하셨어요."
  },
  {
   "who": 0,
   "at": 82.32,
   "en": "you remember what that's like? [Effort?]",
   "ko": "그게 뭔지 기억은 나니? 노력이란 거.",
   "to": 86.0
  },
  {
   "who": 0,
   "at": 96.1,
   "en": "But eventually her words had the intended effect,",
   "ko": "결국 어머니 말씀은 통했습니다."
  },
  {
   "who": 0,
   "at": 98.96,
   "en": "because I [got serious] about my studies,",
   "ko": "저는 공부를 진지하게 하기 시작했고"
  },
  {
   "who": 0,
   "at": 101.9,
   "en": "and I started to make an effort in everything that I did.",
   "ko": "무엇을 하든 노력하기 시작했죠."
  },
  {
   "who": 0,
   "at": 106.52,
   "en": "And I began to see my grades and my prospects improve.",
   "ko": "그러자 성적도, 앞날도 나아지기 시작했습니다.",
   "to": 109.9
  }
 ],
 "keys": [
  "실수도",
  "노력이란",
  "진지하게"
 ],
