 ],
 "lines": [
  {
   "who": 0,
   "t": 0.2,
   "tend": 3.2,
   "en": "The annals of mankind record no more daring individual achievement",
   "ko": "인류의 기록에 이보다 대담한 개인의 업적은 없다"
  },
  {
   "who": 0,
   "t": 3.2,
   "tend": 6.25,
   "en": "than the [3,600-mile hop] of Charles A. Lindbergh.",
   "ko": "찰스 A. 린드버그의 3,600마일 비행보다."
  },
  {
   "who": 0,
   "t": 6.4,
   "tend": 9.3,
   "en": "The start of aviation's greatest adventure",
   "ko": "항공 역사상 가장 위대한 모험의 시작,"
  },
  {
   "who": 0,
   "t": 9.3,
   "tend": 11.6,
   "en": "at Roosevelt Field, L.I.,",
   "ko": "롱아일랜드 루스벨트 비행장."
  },
  {
   "who": 0,
   "t": 11.6,
   "tend": 15.0,
   "en": "amid the cheers — and [fears] — of a big throng.",
   "ko": "모인 군중의 환호와, 걱정 속에서."
  },
  {
   "who": 0,
   "t": 15.3,
   "tend": 19.3,
   "en": "",
   "ko": "1927년 5월 20일 아침, 혼자 이륙"
  },
  {
   "who": 0,
   "t": 19.3,
   "tend": 23.3,
   "en": "",
   "ko": "목적지는 대서양 건너 파리"
  },
  {
   "who": 0,
   "t": 23.3,
   "tend": 27.0,
   "en": "",
   "ko": "중간 착륙 없이, 혼자서 끝까지"
  },
  {
   "who": 0,
   "t": 27.2,
   "tend": 30.1,
   "en": "The next day in France a vast multitude gathered",
   "ko": "다음 날 프랑스, 엄청난 인파가 모였다"
  },
  {
   "who": 0,
   "t": 30.1,
   "tend": 33.0,
   "en": "at Le Bourget Field for word of [lone flyer's] fate.",
   "ko": "르부르제 비행장에서 홀로 나선 비행사의 소식을 기다리며."
  },
  {
   "who": 0,
   "t": 33.2,
   "tend": 36.5,
   "en": "He lands! — and the mass of humanity",
   "ko": "그가 내렸다! 그러자 인파가"
  },
  {
   "who": 0,
   "t": 36.5,
   "tend": 40.0,
   "en": "crushes all before it in rush to reach new conqueror of the air.",
   "ko": "하늘의 새 정복자에게 닿으려 모든 걸 밀어젖혔다."
  },
  {
   "who": 0,
   "t": 40.2,
   "tend": 44.0,
   "en": "",
   "ko": "하루아침에 세계의 영웅이 된 25살 청년"
  },
  {
   "who": 0,
   "t": 44.2,
   "tend": 46.2,
   "en": "Treads again the soil of his native land",
   "ko": "다시 고국 땅을 밟다,"
  },
  {
   "who": 0,
   "t": 46.2,
   "tend": 48.0,
   "en": "only three weeks after his [world-thrilling feat]",
   "ko": "세상을 놀라게 한 위업 뒤 단 3주 만에."
  },
  {
   "who": 0,
   "t": 48.2,
   "tend": 53.0,
   "en": "",
   "ko": "돌아온 그를 맞은 환영 인파"
  },
  {
   "who": 0,
   "t": 53.2,
   "tend": 55.6,
   "en": "[The proudest moment of his life]",
   "ko": "그의 인생에서 가장 자랑스러운 순간"
  },
  {
   "who": 0,
   "t": 55.6,
   "tend": 58.05,
   "en": "The President awards him the Distinguished Flying Cross",
   "ko": "대통령이 그에게 수훈비행십자훈장을 수여한다"
  }
 ],
