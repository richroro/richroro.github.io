 "lines": [
  {"who": 0, "at": 7.62, "en": "So you said today, as you often say,", "ko": "오늘도 늘 그렇듯 말씀하셨죠.", "to": 9.85},
  {"who": 0, "at": 9.88, "en": "that you live in Singapore.", "ko": "싱가포르에 산다고요.", "to": 11.75},
  {"who": 0, "at": 11.9, "en": "Of what nation are you a citizen?", "ko": "어느 나라 시민입니까?", "to": 14.3},
  {"who": 1, "at": 14.44, "en": "Singapore.", "ko": "싱가포르입니다.", "to": 15.35},
  {"who": 0, "at": 15.42, "en": "Are you a citizen of any other nation?", "ko": "다른 나라 시민권도 있습니까?", "to": 17.4},
  {"who": 1, "at": 17.48, "en": "No, Senator.", "ko": "없습니다, 의원님.", "to": 18.05},
  {"who": 0, "at": 28.86, "en": "Do you have any other passports from any other nations?", "ko": "다른 나라 여권도 있습니까?", "to": 31.5},
  {"who": 1, "at": 31.58, "en": "No, Senator.", "ko": "없습니다, 의원님.", "to": 32.38},
  {"who": 0, "at": 32.42, "en": "Your wife is an American citizen,", "ko": "부인은 미국 시민이고", "to": 33.88},
  {"who": 0, "at": 33.92, "en": "your children are American citizens?", "ko": "자녀들도 미국 시민이죠?", "to": 35.38},
  {"who": 1, "at": 35.44, "en": "That's correct.", "ko": "맞습니다.", "to": 36.02},
  {"who": 0, "at": 36.08, "en": "Have you ever applied for American citizenship?", "ko": "미국 시민권을 신청한 적은요?", "to": 38.32},
  {"who": 1, "at": 38.38, "en": "No, not yet.", "ko": "아뇨, 아직은 안 했습니다.", "to": 40.0},
  {"who": 0, "at": 40.18, "en": "Okay. Have you ever been a member of the Chinese Communist Party?", "ko": "네. 중국 공산당원이었던 적이 있습니까?", "to": 45.45},
  {"who": 1, "at": 45.55, "en": "Senator, [I'm Singaporean]. No.", "ko": "의원님, 저는 싱가포르인입니다. 아닙니다.", "to": 47.62},
  {"who": 0, "at": 47.71, "en": "Have you ever been associated or affiliated", "ko": "중국 공산당과 관련되거나", "to": 49.22},
  {"who": 0, "at": 49.27, "en": "with the Chinese Communist Party?", "ko": "연계된 적은 있습니까?", "to": 50.75},
  {"who": 1, "at": 50.81, "en": "No, Senator. Again, [I'm Singaporean].", "ko": "아닙니다. 거듭 말씀드리지만 싱가포르인입니다.", "to": 52.68}
