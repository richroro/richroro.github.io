 "lines": [
  {"who": 0, "t": 0.15, "tend": 3.6, "ko": "길이 3m 작은 쌍동선이 뒤집혔다 🌊", "en": ""},
  {"who": 0, "t": 3.7, "tend": 7.4, "ko": "두 남자가 바다에… 위치 신호기(PLB) 조난 신호 수신", "en": ""},
  {"who": 0, "t": 7.5, "tend": 11.2, "ko": "이미 떠 있던 해안경비대 비행기·헬기가 방향을 틀었다", "en": ""},
  {"who": 0, "t": 11.3, "tend": 15.0, "ko": "할레이와 앞바다 18.5km, 뒤집힌 배 옆에서 발견", "en": ""},
  {"who": 0, "t": 15.1, "tend": 17.8, "ko": "헬기에서 바스켓을 내려 끌어올린다", "en": ""},
  {"who": 0, "at": 56.85, "to": 59.2, "ko": "생존자, 문 앞까지 올라왔다", "en": "Survivor is coming up to the door."},
  {"who": 0, "t": 21.1, "tend": 25.1, "ko": "두 사람 모두 헬기로 기지까지 🚁", "en": ""},
  {"who": 0, "t": 25.2, "tend": 28.9, "ko": "다친 사람은 없었다 🙏", "en": ""},
  {"who": 0, "at": 68.85, "to": 71.6, "ko": "생존자, 기내로", "en": "…survivor into the cabin."},
  {"who": 0, "at": 2.85, "to": 3.9, "ko": "고마워요", "en": "Thank you."},
  {"who": 0, "t": 35.0, "tend": 39.5, "ko": "헬기에서 내린 뒤, 구조된 남자가 한 말", "en": ""},
  {"who": 0, "at": 8.6, "to": 11.75, "ko": "우리 아빠가 해안경비대였어요. 마스터 치프 잠수사였죠", "en": "Dude, my dad was in the Coast Guard, he was a Master Chief Diver,"},
  {"who": 0, "at": 11.8, "to": 14.2, "ko": "그래서 해안경비대가 정말 좋아요", "en": "and I love the Coast Guard so much,"},
  {"who": 0, "at": 14.22, "to": 16.4, "ko": "여러분이 하는 일, 정말 고마워요", "en": "so thank you guys for doing what you do,"},
  {"who": 0, "at": 16.45, "to": 18.25, "ko": "여러분 아니었으면 저 지금 여기 없어요", "en": "because I wouldn't be here right now without you guys."},
  {"who": 0, "at": 18.28, "to": 20.3, "ko": "진짜로요", "en": "Seriously. Straight up."}
 ],
