 "lines": [
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 332.14,
   "en": "He said that he was willing to work for [$7.25 or less].",
   "ko": "시급 7.25달러, 아니 그 이하도 괜찮다고 했어요.",
   "to": 336.9
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 337.46,
   "en": "The [\"or less\"] caught our attention.",
   "ko": "'그 이하'라는 말이 마음에 걸렸어요.",
   "to": 339.95
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 340.42,
   "en": "Along the way in his life, someone had made him feel like he was [worth less].",
   "ko": "누군가 그를 '덜 가치 있는 사람'으로 느끼게 만든 거예요.",
   "to": 345.15
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 145.0,
   "en": "When I lost my vision at the age of [15],",
   "ko": "저는 15살에 시력을 잃었어요.",
   "to": 147.4
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 185.28,
   "en": "I was told that I would [never] be able to have competitive employment.",
   "ko": "제대로 된 직장은 절대 못 가질 거란 말도 들었어요.",
   "to": 189.25
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 195.56,
   "en": "On a particularly bad day, my [dad] tried to cheer me up by playing a game.",
   "ko": "유난히 힘든 날, 아빠가 기운 내라며 게임을 하자고 했어요.",
   "to": 199.55
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 201.4,
   "en": "what I would do if I could [create a job] since I didn't find one.",
   "ko": "일자리를 못 구하니, 직접 만든다면 뭘 할지요.",
   "to": 205.3
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 205.84,
   "en": "We had come up with a [coffee business].",
   "ko": "그렇게 떠올린 게 커피 사업이었어요.",
   "to": 207.65
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 360.22,
   "en": "We made sure that he knew that he [had worth],",
   "ko": "그가 가치 있는 사람이란 걸 꼭 알게 했어요,",
   "to": 363.38
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 364.14,
   "en": "that he would be starting at [$9] an hour.",
   "ko": "시급은 9달러부터 시작한다고요.",
   "to": 366.16
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 382.6,
   "en": "He's also risen in our business and is now",
   "ko": "회사에서 점점 자리를 잡아서, 지금은",
   "to": 385.6
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 387.9,
   "en": "a [team leader] and is teaching other employees.",
   "ko": "팀장이 돼서 다른 직원들을 가르쳐요.",
   "to": 390.65
  },
  {
   "who": 0,
   "src": "hope/willman.mp4",
   "at": 391.02,
   "en": "All of this because someone [believed in him].",
   "ko": "누군가 그를 믿어 줬다는 것, 그거 하나 때문에요.",
   "to": 393.9
  }
 ],
 "keys": [
