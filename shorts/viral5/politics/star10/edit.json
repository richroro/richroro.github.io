 "lines": [
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 30.18,
   "en": "I have a distinct memory of her standing on the [porch]",
   "ko": "현관에 서 계시던 어머니 모습이 또렷해요."
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 34.78,
   "en": "as my father drove me to the doctor.",
   "ko": "아버지가 저를 태우고 병원에 가던 날이요.",
   "to": 36.9
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 38.36,
   "en": "The [fear and desperation] in her eyes",
   "ko": "그 눈에 담긴 두려움과 절망은"
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 42.5,
   "en": "remains an indelible image in my mind.",
   "ko": "지금도 지워지지 않아요.",
   "to": 45.5
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 11.96,
   "en": "I was diagnosed with type 1 diabetes when I was [11 years old].",
   "ko": "저는 11살에 1형 당뇨 진단을 받았어요.",
   "to": 16.5
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 85.64,
   "en": "I was kept in a hospital where I learned to inject [oranges]",
   "ko": "병원에 지내면서 오렌지에 주사 놓는 걸 배웠어요."
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 89.82,
   "en": "with insulin syringes until I was [brave enough] to try it myself.",
   "ko": "제 몸에 놓을 용기가 생길 때까지요.",
   "to": 93.8
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 129.22,
   "en": "When I was [16], I left home to pursue my show business dream.",
   "ko": "16살에 연예계의 꿈을 좇아 집을 떠났어요.",
   "to": 134.1
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 135.12,
   "en": "I was a folk singer, [dishwasher],",
   "ko": "포크 가수에 접시닦이에,"
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 137.8,
   "en": "played tiny parts on TV shows and movies.",
   "ko": "TV와 영화 단역도 했죠.",
   "to": 140.9
  },
  {
   "who": 0,
   "src": "celeb/garber.mp4",
   "at": 156.24,
   "en": "My [determination] and will kept me from just [giving up].",
   "ko": "끝까지 버티게 해 준 건 제 결심과 의지였어요.",
   "to": 161.1
  }
 ],
 "keys": [
