 "lines": [
  {"who": 0, "t": 0.2, "tend": 2.9, "ko": "샘플 가방을 챙기다가…", "en": ""},
  {"who": 0, "t": 3.0, "tend": 5.5, "ko": "꽈당! 🤣", "en": ""},
  {"who": 0, "at": 43.0, "to": 45.6, "ko": "흙 좀 묻어도 괜찮죠, 여러분?", "en": "You don't mind a little dirt here and there, do you, gang?"},
  {"who": 0, "t": 8.9, "tend": 11.8, "ko": "겨우 일어났는데…", "en": ""},
  {"who": 0, "t": 11.9, "tend": 15.0, "ko": "또 넘어짐 🤣", "en": ""},
  {"who": 2, "at": 91.9, "to": 94.8, "ko": "진, 가서 저 ‘발레리나’ 좀 도와줄래요? 🩰", "en": "Hey, Gene, would you go over and help Twinkletoes, please?"},
  {"who": 1, "at": 104.85, "to": 106.05, "ko": "도와줄까, 잭? 금방 갈게.", "en": "Want some help, Jack? I'll be there."},
  {"who": 0, "at": 106.1, "to": 107.75, "ko": "아뇨! 도움 필요 없어요.", "en": "No! I don't need any help."},
  {"who": 3, "src": "apollo/as16_jsc580_salute.mp4", "at": 12.0, "to": 15.1, "ko": "이리 나와서 경례 한번 해 봐요. 해군식으로 크게!", "en": "Come on out here and give me a salute. Big Navy salute."},
  {"who": 3, "src": "apollo/as16_jsc580_salute.mp4", "at": 16.45, "to": 17.9, "ko": "땅에서 붕~ 한 번 더!", "en": "Off the ground. Once more."},
  {"who": 3, "src": "apollo/as16_jsc580_salute.mp4", "at": 19.3, "to": 20.0, "ko": "됐어요!", "en": "There we go."},
  {"who": 3, "src": "apollo/as16_jsc580_grandprix.mp4", "at": 9.1, "to": 11.0, "ko": "와, 완전 통통 튀네!", "en": "Man, you are really bouncing!"},
  {"who": 5, "src": "apollo/as16_jsc580_grandprix.mp4", "at": 14.2, "to": 15.9, "ko": "바퀴가 땅에 닿긴 해요?", "en": "Is he on the ground at all..."},
  {"who": 3, "src": "apollo/as16_jsc580_grandprix.mp4", "at": 19.9, "to": 22.1, "ko": "바퀴 두 개쯤만 땅에 붙어 있어요.", "en": "He's got about two wheels on the ground."},
  {"who": 3, "src": "apollo/as16_jsc580_grandprix.mp4", "at": 31.6, "to": 35.6, "ko": "네 바퀴 전부 흙먼지를 수탉 꼬리처럼 뿜어요.", "en": "There's a big rooster tail out of all four wheels."},
  {"who": 3, "src": "apollo/as16_jsc580_grandprix.mp4", "at": 35.7, "to": 39.9, "ko": "돌 때마다 미끄러져요. 뒤가 눈길처럼 확 빠지네요.", "en": "And as he turns, he skids. The back end breaks loose just like on snow."},
  {"who": 3, "src": "apollo/as16_jsc580_grandprix.mp4", "at": 50.4, "to": 53.9, "ko": "인디 500도 이런 드라이버는 처음 볼걸요! 🏁", "en": "Man, I'll tell you, Indy's never seen a driver like this."}
 ],
