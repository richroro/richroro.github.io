 "lines": [
  {"who": 0, "at": 20.38, "en": "How big a deal was DeepSeek?", "ko": "딥시크, 얼마나 큰일이었습니까?", "to": 22.2},
  {"who": 0, "at": 22.34, "en": "Is it a major, seismic, shocking development from China?", "ko": "중국에서 나온 엄청나고 충격적인 사건인가요?", "to": 27.3},
  {"who": 0, "at": 27.4, "en": "Is it not that big a deal?", "ko": "별일 아닌가요?", "to": 28.85},
  {"who": 0, "at": 28.9, "en": "Is it somewhere in between…", "ko": "아니면 그 중간쯤인가요?", "to": 30.38},
  {"who": 1, "at": 34.7, "en": "[Not a huge deal].", "ko": "별일 아닙니다.", "to": 36.25},
  {"who": 1, "at": 36.3, "en": "There are two things about DeepSeek.", "ko": "딥시크에 관해선 두 가지가 있어요.", "to": 37.75},
  {"who": 1, "at": 37.8, "en": "One is that they made a good open source model,", "ko": "하나는 좋은 오픈소스 모델을 만든 것,", "to": 40.4},
  {"who": 1, "at": 40.46, "en": "and the other is that they made a consumer app", "ko": "다른 하나는 소비자용 앱을 만든 거죠.", "to": 42.4},
  {"who": 1, "at": 42.44, "en": "that for the first time briefly surpassed ChatGPT", "ko": "그 앱이 처음으로 잠깐 챗GPT를 제치고", "to": 45.25},
  {"who": 1, "at": 45.28, "en": "as the most downloaded AI tool.", "ko": "가장 많이 내려받은 AI 도구가 됐어요.", "to": 47.3},
  {"who": 2, "at": 85.35, "en": "I would say it's [somewhere in between], Chairman Cruz.", "ko": "저는 그 중간쯤이라고 봅니다, 위원장님.", "to": 89.7},
  {"who": 2, "at": 100.68, "en": "American models are clearly the best by far.", "ko": "미국 모델이 단연 최고인 건 분명합니다.", "to": 103.4},
  {"who": 2, "at": 103.49, "en": "However, when you have constraints that are placed,", "ko": "하지만 제약이 걸리면", "to": 105.9},
  {"who": 2, "at": 105.97, "en": "there are [other ways of doing things].", "ko": "다른 방법들이 생기는 겁니다.", "to": 107.2}
 ],
