 "lines": [
  {
   "who": 1,
   "at": 176.46,
   "en": "Jesse, what are your immediate plans?",
   "ko": "제시, 이제 계획이 뭔가요?"
  },
  {
   "who": 0,
   "at": 178.24,
   "en": "My immediate plans now are to return to Ohio State University",
   "ko": "오하이오 주립대로 돌아가서"
  },
  {
   "who": 0,
   "at": 180.5,
   "en": "and finish my last year in college.",
   "ko": "대학 마지막 1년을 마치는 거예요.",
   "to": 183.3
  },
  {
   "who": 0,
   "at": 183.86,
   "en": "And of course, that's been my [ambition] for the past four years,",
   "ko": "지난 4년 동안 제 꿈이 그거였거든요."
  },
  {
   "who": 0,
   "at": 187.94,
   "en": "to get a [college degree].",
   "ko": "대학 졸업장을 받는 것."
  },
  {
   "who": 0,
   "at": 189.06,
   "en": "And I think it's my opportunity now,",
   "ko": "이제 그 기회가 온 것 같아요."
  },
  {
   "who": 0,
   "at": 190.34,
   "en": "and that's where I'm going back to finish it.",
   "ko": "그래서 돌아가서 끝내려고요.",
   "to": 191.95
  },
  {
   "who": 1,
   "at": 58.74,
   "en": "Will you turn professional?",
   "ko": "프로로 전향할 건가요?"
  },
  {
   "who": 0,
   "at": 61.1,
   "en": "Turn professional? I do not know.",
   "ko": "프로 전향이요? 모르겠어요."
  },
  {
   "who": 0,
   "at": 62.68,
   "en": "As I said before, I have another year in school,",
   "ko": "말했듯이 학교가 1년 남았고"
  },
  {
   "who": 0,
   "at": 64.48,
   "en": "and I haven't any plans",
   "ko": "프로 전향 계획은"
  },
  {
   "who": 0,
   "at": 65.82,
   "en": "about turning professional whatsoever.",
   "ko": "전혀 없습니다.",
   "to": 67.2
  },
  {
   "who": 1,
   "at": 27.6,
   "en": "Jesse, what was your [biggest thrill] in Germany?",
   "ko": "독일에서 가장 짜릿했던 순간은요?"
  },
  {
   "who": 0,
   "at": 30.08,
   "en": "Well, my biggest thrill was when I won the 100-meter dash,",
   "ko": "100m 달리기에서 우승했을 때죠."
  },
  {
   "who": 0,
   "at": 33.1,
   "en": "and the American flag went up,",
   "ko": "성조기가 올라가고"
  },
  {
   "who": 0,
   "at": 34.82,
   "en": "and they were playing the Star-Spangled Banner.",
   "ko": "미국 국가가 울려 퍼졌죠."
  },
  {
   "who": 0,
   "at": 36.34,
   "en": "And we stood up there in salute,",
   "ko": "거기 서서 경례하는데"
  },
  {
   "who": 0,
   "at": 37.36,
   "en": "and it was really a [marvelous] thing.",
   "ko": "정말 굉장했어요."
  },
  {
   "who": 1,
   "at": 38.62,
   "en": "That was very copacetic.",
   "ko": "멋지네요."
  },
  {
   "who": 1,
   "at": 39.82,
   "en": "Now, how did you like the German meals?",
   "ko": "독일 음식은 어땠어요?"
  },
  {
   "who": 0,
   "at": 42.02,
   "en": "Well, the German meals were fine,",
   "ko": "음식은 괜찮았는데"
  },
  {
   "who": 0,
   "at": 43.3,
   "en": "but it took a little bit [too long] to get them.",
   "ko": "나오는 데 너무 오래 걸렸어요.",
   "to": 44.9
  }
 ],
