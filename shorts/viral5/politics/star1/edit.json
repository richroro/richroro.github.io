 "lines": [
  {
   "who": 0,
   "at": 16.88,
   "en": "Thank you for the opportunity to testify today,",
   "ko": "오늘 증언할 기회를 주셔서 감사합니다.",
   "to": 19.1
  },
  {
   "who": 0,
   "at": 19.28,
   "en": "and for the opportunity for me to be called [an expert] at something,",
   "ko": "제가 뭔가의 '전문가'로 불릴 기회도요."
  },
  {
   "who": 0,
   "at": 22.08,
   "en": "because that's cool.",
   "ko": "그거 멋지잖아요.",
   "to": 23.1
  },
  {
   "who": 0,
   "at": 24.6,
   "en": "I don't know if you know who I am at all.",
   "ko": "저를 아시는지 모르겠네요."
  },
  {
   "who": 0,
   "at": 26.86,
   "en": "You told me you never saw [Knocked Up], Chairman,",
   "ko": "위원장님은 제 영화 '사고친 후에'를 안 보셨다던데"
  },
  {
   "who": 0,
   "at": 29.18,
   "en": "so it's a little insulting.",
   "ko": "좀 섭섭하네요.",
   "to": 32.1
  },
  {
   "who": 0,
   "at": 94.46,
   "en": "Soon after this trip, at [55 years old],",
   "ko": "처음 인사드린 그 여행 직후, 55세에"
  },
  {
   "who": 0,
   "at": 97.86,
   "en": "Lauren's mother was diagnosed with [early onset Alzheimer's].",
   "ko": "장모님은 조기 발병 알츠하이머 진단을 받았습니다.",
   "to": 101.35
  },
  {
   "who": 0,
   "at": 132.76,
   "en": "After forgetting who she and her loved ones were,",
   "ko": "자신과 가족이 누군지 잊은 뒤"
  },
  {
   "who": 0,
   "at": 135.24,
   "en": "my mother-in-law, [a teacher for 35 years],",
   "ko": "35년 동안 교사였던 장모님은"
  },
  {
   "who": 0,
   "at": 138.16,
   "en": "then forgot how to speak, feed herself, dress herself,",
   "ko": "말하는 법, 혼자 먹는 법, 옷 입는 법,"
  },
  {
   "who": 0,
   "at": 141.66,
   "en": "and go to the bathroom herself,",
   "ko": "혼자 화장실 가는 법까지 잊으셨습니다."
  },
  {
   "who": 0,
   "at": 143.06,
   "en": "[all by the age of 60].",
   "ko": "그게 다 예순 무렵의 일이에요.",
   "to": 145.1
  },
  {
   "who": 0,
   "at": 359.84,
   "en": "I dream of a day when my charity is [no longer necessary],",
   "ko": "제 자선단체가 더는 필요 없는 날을 꿈꿉니다."
  },
  {
   "who": 0,
   "at": 362.88,
   "en": "and I can go back to being a lazy,",
   "ko": "그러면 저는 다시 게으르고"
  },
  {
   "who": 0,
   "at": 364.74,
   "en": "[self-involved man-child] I was meant to be.",
   "ko": "제멋대로인 철부지 어른으로 돌아갈 수 있겠죠.",
   "to": 367.3
  }
 ],
 "keys": [
  "전문가",
