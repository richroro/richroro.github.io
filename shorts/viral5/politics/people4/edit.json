 "lines": [
  {
   "who": 0,
   "at": 34.06,
   "src": "apollo/restored_120.mp4",
   "en": "That's [one small step] for man,",
   "ko": "한 사람에게는 작은 한 걸음이지만,"
  },
  {
   "who": 0,
   "at": 39.48,
   "src": "apollo/restored_120.mp4",
   "en": "[one giant leap] for mankind.",
   "ko": "인류에게는 거대한 도약입니다.",
   "to": 42.8
  },
  {
   "who": 0,
   "t": 9.45,
   "tend": 11.6,
   "en": "",
   "ko": "그런데 그날 전 세계가 TV로 본 화면은"
  },
  {
   "who": 0,
   "t": 11.6,
   "tend": 13.7,
   "en": "",
   "ko": "실제 달에서 온 원본보다 훨씬 흐렸습니다."
  },
  {
   "who": 0,
   "t": 13.85,
   "tend": 16.0,
   "en": "",
   "ko": "달 카메라 신호는 TV와 방식이 달라서"
  },
  {
   "who": 0,
   "t": 16.0,
   "tend": 18.1,
   "en": "",
   "ko": "방송용으로 바꾸면서 화질이 떨어졌거든요."
  },
  {
   "who": 0,
   "t": 18.25,
   "tend": 20.4,
   "en": "",
   "ko": "선명한 원본 신호는 추적소 3곳이"
  },
  {
   "who": 0,
   "t": 20.4,
   "tend": 22.5,
   "en": "",
   "ko": "1인치 테이프 45개에 따로 녹화했습니다."
  },
  {
   "who": 0,
   "t": 22.65,
   "tend": 24.8,
   "en": "",
   "ko": "그런데 수년 동안 찾았지만"
  },
  {
   "who": 0,
   "t": 24.8,
   "tend": 26.9,
   "en": "",
   "ko": "그 테이프는 어디에도 없었습니다."
  },
  {
   "who": 0,
   "t": 27.05,
   "tend": 29.2,
   "en": "",
   "ko": "NASA 보고서: 80년대 초 테이프가 모자라자"
  },
  {
   "who": 0,
   "t": 29.2,
   "tend": 31.3,
   "en": "",
   "ko": "지우고 다시 쓴 것으로 보인다."
  },
  {
   "who": 0,
   "t": 31.45,
   "tend": 33.6,
   "en": "",
   "ko": "그래서 NASA는 남아 있던 방송 녹화본 중"
  },
  {
   "who": 0,
   "t": 33.6,
   "tend": 35.7,
   "en": "",
   "ko": "가장 좋은 것을 디지털로 복원했습니다(2009)."
  },
  {
   "who": 0,
   "t": 35.85,
   "tend": 38.0,
   "en": "",
   "ko": "달 착륙은 진짜,"
  },
  {
   "who": 0,
   "t": 38.0,
   "tend": 40.7,
   "en": "",
   "ko": "사라진 건 '원본 백업 테이프'였습니다."
  }
 ],
