 "lines": [
  {
   "who": 0,
   "at": 4.45,
   "to": 6.8,
   "en": "But why, some say, the Moon?",
   "ko": "그런데 왜 달이냐고 하는 사람들이 있습니다."
  },
  {
   "who": 0,
   "at": 7.2,
   "to": 9.7,
   "en": "Why choose this as our goal?",
   "ko": "왜 그걸 목표로 삼느냐고요."
  },
  {
   "who": 0,
   "at": 10.1,
   "to": 14.3,
   "en": "And they may well ask, why climb the highest mountain?",
   "ko": "이렇게도 묻겠죠. 왜 가장 높은 산에 오르느냐?"
  },
  {
   "who": 0,
   "at": 14.76,
   "to": 18.3,
   "en": "Why, 35 years ago, fly the Atlantic?",
   "ko": "35년 전엔 왜 비행기로 대서양을 건넜느냐?"
  },
  {
   "who": 0,
   "at": 18.55,
   "to": 20.7,
   "en": "Why does Rice play Texas?",
   "ko": "라이스대는 왜 텍사스대와 경기를 하느냐?"
  },
  {
   "who": 0,
   "at": 20.76,
   "to": 23.3,
   "en": "We choose to go to the Moon.",
   "ko": "우리는 달에 가기로 했습니다."
  },
  {
   "who": 0,
   "at": 23.46,
   "to": 25.6,
   "en": "We choose to go to the Moon…",
   "ko": "우리는 달에 가기로 했습니다…"
  },
  {
   "who": 0,
   "at": 31.4,
   "to": 34.5,
   "en": "We choose to go to the Moon in this decade",
   "ko": "우리는 이번 10년 안에 달에 가기로 했고"
  },
  {
   "who": 0,
   "at": 34.54,
   "to": 35.95,
   "en": "and do the other things,",
   "ko": "다른 일들도 하기로 했습니다."
  },
  {
   "who": 0,
   "at": 36.06,
   "to": 39.9,
   "en": "not because they are easy, [but because they are hard,]",
   "ko": "쉬워서가 아니라 어렵기 때문입니다."
  },
  {
   "who": 0,
   "at": 40.04,
   "to": 44.7,
   "en": "because that goal will serve to organize and measure",
   "ko": "그 목표가 우리의 최고의 에너지와 기술을"
  },
  {
   "who": 0,
   "at": 44.76,
   "to": 47.3,
   "en": "the best of our energies and skills,",
   "ko": "한데 모으고 가늠하게 해 줄 것이기 때문이며,"
  },
  {
   "who": 0,
   "at": 47.5,
   "to": 51.2,
   "en": "because that challenge is one that we're willing to accept,",
   "ko": "그 도전은 우리가 기꺼이 받아들일 도전이고,"
  },
  {
   "who": 0,
   "at": 51.3,
   "to": 54.3,
   "en": "one we are unwilling to postpone,",
   "ko": "미루고 싶지 않은 도전이며,"
  },
  {
   "who": 0,
   "at": 54.6,
   "to": 56.1,
   "en": "and one we intend to win,",
   "ko": "꼭 이기려는 도전이기 때문입니다."
  },
  {
   "who": 0,
   "at": 56.18,
   "to": 57.6,
   "en": "and the others, too.",
   "ko": "다른 일들도 마찬가지고요."
  },
  {
   "who": 1,
   "src": "speech/a11_hq194_landing.mp4",
   "at": 13.3,
   "to": 15.0,
   "en": "Contact light.",
   "ko": "접지 표시등 켜짐."
  },
  {
   "who": 1,
   "src": "speech/a11_hq194_landing.mp4",
   "at": 15.05,
   "to": 16.3,
   "en": "Okay, engine stop.",
   "ko": "좋아, 엔진 정지."
  },
  {
   "who": 2,
   "src": "speech/a11_hq194_landing.mp4",
   "at": 16.3,
   "to": 17.9,
   "en": "We copy you down, Eagle.",
   "ko": "착륙 확인했다, 이글."
  },
  {
   "who": 3,
   "src": "speech/a11_eagle_landed_window.mp4",
   "at": 0.6,
   "to": 5.6,
   "en": "Tranquility Base here. [The Eagle has landed.]",
   "ko": "여기는 고요의 기지. 이글호가 착륙했다."
  }
 ],
