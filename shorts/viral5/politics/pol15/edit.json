 "lines": [
  {
   "who": 0,
   "text": "이거 특혜라고 볼 수 있지 않을까요?"
  },
  {
   "who": 1,
   "text": "충분히 그렇게 볼 수도 있겠지만",
   "at": 21.94
  },
  {
   "who": 1,
   "text": "4개사의 몇 년간의 희생을 담보로 시작되는 프로젝트여서"
  },
  {
   "who": 0,
   "text": "여기 국가 지원이 필요 없거든요.",
   "at": 33.6
  },
  {
   "who": 0,
   "text": "이미 잘하고 있지 않습니까, 우리 K팝."
  },
  {
   "who": 0,
   "text": "왜 4개 회사에만 특급 대우를 해야 할까요?",
   "at": 37.65
  },
  {
   "who": 1,
   "text": "이 페노메논 행사 때 4개사의 대표 가수들이",
   "at": 305.46
  },
  {
   "who": 1,
   "text": "이걸 안 하고 따로 공연을 하면"
  },
  {
   "who": 1,
   "text": "두 배 세 배의 수익을 냅니다. 모든 회사가."
  },
  {
   "who": 1,
   "text": "이걸 희생하게 하는 게 너무 힘들었습니다."
  },
  {
   "who": 1,
   "text": "YG한테 빌고 SM한테 빌고 하이브한테 빌고"
  },
  {
   "who": 1,
   "text": "그래서 당장 굉장히 몇백억대의 손해가 일어날 일입니다."
  },
  {
   "who": 1,
   "text": "앞으로 몇 년 안에."
  },
  {
   "who": 1,
   "text": "그러나 장기 비전을 보고"
  },
  {
   "who": 1,
   "text": "또 이게 우리나라에 파생시킬 효과"
  },
  {
   "who": 1,
   "text": "또 다른 산업에 전이될 효과 때문에 다들 하기로 큰 결심을 했고"
  },
  {
   "who": 1,
   "text": "이 행사를 안 하고",
   "at": 336.5
  },
  {
   "who": 1,
   "text": "각각 회사들이 그 시간에 각 가수의 공연을 하면"
  },
  {
   "who": 1,
   "text": "훨씬 더 큰 돈을 법니다."
  },
  {
   "who": 1,
   "text": "그래서 특혜를 받는다고 하긴 조금 그렇습니다.",
   "at": 342.55
  }
 ],
