 "lines": [
  {
   "who": 0,
   "at": 512.16,
   "en": "And from my scientific heart, I ask,",
   "ko": "과학자의 마음으로 묻겠습니다.",
   "to": 514.4
  },
  {
   "who": 0,
   "at": 514.92,
   "en": "how much would you pay [for the universe]?",
   "ko": "우주에는 얼마를 내시겠습니까?",
   "to": 517.6
  },
  {
   "who": 0,
   "at": 16.6,
   "en": "I was born [the same week that NASA was founded].",
   "ko": "저는 NASA가 세워진 바로 그 주에 태어났습니다.",
   "to": 20.05
  },
  {
   "who": 0,
   "at": 46.96,
   "en": "If you want to build a ship,",
   "ko": "배를 만들고 싶다면 (생텍쥐페리)"
  },
  {
   "who": 0,
   "at": 48.98,
   "en": "don't drum up people to collect wood",
   "ko": "사람들을 불러 나무를 해 오게 하지 말고"
  },
  {
   "who": 0,
   "at": 51.58,
   "en": "and don't assign them tasks and work,",
   "ko": "일과 임무를 나눠 주지도 마라."
  },
  {
   "who": 0,
   "at": 54.72,
   "en": "but rather teach them to long for [the endless immensity of the sea].",
   "ko": "대신 끝없이 넓은 바다를 그리워하게 하라.",
   "to": 59.5
  },
  {
   "who": 0,
   "at": 725.6,
   "en": "I think any nation at any time has the capacity [to create a hero].",
   "ko": "어느 나라든 언제든 영웅을 만들 수 있다고 봅니다.",
   "to": 730.2
  },
  {
   "who": 0,
   "at": 730.44,
   "en": "It just has to have ambitions with goals set",
   "ko": "목표를 세운 큰 꿈만 있으면 됩니다."
  },
  {
   "who": 0,
   "at": 733.84,
   "en": "so that one among us then steps forward, accepts those risks.",
   "ko": "그러면 우리 중 누군가 위험을 안고 앞으로 나서죠.",
   "to": 738.5
  },
  {
   "who": 0,
   "at": 738.66,
   "en": "Some of those who go forward don't come back.",
   "ko": "나섰다가 돌아오지 못하는 사람도 있습니다.",
   "to": 741.05
  },
  {
   "who": 0,
   "at": 745.76,
   "en": "But those who do, who succeed, they get [remembered forever].",
   "ko": "하지만 돌아와 성공한 사람은 영원히 기억됩니다.",
   "to": 749.35
  }
 ],
 "keys": [
  "우주에는",
  "NASA가",
  "바다를",
  "영웅을",
  "영원히"
 ]
}