 "lines": [
  {
   "who": 0,
   "at": 3.72,
   "en": "Some of the most successful people in the world",
   "ko": "세상에서 가장 성공한 사람들 중에는"
  },
  {
   "who": 0,
   "at": 5.8,
   "en": "are the ones who've had [the most failures].",
   "ko": "가장 많이 실패한 사람들이 있습니다.",
   "to": 8.0
  },
  {
   "who": 0,
   "at": 10.2,
   "en": "J.K. Rowling's — who wrote Harry Potter —",
   "ko": "〈해리 포터〉를 쓴 J.K. 롤링,",
   "to": 14.0
  },
  {
   "who": 0,
   "at": 14.55,
   "en": "her first Harry Potter book was [rejected 12 times]",
   "ko": "그녀의 첫 해리 포터 책은 12번 거절당했습니다."
  },
  {
   "who": 0,
   "at": 18.62,
   "en": "before it was finally published.",
   "ko": "그러고 나서야 마침내 출간됐죠.",
   "to": 20.5
  },
  {
   "who": 0,
   "at": 21.9,
   "en": "Michael Jordan was cut from his high school basketball team.",
   "ko": "마이클 조던은 고등학교 농구팀에서 탈락했습니다.",
   "to": 25.2
  },
  {
   "who": 0,
   "at": 26.2,
   "en": "He lost hundreds of games",
   "ko": "그는 수백 경기에서 졌고"
  },
  {
   "who": 0,
   "at": 27.88,
   "en": "and missed thousands of shots during his career.",
   "ko": "선수 생활 내내 슛을 수천 번 놓쳤습니다."
  },
  {
   "who": 0,
   "at": 30.56,
   "en": "But he once said,",
   "ko": "하지만 그는 이렇게 말한 적이 있죠."
  },
  {
   "who": 0,
   "at": 32.1,
   "en": "“I have failed over and over and over again in my life.",
   "ko": "“저는 살면서 실패하고, 실패하고, 또 실패했습니다."
  },
  {
   "who": 0,
   "at": 35.1,
   "en": "And that's why I succeed.”",
   "ko": "그래서 성공하는 겁니다.”",
   "to": 37.3
  },
  {
   "who": 0,
   "at": 39.42,
   "en": "These people succeeded because they understood",
   "ko": "이 사람들은 이걸 알았기에 성공했습니다."
  },
  {
   "who": 0,
   "at": 42.75,
   "en": "that you can't let your failures define you —",
   "ko": "실패가 여러분을 규정하게 두면 안 되고"
  },
  {
   "who": 0,
   "at": 45.55,
   "en": "you have to let your failures [teach you].",
   "ko": "실패가 여러분을 가르치게 해야 한다는 걸요.",
   "to": 48.4
  },
  {
   "who": 0,
   "at": 48.92,
   "en": "You have to let them show you what to do differently the next time.",
   "ko": "다음엔 무엇을 다르게 할지 실패가 알려 주게 하세요.",
   "to": 52.2
  }
 ],
