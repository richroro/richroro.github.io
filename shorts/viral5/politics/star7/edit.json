 "lines": [
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 15.0,
   "en": "So I applied jobs for [30 times], got rejected.",
   "ko": "일자리에 30번 지원했는데 다 떨어졌어요."
  },
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 19.3,
   "en": "I went for a police. They said, \"No, you're not good.\"",
   "ko": "경찰도 지원했는데 \"넌 안 돼\" 하더군요.",
   "to": 22.82
  },
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 23.24,
   "en": "I went to even the KFC.",
   "ko": "KFC에도 갔어요."
  },
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 25.86,
   "en": "When KFC came to China, came to my city,",
   "ko": "KFC가 중국, 우리 도시에 들어왔을 때요."
  },
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 30.92,
   "en": "[24 people] went for the job.",
   "ko": "24명이 지원했는데"
  },
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 33.9,
   "en": "23 people accepted.",
   "ko": "23명이 붙었어요."
  },
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 35.46,
   "en": "I was [the only one] guy.",
   "ko": "저만 떨어졌죠.",
   "to": 36.3
  },
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 47.12,
   "en": "Oh, by the way, I applied for [Harvard] for 10 times,",
   "ko": "아, 그리고 하버드에도 10번 지원했는데"
  },
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 51.24,
   "en": "rejected. 10 times.",
   "ko": "다 떨어졌어요. 10번이요.",
   "to": 54.0
  },
  {
   "who": 0,
   "src": "celeb/jackma_a.mp4",
   "at": 62.98,
   "en": "…I should [go teach there], baby.",
   "ko": "…제가 거기 가서 가르쳐야겠다고요.",
   "to": 64.3
  },
  {
   "who": 0,
   "src": "celeb/jackma_b.mp4",
   "at": 12.64,
   "en": "I don't think in this world a lot of people",
   "ko": "이 세상에 30번 넘게 떨어져 본 사람은"
  },
  {
   "who": 0,
   "src": "celeb/jackma_b.mp4",
   "at": 14.64,
   "en": "be rejected more than 30 times.",
   "ko": "별로 없을 거예요.",
   "to": 16.3
  },
  {
   "who": 0,
   "src": "celeb/jackma_b.mp4",
   "at": 17.58,
   "en": "If we, you know, the only thing, [we never give up].",
   "ko": "중요한 건 단 하나, 절대 포기하지 않는 거예요.",
   "to": 20.2
  },
  {
   "who": 0,
   "src": "celeb/jackma_b.mp4",
   "at": 22.5,
   "en": "We keep on fight, we keep on change ourself.",
   "ko": "계속 싸우고, 계속 자신을 바꾸는 거죠."
  },
  {
   "who": 0,
   "src": "celeb/jackma_b.mp4",
