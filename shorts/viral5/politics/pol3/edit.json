 "lines": [
  {
   "who": 0,
   "text": "어제 종합 결과를 발표를 했죠?",
   "at": 6.75
  },
  {
   "who": 0,
   "text": "하면서 북한이 MDL 이남에 지뢰를 설치했고,",
   "at": 13.25
  },
  {
   "who": 0,
   "text": "거기에 우리 장병이 부상을 당했다, 이렇게 발표를 했습니다."
  },
  {
   "who": 0,
   "text": "그렇죠?"
  },
  {
   "who": 1,
   "text": "예.",
   "at": 20.5
  },
  {
   "who": 0,
   "text": "그럼 이거 도발 아닙니까?",
   "at": 21.4
  },
  {
   "who": 1,
   "text": "예."
  },
  {
   "who": 0,
   "text": "도발 맞죠?"
  },
  {
   "who": 1,
   "text": "예."
  },
  {
   "who": 0,
   "text": "그런데 발표 결과 내용에 도발이라는 말이 빠졌어요."
  },
  {
   "who": 0,
   "text": "누가 뺐습니까?"
  },
  {
   "who": 0,
   "text": "그럼 뭡니까, 이게?",
   "at": 44.35
  },
  {
   "who": 0,
   "text": "그냥 정전 위반입니까?"
  },
  {
   "who": 1,
   "text": "저희가 도발이라고 말씀드렸어요."
  },
  {
   "who": 0,
   "text": "그런데 왜 발표에 포함을 안 시킵니까?"
  },
  {
   "who": 1,
   "text": "그 발표 내용에 다시 한번 보겠습니다"
  },
  {
   "who": 0,
   "text": "도발이 전혀 중요한 워딩이 아니어서 안 한 겁니까?"
  },
  {
   "who": 0,
   "text": "그럼 당연히 도발이면 당연히 포함돼야죠."
  },
  {
   "who": 0,
   "text": "그리고 그 도발에 대한 단호한 대응을 해야 되는 거 아니에요?"
  }
 ],
