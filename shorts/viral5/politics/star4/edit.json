 "lines": [
  {
   "who": 0,
   "src": "celeb/pitt_b.mp4",
   "at": 8.44,
   "en": "Nick, last question.",
   "ko": "닉, 마지막 질문이에요."
  },
  {
   "who": 0,
   "src": "celeb/pitt_b.mp4",
   "at": 9.78,
   "en": "And I need to call on your expertise.",
   "ko": "전문가로서 답해 주셔야 해요."
  },
  {
   "who": 0,
   "src": "celeb/pitt_b.mp4",
   "at": 13.14,
   "en": "Who was more believable, [Clooney or Pitt]?",
   "ko": "누가 더 그럴듯했나요? 클루니, 아니면 피트?",
   "to": 15.4
  },
  {
   "who": 0,
   "src": "celeb/pitt_a.mp4",
   "at": 8.08,
   "en": "Thank you, Nick. Thank you very much.",
   "ko": "고마워요, 닉. 정말 고마워요."
  },
  {
   "who": 0,
   "src": "celeb/pitt_a.mp4",
   "at": 10.78,
   "en": "And now that I have you all the way up at the space station,",
   "ko": "그런데 이렇게 우주정거장까지 연결됐으니"
  },
  {
   "who": 0,
   "src": "celeb/pitt_a.mp4",
   "at": 13.6,
   "en": "[let's talk about me].",
   "ko": "제 얘기 좀 해 볼까요?"
  },
  {
   "who": 0,
   "src": "celeb/pitt_a.mp4",
   "at": 16.52,
   "en": "How did we do?",
   "ko": "저희 영화 어땠어요?"
  },
  {
   "who": 0,
   "src": "celeb/pitt_a.mp4",
   "at": 18.38,
   "en": "How was our [zero G]?",
   "ko": "무중력 연기 어땠나요?",
   "to": 19.5
  },
  {
