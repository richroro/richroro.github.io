 "lines": [
  {
   "who": 0,
   "text": "사법부 독립."
  },
  {
   "who": 0,
   "text": "오늘도 제일 많이 나온 얘기가 사법부 독립이에요."
  },
  {
   "who": 0,
   "text": "사법부 독립 근거 조항이 헌법에 있습니까?"
  },
  {
   "who": 1,
   "text": "사법권에 속한다."
  },
  {
   "who": 1,
   "text": "몇 조인지 기억나지 않습니다만."
  },
  {
   "who": 0,
   "text": "아니, 그건 사법권에 속하는 것과 독립이랑 무슨 상관이에요?"
  },
  {
   "who": 0,
   "text": "사법부 독립의 근거 조항이 헌법에 있냐고요?"
  },
  {
   "who": 1,
   "text": "많은 학자들이 그 조항을 근거로"
  },
  {
   "who": 1,
   "text": "사법부의 독립을 말씀하시는 것 같습니다.",
   "at": 31.1
  },
  {
   "who": 0,
   "text": "아니죠."
  },
  {
   "who": 0,
   "text": "103조에 이렇게 돼 있죠."
  },
  {
   "who": 0,
   "text": "법관은 헌법과 법률에 의하여 그 양심에 따라 독립하여 심판한다."
  },
  {
   "who": 0,
   "text": "이게 사법부 독립의 근거로 지금 인용되고 있는 거 아닌가요?"
  },
  {
   "who": 1,
   "text": "그 조항도 당연히 포함되어 있습니다."
  },
  {
   "who": 0,
   "text": "주어가 뭡니까? 법관은이죠."
  },
  {
   "who": 0,
   "text": "사법부 독립이라고 헌법에 안 써 있어요."
  },
  {
   "who": 0,
   "text": "그런데 왜 대법원장은 사법부 독립, 우리 처장도 사법부 독립이라고 합니까?"
  }
 ],
