 "lines": [
  {
   "who": 0,
   "at": 109.78,
   "en": "I always have [dream, plan, reach].",
   "ko": "저는 늘 '꿈, 계획, 도전'을 지켜요."
  },
  {
   "who": 0,
   "at": 111.1,
   "en": "That's my motto.",
   "ko": "그게 제 좌우명이에요.",
   "to": 112.16
  },
  {
   "who": 0,
   "at": 112.16,
   "en": "Have a dream, figure out a plan how to get there,",
   "ko": "꿈을 갖고, 거기 갈 계획을 세우고,"
  },
  {
   "who": 0,
   "at": 114.72,
   "en": "and reach for it.",
   "ko": "손을 뻗는 거죠.",
   "to": 115.35
  },
  {
   "who": 0,
   "at": 16.72,
   "en": "Water has been such a big part of my life,",
   "ko": "물은 제 인생에서 정말 큰 부분이었어요."
  },
  {
   "who": 0,
   "at": 18.48,
   "en": "an important part of my life.",
   "ko": "아주 중요한 부분이었죠.",
   "to": 19.5
  },
  {
   "who": 0,
   "at": 19.96,
   "en": "And, you know, for me it's an honor and a pleasure",
   "ko": "그래서 저한텐 영광이고 기쁨이에요."
  },
  {
   "who": 0,
   "at": 22.54,
   "en": "to be able to spread the word",
   "ko": "이렇게 알릴 수 있다는 게요."
  },
  {
   "who": 0,
   "at": 23.62,
   "en": "that we need to [conserve as much as we can].",
   "ko": "물을 최대한 아껴야 한다고요.",
   "to": 26.0
  },
  {
   "who": 0,
   "at": 3.44,
   "en": "Even for me, like in the morning,",
   "ko": "저도 아침에"
  },
  {
   "who": 0,
   "at": 4.88,
   "en": "when I do take a shower,",
   "ko": "샤워할 때는"
  },
  {
   "who": 0,
   "at": 6.12,
   "en": "I'm [brushing my teeth in the shower].",
   "ko": "샤워하면서 양치를 해요.",
   "to": 7.85
  },
  {
   "who": 0,
   "at": 76.46,
   "en": "It's so easy that [everybody can do it].",
   "ko": "너무 쉬워서 누구나 할 수 있어요."
  },
  {
   "who": 0,
   "at": 78.68,
   "en": "I mean, I think that's a big easy step that we can all take,",
   "ko": "우리 모두가 할 수 있는 크고 쉬운 한 걸음이죠."
  },
  {
   "who": 0,
   "at": 82.66,
   "en": "every single one of us.",
   "ko": "한 사람도 빠짐없이요.",
   "to": 83.6
  },
  {
   "who": 0,
   "at": 120.22,
   "en": "I mean, [anything is possible], and I believe that.",
   "ko": "무엇이든 가능하다고, 저는 믿어요.",
   "to": 121.78
  },
  {
   "who": 0,
   "at": 125.66,
   "en": "I believed that I could do it,",
   "ko": "저는 할 수 있다고 믿었고"
  },
  {
   "who": 0,
   "at": 127.26,
   "en": "and I [wasn't going to stop until I got it done].",
   "ko": "해낼 때까지 멈출 생각이 없었어요.",
   "to": 130.9
  }
 ],
