 "lines": [
  {
   "who": 0,
   "at": 34.17,
   "en": "Well, I mean, just speaking straight from the heart,",
   "ko": "음, 솔직한 마음을 말씀드리면"
  },
  {
   "who": 0,
   "at": 39.47,
   "en": "on Wednesday during the first countdown,",
   "ko": "수요일 첫 카운트다운(날씨로 취소) 때는"
  },
  {
   "who": 0,
   "at": 41.99,
   "en": "I'd say that my adrenaline was railed at [100%].",
   "ko": "아드레날린이 100%까지 치솟았어요."
  },
  {
   "who": 0,
   "at": 47.75,
   "en": "And when the launch was called off, it went to [0%].",
   "ko": "발사가 취소되자 0%로 뚝 떨어졌고요."
  },
  {
   "who": 0,
   "at": 50.57,
   "en": "I was like, I just basically collapsed",
   "ko": "그냥 쓰러져서"
  },
  {
   "who": 0,
   "at": 53.19,
   "en": "and slept [the longest time I'd slept in probably a year].",
   "ko": "1년 만에 제일 오래 잤어요.",
   "to": 55.9
  },
  {
   "who": 0,
   "at": 57.09,
   "en": "Then oddly enough today, I don't know,",
   "ko": "그런데 이상하게 오늘은"
  },
  {
   "who": 0,
   "at": 58.93,
   "en": "it felt like just the fates were aligned.",
   "ko": "운명이 딱 맞아떨어진 느낌이었어요."
  },
  {
   "who": 0,
   "at": 60.63,
   "en": "And I [didn't feel nervous].",
   "ko": "긴장이 안 되더라고요.",
   "to": 63.9
  }
 ],
 "keys": [
  "100%",
