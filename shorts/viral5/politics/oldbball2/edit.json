 "lines": [
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 8.3, "ko": "1945년 뉴욕, 대학농구 경기 🏀", "to": 10.8},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 10.9, "ko": "NBA? 아직 없음 (전신 리그 1946년 출범)", "to": 13.3},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 4.7, "ko": "오늘의 경기: 세인트존스 대 유타", "to": 7.5},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 24.6, "ko": "3점슛? 없음 (NBA 도입 1979년)", "to": 27.9},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 28.0, "ko": "24초 공격 제한? 이것도 없음 (NBA 1954년)", "to": 31.0},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 31.1, "ko": "이기고 있으면 공만 돌려도 됐다", "to": 34.4},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 81.3, "ko": "관중 표정은 지금이랑 똑같음 😆", "to": 83.5},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 45.6, "ko": "유타대는 1944년 NCAA 우승팀", "to": 48.6},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 48.7, "ko": "그 우승 멤버 와트 미사카 = 훗날 NBA 첫 비백인 선수", "to": 51.9},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 36.7, "ko": "이 영상은 미군 뉴스 영화", "to": 38.8},
  {"who": 0, "src": "oldbasketball/basketball_1945_msg_graded.mp4", "at": 38.9, "ko": "전쟁 중 장병들이 보던 농구 🪖", "to": 40.9},
  {"who": 0, "src": "oldbasketball/basketball_1904_girls_missouri_valley.mp4", "at": 39.6, "ko": "40년 전엔 치마 입고 잔디밭이었는데 😂", "to": 42.5},
