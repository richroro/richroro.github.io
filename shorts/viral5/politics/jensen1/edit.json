 "lines": [
  {
   "who": 0,
   "at": 17.84,
   "en": "NVIDIA [reinvented computing]",
   "ko": "엔비디아는 컴퓨팅을 다시 발명했습니다."
  },
  {
   "who": 0,
   "at": 20.04,
   "en": "for the first time after 60 years.",
   "ko": "60년 만에 처음으로요.",
   "to": 21.7
  },
  {
   "who": 0,
   "at": 43.3,
   "en": "All of the words that we use to describe computers today",
   "ko": "오늘날 컴퓨터를 설명할 때 쓰는 모든 용어는"
  },
  {
   "who": 0,
   "at": 45.5,
   "en": "were really invented in 1964, the year after my birth.",
   "ko": "사실상 1964년에 나왔습니다. 제가 태어난 이듬해죠."
  },
  {
   "who": 0,
   "at": 49.5,
   "en": "Well, after all this time, we've [reinvented computers again].",
   "ko": "그 긴 세월 끝에, 컴퓨터를 다시 발명했습니다."
  },
  {
   "who": 0,
   "at": 53.0,
   "en": "This is what a processor looks like. It's on the right there.",
   "ko": "프로세서가 이렇게 생겼습니다. 저기 오른쪽에 있죠."
  },
  {
   "who": 0,
   "at": 56.18,
   "en": "People say it's a GPU. That's one GPU unit,",
   "ko": "사람들은 GPU라고 하죠. 저게 GPU 한 대인데,"
  },
  {
   "who": 0,
   "at": 59.5,
   "en": "and it's [70 pounds], 60,000 parts, 10,000 watts.",
   "ko": "70파운드(약 32kg)에 부품 6만 개, 1만 W죠.",
   "to": 66.6
  },
  {
   "who": 0,
   "at": 67.5,
   "en": "In order to manufacture it, it requires probably",
   "ko": "이걸 만들려면"
  },
  {
   "who": 0,
   "at": 70.2,
   "en": "a couple of hundred companies in the supply chain.",
   "ko": "공급망에 있는 기업 수백 곳이 필요할 겁니다."
  },
  {
   "who": 0,
   "at": 73.54,
   "en": "It is so heavy that it requires robotics to do.",
   "ko": "너무 무거워서 로봇이 있어야 만들 수 있고"
  },
  {
   "who": 0,
   "at": 77.4,
   "en": "It's so precise.",
   "ko": "그만큼 정밀합니다."
  },
  {
   "who": 0,
   "at": 78.86,
   "en": "And just to test a supercomputer [requires a supercomputer].",
   "ko": "슈퍼컴퓨터를 시험하는 데도 슈퍼컴퓨터가 필요합니다.",
   "to": 82.9
  }
 ],
