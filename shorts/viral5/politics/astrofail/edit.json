 "lines": [
  {
   "who": 0,
   "src": "speech/hague_crew9_2024.mp4",
   "at": 2.65,
   "to": 4.1,
   "en": "Space is really hard.",
   "ko": "우주는 정말 어려워요."
  },
  {
   "who": 0,
   "src": "speech/hague_crew9_2024.mp4",
   "at": 4.2,
   "to": 6.2,
   "en": "It's dynamic, it's unpredictable,",
   "ko": "변화무쌍하고, 예측할 수 없죠."
  },
  {
   "who": 0,
   "src": "speech/hague_crew9_2024.mp4",
   "at": 48.5,
   "to": 50.45,
   "en": "My first launch was not quite successful,",
   "ko": "제 첫 발사는 썩 성공적이지 못했어요."
  },
  {
   "who": 0,
   "src": "speech/hague_crew9_2024.mp4",
   "at": 50.5,
   "to": 53.1,
   "en": "and we aborted about two minutes into the flight.",
   "ko": "비행 2분쯤 만에 임무를 중단했거든요."
  },
  {
   "who": 0,
   "src": "speech/hague_crew9_2024.mp4",
   "at": 53.2,
   "to": 55.5,
   "en": "So what was supposed to be a 200‑day mission",
   "ko": "그래서 200일짜리였어야 할 임무가"
  },
  {
   "who": 0,
   "src": "speech/hague_crew9_2024.mp4",
   "at": 55.5,
   "to": 57.1,
   "en": "ended up being a 20‑minute mission.",
   "ko": "20분짜리 임무가 돼 버렸죠."
  },
  {
   "who": 0,
   "src": "speech/hague_crew9_2024.mp4",
   "at": 57.15,
   "to": 60.0,
   "en": "I was able to [try again] five months later",
   "ko": "5개월 뒤 다시 도전할 수 있었고"
  },
  {
   "who": 0,
   "src": "speech/hague_crew9_2024.mp4",
   "at": 60.05,
   "to": 62.05,
   "en": "and complete the job that I was asked to do,",
   "ko": "제게 맡겨진 일을 해냈어요."
  },
  {
   "who": 0,
   "src": "speech/hague_crew9_2024.mp4",
   "at": 62.07,
   "to": 65.0,
   "en": "which was go to the space station and spend six months on board.",
   "ko": "우주정거장에서 6개월 지내는 일이었죠."
  },
  {
   "who": 1,
   "src": "speech/menon_ascan_2021.mp4",
   "at": 3.35,
   "to": 6.05,
   "en": "I've been through the selection process a few times,",
   "ko": "저는 선발 과정을 몇 번 거쳤어요."
  },
  {
   "who": 1,
   "src": "speech/menon_ascan_2021.mp4",
   "at": 33.95,
   "to": 37.45,
   "en": "And it's a real testament that [trying and trying again]",
   "ko": "도전하고 또 도전하며"
  },
  {
   "who": 1,
   "src": "speech/menon_ascan_2021.mp4",
   "at": 37.46,
   "to": 40.05,
   "en": "and never giving up is the way to go,",
   "ko": "절대 포기 않는 게 정답이란 증거죠."
  },
  {
   "who": 1,
   "src": "speech/menon_ascan_2021.mp4",
   "at": 40.1,
   "to": 43.3,
   "en": "because I never thought that I would have this opportunity,",
   "ko": "이런 기회가 올 거라곤 생각도 못 했으니까요."
  },
  {
   "who": 1,
   "src": "speech/menon_ascan_2021.mp4",
   "at": 43.9,
   "to": 46.95,
   "en": "but I kept after it and I kept trying to improve myself,",
   "ko": "그래도 끝까지 매달렸고, 계속 저를 갈고닦았죠."
  },
  {
   "who": 1,
   "src": "speech/menon_ascan_2021.mp4",
   "at": 47.0,
   "to": 47.85,
   "en": "and here I am.",
   "ko": "그리고 지금, 여기 있어요."
  },
  {
   "who": 2,
   "src": "speech/burnham_ascan_2021.mp4",
   "at": 3.15,
   "to": 5.6,
   "en": "You have to be resilient, you can never give up.",
   "ko": "꺾이지 않아야 해요. 절대 포기하면 안 돼요."
  },
  {
   "who": 2,
   "src": "speech/burnham_ascan_2021.mp4",
   "at": 5.62,
   "to": 7.5,
   "en": "This was [not my first application],",
   "ko": "이번이 제 첫 지원이 아니었어요."
  },
  {
   "who": 2,
   "src": "speech/burnham_ascan_2021.mp4",
   "at": 7.9,
   "to": 9.9,
   "en": "so do not self-eliminate.",
   "ko": "그러니 지레 자신을 떨어뜨리지 마세요."
  },
  {
   "who": 2,
   "src": "speech/burnham_ascan_2021.mp4",
   "at": 9.98,
   "to": 12.25,
   "en": "You must always keep trying, keep bettering yourself.",
   "ko": "늘 계속 시도하고, 계속 더 나아지세요."
  }
 ],
