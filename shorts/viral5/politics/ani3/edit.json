 "lines": [
  {
   "who": 0,
   "t": 0,
   "tend": 2.25,
   "en": "",
   "ko": "햄스터 아님 주의"
  },
  {
   "who": 0,
   "t": 2.25,
   "tend": 4.5,
   "en": "",
   "ko": "토끼과 동물 '우는토끼(피카)'"
  },
  {
   "who": 0,
   "t": 4.5,
   "tend": 7.0,
   "en": "",
   "ko": "겨울잠을 안 잔다"
  },
  {
   "who": 0,
   "t": 7.0,
   "tend": 9.5,
   "en": "",
   "ko": "그럼 겨울엔 뭘 먹냐면…"
  },
  {
   "who": 0,
   "t": 9.5,
   "tend": 14.5,
   "en": "",
   "ko": "눈 오기 전에 풀·잎을 모아서"
  },
  {
   "who": 0,
   "t": 14.5,
   "tend": 18.5,
   "en": "",
   "ko": "'건초더미'를 쌓는다"
  },
  {
   "who": 0,
   "t": 18.5,
   "tend": 21.25,
   "en": "",
   "ko": "바위 밑·구멍 속에 저장"
  },
  {
   "who": 0,
   "t": 21.25,
   "tend": 24.0,
   "en": "",
   "ko": "모으다가 한 입씩 간식ㅋㅋ"
  },
  {
   "who": 0,
   "t": 24.0,
   "tend": 26.75,
   "en": "",
   "ko": "눈이 쌓이면 눈 밑에 굴을 파서"
  },
  {
   "who": 0,
   "t": 26.75,
   "tend": 29.5,
   "en": "",
   "ko": "겨울 내내 건초더미를 꺼내 먹음"
  },
  {
   "who": 0,
   "t": 29.5,
   "tend": 34.0,
   "en": "",
   "ko": "\"삑!\" 울음소리로 서로를 알아본다는 연구도"
  },
  {
   "who": 0,
   "t": 34.0,
   "tend": 36.45,
   "en": "",
   "ko": "그래서 이름이 '우는토끼'ㅋㅋ"
  }
 ],
