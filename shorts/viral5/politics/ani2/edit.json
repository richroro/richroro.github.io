 "lines": [
  {
   "who": 0,
   "t": 0.0,
   "tend": 2.0,
   "en": "",
   "ko": "갑자기 뽀뽀?!"
  },
  {
   "who": 0,
   "t": 2.0,
   "tend": 4.6,
   "en": "",
   "ko": "사실 이건 \"너 우리 가족 맞지?\""
  },
  {
   "who": 0,
   "t": 4.6,
   "tend": 7.2,
   "en": "",
   "ko": "입을 맞추거나 냄새로 가족을 알아본다"
  },
  {
   "who": 0,
   "t": 7.2,
   "tend": 10.2,
   "en": "",
   "ko": "평소엔 이렇게 망을 보다가"
  },
  {
   "who": 0,
   "t": 10.2,
   "tend": 13.6,
   "en": "",
   "ko": "천적마다 다른 경고음을 낸다"
  },
  {
   "who": 0,
   "t": 13.6,
   "tend": 18.1,
   "en": "",
   "ko": "천적 생김새까지 설명하는 '문장'도 만듦"
  },
  {
   "who": 0,
   "t": 18.1,
   "tend": 21.6,
   "en": "",
   "ko": "그리고 이 통통이들은…"
  },
  {
   "who": 0,
   "t": 21.6,
   "tend": 26.1,
   "en": "",
   "ko": "10월부터 3월 말까지 겨울잠ㅋㅋ"
  },
  {
   "who": 0,
   "t": 26.1,
   "tend": 30.6,
   "en": "",
   "ko": "전 세계에서 유타주 남서부에만 산다"
  },
  {
   "who": 0,
   "t": 30.6,
   "tend": 33.0,
   "en": "",
   "ko": "그러니까 길 위의 뽀뽀는"
  },
  {
   "who": 0,
   "t": 33.0,
   "tend": 34.95,
   "en": "",
   "ko": "그냥 가족 확인 중ㅋㅋ"
  }
 ],
