  "lines": [
    {
      "id": "hook",
      "voice": "nar",
      "gap": 0.05,
      "say": "숫자 하나 때문에,| 진짜 터진 사고.| 삼 위부터 갑니다.",
      "cap": [
        "숫자 하나 때문에",
        "진짜 [터진 사고] 💥",
        "[3위]부터 갑니다"
      ]
    },
    {
      "id": "r3a",
      "voice": "nar",
      "gap": 0.25,
      "say": "삼 위는,| 터질 뻔한 강남스타일.",
      "cap": [
        "[3위]는",
        "터질 뻔한 / [강남스타일] 😅"
      ]
    },
    {
      "id": "r3b",
      "voice": "nar",
      "gap": 0.12,
      "say": "조회수가 유튜브 숫자 칸을 꽉 채워서,| 마이너스로 뒤집힐 뻔했죠.",
      "cap": [
        "조회수가 유튜브 / [숫자 칸]을 꽉 채워서",
        "[마이너스]로 / 뒤집힐 뻔 😱"
      ]
    },
    {
      "id": "r2a",
      "voice": "nar",
      "gap": 0.55,
      "say": "이 위는,| 발사 사십 초도 안 돼서 터진 로켓.",
      "cap": [
        "[2위]는",
        "발사 [40초]도 안 돼서 / 터진 로켓 🚀"
      ]
    },
    {
      "id": "r2b",
      "voice": "nar",
      "gap": 0.15,
      "say": "큰 숫자를 작은 칸에 넣다가,| 넘쳐 버렸거든요.",
      "cap": [
        "큰 숫자를 / [작은 칸]에",
        "넣다가 넘쳐 버림 💥"
      ]
    },
    {
      "id": "r1a",
      "voice": "nar",
      "gap": 0.55,
      "say": "대망의 일 위.| 단위 하나 때문에 사라진,| 화성 탐사선.",
      "cap": [
        "대망의 [1위] 🥇",
        "[단위 하나] 때문에 / 사라진",
        "화성 탐사선 🪐"
      ]
    },
    {
      "id": "r1b",
      "voice": "nar",
      "gap": 0.15,
      "say": "한 팀은 파운드,| 한 팀은 미터법으로 계산했거든요.",
      "cap": [
        "한 팀은 [파운드]",
        "한 팀은 [미터법] 🤦"
      ]
    },
    {
      "id": "r1c",
      "voice": "nar",
      "gap": 0.15,
      "say": "일억 이천오백만 달러가,| 그대로 증발.",
      "cap": [
        "[1억 2500만 달러]가",
        "그대로 증발 🫠"
      ]
    },
    {
      "id": "loop",
      "voice": "nar",
      "gap": 0.35,
      "say": "그러니까 숫자 옆에 단위,| 꼭 적으세요.",
      "cap": [
        "그러니까 숫자 옆에",
        "[단위] 꼭 적으세요 ✍️"
      ]
    }
  ],
  "tail": 1.3
